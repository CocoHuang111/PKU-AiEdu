{$SITE_ADDRESS} {
    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy backend:8010
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }
}
