# Incremental application release atop the existing verified dependency image.
# 在仓库根目录构建：docker build -f deploy/Dockerfile.business-layer .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --chown=app:app config.yaml /app/config.yaml
COPY --chown=app:app backend /app/backend
COPY --chown=app:app ai_engine /app/ai_engine
COPY --chown=app:app scripts /app/scripts
