{"course": {"schema_version": "1.0", "course_id": "mitocw-18-100c-fall-2012", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["18.100C"], "cross_listed_codes": [], "course_title": "Real Analysis", "course_slug": "18-100c-real-analysis-fall-2012", "term": "Fall", "year": 2012, "as_taught_in": "Fall 2012", "language": "en", "departments": ["Mathematics"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Paul Seidel"], "subject_primary": "Calculus", "subject_secondary": ["Mathematical Analysis"], "topic_tree": [{"name": "Mathematics", "subtopics": [{"name": "Calculus", "specialties": []}, {"name": "Mathematical Analysis", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": [], "description": "This course covers the fundamentals of mathematical analysis: convergence of sequences and series, continuity, differentiability, Riemann integral, sequences and series of functions, uniformity, and the interchange of limit operations. It shows the utility of abstract concepts and teaches an understanding and construction of proofs. MIT students may choose to take one of three versions of Real Analysis; this version offers three additional units of credit for instruction and practice in written and oral presentation. The three options for 18.100: Option A (18.100A) chooses less abstract definitions and proofs, and gives applications where possible. Option B (18.100B) is more demanding and for students with more mathematical maturity; it places more emphasis from the beginning on point-set topology and n-space, whereas Option A is concerned primarily with analysis on the real line, saving for the last weeks work in 2-space (the plane) and its point-set topology. Option C (18.100C) is a 15-unit variant of Option B, with further instruction and practice in written and oral communication. This fulfills the MIT CI requirement.", "course_url": "https://ocw.mit.edu/courses/18-100c-real-analysis-fall-2012/", "image_url": "https://ocw.mit.edu/courses/18-100c-real-analysis-fall-2012/3b934aa7b6d8e92c843375ee21b68644_18-100cf12.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": true, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-18-100c-fall-2012-course-home", "course_id": "mitocw-18-100c-fall-2012", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/18-100c-real-analysis-fall-2012/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "4620498e74722a638aa498e2aa2d39c47f34ebae38c1d43d7b3ca6d953d45808", "error": null}, {"resource_id": "mitocw-18-100c-fall-2012-syllabus", "course_id": "mitocw-18-100c-fall-2012", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/18-100c-real-analysis-fall-2012/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "3171d83137c17319de0fe9bf14295e38848017fbee45cecb3f7e0f1a32a7039f", "error": null}, {"resource_id": "mitocw-18-100c-fall-2012-calendar", "course_id": "mitocw-18-100c-fall-2012", "resource_type": "calendar", "source_title": "Calendar", "source_url": "https://ocw.mit.edu/courses/18-100c-real-analy