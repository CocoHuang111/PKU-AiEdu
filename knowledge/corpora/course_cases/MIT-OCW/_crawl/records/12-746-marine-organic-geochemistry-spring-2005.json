{"course": {"schema_version": "1.0", "course_id": "mitocw-12-746-spring-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["12.746"], "cross_listed_codes": [], "course_title": "Marine Organic Geochemistry", "course_slug": "12-746-marine-organic-geochemistry-spring-2005", "term": "Spring", "year": 2005, "as_taught_in": "Spring 2005", "language": "en", "departments": ["Earth, Atmospheric, and Planetary Sciences"], "academic_levels": ["Graduate"], "instructors": ["Prof. Daniel Repeta", "Prof. Timothy Eglinton"], "subject_primary": "Chemistry", "subject_secondary": ["Organic Chemistry", "Earth Science", "Geobiology", "Geochemistry", "Oceanography"], "topic_tree": [{"name": "Science", "subtopics": [{"name": "Chemistry", "specialties": ["Organic Chemistry"]}, {"name": "Earth Science", "specialties": ["Geobiology", "Geochemistry", "Oceanography"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Projects"], "description": "This class is designed to provide the student with a global to molecular-level perspective of organic matter cycling in the oceans and marine sediments. Topics include: Organic matter (C,N,P) composition, reactivity and budgets within, and fluxes through, major ocean reservoirs; microbial recycling pathways for organic matter; models of organic matter degradation and preservation; role of anoxia in organic matter burial; relationships between dissolved and particulate (sinking and suspended) organic matter; methods for characterization of sedimentary organic matter; and application of biological markers as tools in oceanography. Both structural and isotopic aspects are covered.", "course_url": "https://ocw.mit.edu/courses/12-746-marine-organic-geochemistry-spring-2005/", "image_url": "https://ocw.mit.edu/courses/12-746-marine-organic-geochemistry-spring-2005/fb29ee8b88405a146c2af9340f24551a_12-746s05.jpg", "license_name": "CC BY-