{"course": {"schema_version": "1.0", "course_id": "mitocw-11-945-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.945"], "cross_listed_codes": [], "course_title": "Springfield Studio", "course_slug": "11-945-springfield-studio-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Ceasar McDowell", "Prof. Susan Silberberg"], "subject_primary": "Architecture", "subject_secondary": ["Environmental Design", "Social Science", "Sociology", "Community Development", "Urban Studies", "Regional Planning", "Urban Planning"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Architecture", "specialties": ["Environmental Design"]}]}, {"name": "Social Science", "subtopics": [{"name": "Sociology", "specialties": ["Community Development"]}, {"name": "Urban Studies", "specialties": ["Regional Planning", "Urban Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments", "Image Gallery", "Projects with Examples"], "description": "The Springfield Studio is a practicum design course that focuses on the physical, programmatic, and social renewal of an urban community in Springfield, Massachusetts by combining classroom work with an applied class project. The course content covers the areas of physical design/urban design and the related analysis and planning tools used to understand and assess urban conditions from a design and development perspective. Urban design issues are investigated in the context of social and economic challenges within the community. Thus, the course has dual goals: analyze physical conditions in the community, assess community need, propose physical design interventions; and assess community capacity and programmatic needs. The ultimate goal is to explore the integration of social, programmatic and physical development interventions in ways that reinforce community revitalization efforts, and to apply this knowledge through the development of a formal neighborhood revitalization plan that addresses community needs.", "course_url": "https://ocw.mit.edu/courses/11-945-springfield-studio-spring-2004/", "image_url": "https://ocw.mit.edu/courses/11-945-springfield-studio-spring-2004/fb656ca0b0d2118c4b972b11e3d7ac0b_11-945s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-945-spring-2004-course-home", "course_id": "mitocw-11-945-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-945-springfield-studio-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "6dcef1d1d8e42beb51464ade2f70126e6e82b87972f4d40f10aebe45371e714e", "error": null}, {"resource_id": "mitocw-11-945-spring-2004-syllabus", "course_id": "mitocw-11-945-spring-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/11-945-springfield-studio-spring-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md",