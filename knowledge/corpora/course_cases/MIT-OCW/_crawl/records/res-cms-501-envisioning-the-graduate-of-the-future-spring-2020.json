{"course": {"schema_version": "1.0", "course_id": "mitocw-res-cms-501-spring-2020", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.CMS-501"], "cross_listed_codes": [], "course_title": "Envisioning the Graduate of the Future", "course_slug": "res-cms-501-envisioning-the-graduate-of-the-future-spring-2020", "term": "Spring", "year": 2020, "as_taught_in": "Spring 2020", "language": "en", "departments": ["Comparative Media Studies/Writing"], "academic_levels": ["Non-Credit"], "instructors": ["Prof. Justin Reich", "Elizabeth Huttner-Loan", "Alyssa Napier"], "subject_primary": "Curriculum and Teaching", "subject_secondary": [], "topic_tree": [{"name": "Teaching and Education", "subtopics": [{"name": "Curriculum and Teaching", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Instructor Insights"], "description": "Communities have always wrestled with the multiple purposes of education: to train young people for careers, vocations, and college; to prepare them for their roles as citizens; to develop habits of reflective, ethical adults; and to create a common experience in a pluralistic society while meeting the needs of individual learners. As the world changes and grows more complex, returning to these important questions of purpose can help guide schools in their growth and strategic change. To ensure our schools are effective, we need to routinely reimagine what the high school graduate of the future will need to know and be able to do. The artifact that communicates these ideas is called a graduate profile. Making explicit the capabilities, competencies, knowledge, and attitudes for secondary school graduates, and inviting key stakeholders like students and community members to be engaged in the process, can help you and your school to focus your vision of success and drive school innovation efforts. This course is part of the Open Learning Library , which is free to use. You have the option to sign up and enroll in the course if you want to track your progress, or you can view and use all the materials without enrolling.", "course_url": "https://ocw.mit.edu/courses/res-cms-501-envisioning-the-graduate-of-the-future-spring-2020/", "image_url": "https://ocw.mit.edu/courses/res-cms-501-envisioning-the-graduate-of-the-future-spring-2020/167096fd281d8ec140da8e21aa772946_res-cms-501s20.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": true, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-res-cms-501-spring-2020-course-home", "course_id": "mitocw-res-cms-501-spring-2020", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/res-cms-501-envisioning-the-graduate-of-the-future-spring-2020/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "ee92348b4e4437cdb797fc6cc8b5e514829eff99cfe7687eb638fbd423b455c6", "error": null}, {"resource_id": "mitocw-res-cms-501-spring-2020-instructor-insights", "course_id": "mitocw-res-cms-501-spring-2020", "resource_type": "instructor_insights", "source_title": "Instructor Insights", "source_url": "https://ocw.mit.edu/courses/res-cms-501-envisioning-the-graduate-of-the-future-spring-2020/pages/instructor-insights/", "source_format": "html", "availability": "available", "extraction_policy": "