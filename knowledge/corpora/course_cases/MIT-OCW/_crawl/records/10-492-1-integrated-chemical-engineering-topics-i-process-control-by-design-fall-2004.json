{"course": {"schema_version": "1.0", "course_id": "mitocw-10-492-1-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["10.492-1"], "cross_listed_codes": [], "course_title": "Integrated Chemical Engineering Topics I: Process Control by Design", "course_slug": "10-492-1-integrated-chemical-engineering-topics-i-process-control-by-design-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Chemical Engineering"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Barry S. Johnston"], "subject_primary": "Chemical Engineering", "subject_secondary": ["Process Control Systems", "Environmental Engineering", "Environmental Management", "Science", "Chemistry", "Analytical Chemistry"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Chemical Engineering", "specialties": ["Process Control Systems"]}, {"name": "Environmental Engineering", "specialties": ["Environmental Management"]}]}, {"name": "Science", "subtopics": [{"name": "Chemistry", "specialties": ["Analytical Chemistry"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets"], "description": "In the ICE-Topics courses, various chemical engineering problems are presented and analyzed in an industrial context. Emphasis is on the integration of fundamentals with material property estimation, process control, product development, and computer simulation. Integration of societal issues, such as engineering ethics, environmental and safety considerations, and impact of technology on society are addressed in the context of case studies. The broad context for this ICE-Topics module is the commonsense notion that, when designing something, one should plan for the off-normal conditions that may occur. A continuous process is conceived and designed as a steady-state operation. However, the process must start up, shut down, and operate in the event of disturbances, and so the time-varying behavior of the process should not be neglected. It is helpful to consider the operability of a process early in the design, when alternatives are still being compared. In this module, we will examine some tools that will help to evaluate the operability of the candidate process at the preliminary design stage, before substantial effort has been invested.", "course_url": "https://ocw.mit.edu/courses/10-492-1-integrated-chemical-engineering-topics-i-process-control-by-design-fall-2004/", "image_url": "https://ocw.mit.edu/courses/10-492-1-integrated-chemical-engineering-topics-i-process-control-by-design-fall-2004/5c554eb9211fa1360feb77cf87bb5dec_10-492-1f04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-10-492-1-fall-2004-course-home", "course_id": "mitocw-10-492-1-fall-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/10-492-1-integrated-chemical-engineering-topics-i-process-control-by-design-fall-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "60cbd2759b853de079a04b4b6cd3d3cbfbb46041f28387398c22b56849cb49a6", "error": null}, {"resource_id": "mitocw-10-492-1-fall-2004-syllabus", "course_id": "mitocw-10-49