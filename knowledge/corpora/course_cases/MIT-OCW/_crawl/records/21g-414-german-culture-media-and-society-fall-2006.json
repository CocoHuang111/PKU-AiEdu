{"course": {"schema_version": "1.0", "course_id": "mitocw-21g-414-fall-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21G.414"], "cross_listed_codes": [], "course_title": "German Culture, Media, and Society", "course_slug": "21g-414-german-culture-media-and-society-fall-2006", "term": "Fall", "year": 2006, "as_taught_in": "Fall 2006", "language": "en", "departments": ["Global Studies and Languages"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Kurt Fendt"], "subject_primary": "Media Studies", "subject_secondary": ["Visual Arts", "Film and Video", "Humanities", "Language", "German", "Social Science", "Anthropology", "Cultural Anthropology", "Society", "European and Russian Studies"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Media Studies", "specialties": []}, {"name": "Visual Arts", "specialties": ["Film and Video"]}]}, {"name": "Humanities", "subtopics": [{"name": "Language", "specialties": ["German"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}]}, {"name": "Society", "subtopics": [{"name": "European and Russian Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Projects"], "description": "The topic for Fall 2006 is short film and radio plays. This course investigates current trends and topics in German literary, theater, film, television, radio, and other media arts productions. Students analyze media texts in the context of their production, reception, and distribution as well as the public debates initiated by these works. The topic for Fall 2006 is German Short Film, a popular format that represents most recent trends in film production, and German Radio Art, a striving genre that includes experimental radio plays, sound art, and audio installations. Special attention will be given to the representation of German minorities, contrasted by their own artistic expressions reflecting changes in identity and a new political voice. Students have the opportunity to discuss course topics with a writer, filmmaker, and/or media artist from Germany. The course is taught in German.", "course_url": "https://ocw.mit.edu/courses/21g-414-german-culture-media-and-society-fall-2006/", "image_url": "https://ocw.mit.edu/courses/21g-414-german-culture-media-and-society-fall-2006/abcf9711d7af3b2f74b694c42eb149d4_21g-414f06.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21g-414-fall-2006-course-home", "course_id": "mitocw-21g-414-fall-2006", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21g-414-german-culture-media-and-society-fall-2006/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "140ddd4506b3cdb29609dfdf08dd3c36ea35acf6e335551bd86d66197c9f74eb", "error": null}, {"resource_id": "mitocw-21g-414-fall-2006-syllabus", "course_id": "mitocw-21g-414-fall-2006", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/21g-414-german-culture-media-and-society-fall-2006/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_st