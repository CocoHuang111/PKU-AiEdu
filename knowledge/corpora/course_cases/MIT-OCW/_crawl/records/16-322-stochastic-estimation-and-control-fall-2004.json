{"course": {"schema_version": "1.0", "course_id": "mitocw-16-322-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["16.322"], "cross_listed_codes": [], "course_title": "Stochastic Estimation and Control", "course_slug": "16-322-stochastic-estimation-and-control-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Aeronautics and Astronautics"], "academic_levels": ["Graduate"], "instructors": ["Prof. Wallace Vander Velde"], "subject_primary": "Aerospace Engineering", "subject_secondary": ["Guidance and Control Systems", "Mathematics", "Probability and Statistics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Aerospace Engineering", "specialties": ["Guidance and Control Systems"]}]}, {"name": "Mathematics", "subtopics": [{"name": "Probability and Statistics", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets"], "description": "The major themes of this course are estimation and control of dynamic systems. Preliminary topics begin with reviews of probability and random variables. Next, classical and state-space descriptions of random processes and their propagation through linear systems are introduced, followed by frequency domain design of filters and compensators. From there, the Kalman filter is employed to estimate the states of dynamic systems. Concluding topics include conditions for stability of the filter equations.", "course_url": "https://ocw.mit.edu/courses/16-322-stochastic-estimation-and-control-fall-2004/", "image_url": "https://ocw.mit.edu/courses/16-322-stochastic-estimation-and-control-fall-2004/5d09512f3c708dd94fa17f334ec713ec_16-322f04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture