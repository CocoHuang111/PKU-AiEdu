{"course": {"schema_version": "1.0", "course_id": "mitocw-res-env-006-january-iap-2022", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.ENV-006"], "cross_listed_codes": [], "course_title": "Teaching with Sustainability", "course_slug": "res-env-006-teaching-with-sustainability-january-iap-2022", "term": "January IAP", "year": 2022, "as_taught_in": "January IAP 2022", "language": "en", "departments": [], "academic_levels": ["Non-Credit"], "instructors": ["Dr. Elizabeth Potter-Nelson", "Sarah Meyers"], "subject_primary": "Earth Science", "subject_secondary": ["Sustainability", "Teaching and Education", "Curriculum and Teaching"], "topic_tree": [{"name": "Science", "subtopics": [{"name": "Earth Science", "specialties": ["Sustainability"]}]}, {"name": "Teaching and Education", "subtopics": [{"name": "Curriculum and Teaching", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Editable Files", "Instructor Insights", "Lecture Notes", "Podcasts"], "description": "Solving the interconnected complex problems that pervade our social, environmental, economic, and health systems requires concerted change. To achieve the lasting impact necessary for true change to occur, sustainability needs to be holistically integrated throughout an academic program, leveraging the knowledge of instructors to create a more sustainability-literate population. This resource presents materials associated with a four-week noncredit course intended to provide current and future educators with the knowledge and skills to infuse their lessons and practices with sustainability, along with a link to an online resource library designed to help educators find activities and lessons that align with the United Nations Sustainable Development Goals.", "course_url": "https://ocw.mit.edu/courses/res-env-006-teaching-with-sustainability-january-iap-2022/", "image_url": "https://ocw.m