{"course": {"schema_version": "1.0", "course_id": "mitocw-res-ec-002-spring-2021", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.EC-002"], "cross_listed_codes": [], "course_title": "Lean Research Skills for Conducting Interviews", "course_slug": "res-ec-002-lean-research-skills-for-conducting-interviews-spring-2021", "term": "Spring", "year": 2021, "as_taught_in": "Spring 2021", "language": "en", "departments": ["Edgerton Center"], "academic_levels": ["Undergraduate"], "instructors": ["Elizabeth Hoffecker", "Zoe Dibb"], "subject_primary": "Social Science", "subject_secondary": [], "topic_tree": [{"name": "Social Science", "subtopics": []}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": [], "description": "This course introduces effective techniques for conducting interviews and is designed to help you develop and strengthen your skills as an interviewer. It does not assume any existing experience conducting interviews, but will quickly take you past the basics and into best practices that incorporate the Lean Research principles of rigor, relevance, respect, and right-size. The course focuses specifically on conducting interviews in “the field”— contexts in which we may be in an unfamiliar setting or culture, such as when traveling abroad or conducting research in a place we haven’t been before. This course is part of the Open Learning Library , which is free to use. You have the option to sign up and enroll in the course if you want to track your progress, or you can view and use all the materials without enrolling.", "course_url": "https://ocw.mit.edu/courses/res-ec-002-lean-research-skills-for-conducting-interviews-spring-2021/", "image_url": "https://ocw.mit.edu/courses/res-ec-002-lean-research-skills-for-conducting-interviews-spring-2021/29274c1cafce008a0d7e5e40a1d16df8_RES-EC002.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativec