{"course": {"schema_version": "1.0", "course_id": "mitocw-22-14-spring-2015", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["22.14"], "cross_listed_codes": [], "course_title": "Materials in Nuclear Engineering", "course_slug": "22-14-materials-in-nuclear-engineering-spring-2015", "term": "Spring", "year": 2015, "as_taught_in": "Spring 2015", "language": "en", "departments": ["Nuclear Science and Engineering"], "academic_levels": ["Graduate"], "instructors": ["Prof. Michael Short"], "subject_primary": "Materials Science and Engineering", "subject_secondary": ["Nuclear Engineering", "Nuclear Materials"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Materials Science and Engineering", "specialties": []}, {"name": "Nuclear Engineering", "specialties": ["Nuclear Materials"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Lecture Notes", "Problem Set Solutions", "Problem Sets", "Written Assignments with Examples"], "description": "In this course, we will lay the foundation for understanding how materials behave in nuclear systems. In particular, we will build on a solid base of nuclear material fundamentals in order to understand radiation damage and effects in fuels and structural materials. This course consists of a series of directed readings, lectures on video, problem sets, short research projects, and class discussions with worked examples. We will start with an overview of nuclear materials, where they are found in nuclear systems, and how they fail. We will then develop the formalism in crystallography as a common language for materials scientists everywhere. This will be followed by the development of phase diagrams from thermodynamics, which predict how binary alloy systems evolve towards equilibrium. Then effects of stress, defects, and kinetics will be introduced. These will all be tied together when developing theories about how radiation, particularly neutrons and heavy charged particles, interact with solid matter to produce defects and evolve microstructure. A few applications of radiation effects will then be treated with this newfound framework, including the change of material properties under irradiation, void swelling, embrittlement, loss of ductility, and the simulation of in-reactor irradiation (neutrons) with heavy ions.", "course_url": "https://ocw.mit.edu/courses/22-14-materials-in-nuclear-engineering-spring-2015/", "image_url": "https://ocw.mit.edu/courses/22-14-materials-in-nuclear-engineering-spring-2015/9c0260c48c6fb9800e99c09ca0110a4a_22-14s15.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-22-14-spring-2015-course-home", "course_id": "mitocw-22-14-spring-2015", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/22-14-materials-in-nuclear-engineering-spring-2015/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "da31a85cc3adccbeaa2561cf7ffefef8b93f38facff261e1f0950afa66c941aa", "error": null}, {"resource_id": "mitocw-22-14-spring-2015-syllabus", "course_id": "mitocw-22-14-spring-2015", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/22-14-mat