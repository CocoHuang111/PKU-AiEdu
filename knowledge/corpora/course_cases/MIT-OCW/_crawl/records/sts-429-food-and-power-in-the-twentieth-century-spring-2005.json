{"course": {"schema_version": "1.0", "course_id": "mitocw-sts-429-spring-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["STS.429"], "cross_listed_codes": [], "course_title": "Food and Power in the Twentieth Century", "course_slug": "sts-429-food-and-power-in-the-twentieth-century-spring-2005", "term": "Spring", "year": 2005, "as_taught_in": "Spring 2005", "language": "en", "departments": ["Science, Technology, and Society"], "academic_levels": ["Graduate"], "instructors": ["Prof. Deborah Fitzgerald"], "subject_primary": "History", "subject_secondary": ["Modern History", "Social Science", "Economics", "Political Economy"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["Modern History"]}]}, {"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["Political Economy"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments", "Written Assignments"], "description": "In this class, food serves as both the subject and the object of historical analysis. As a subject, food has been transformed over the last 100 years, largely as a result of ever more elaborate scientific and technological innovations. From a need to preserve surplus foods for leaner times grew an elaborate array of techniques – drying, freezing, canning, salting, etc – that changed not only what people ate, but how far they could/had to travel, the space in which they lived, their relations with neighbors and relatives, and most of all, their place in the economic order of things. The role of capitalism in supporting and extending food preservation and development was fundamental. As an object, food offers us a way into cultural, political, economic, and techno-scientific history. Long ignored by historians of science and technology, food offers a rich source for exploring, e.g., the creation and maintenance of mass-production techniques, industrial farming initiatives, the politics of consumption, vertical integration of business firms, globalization, changing race and gender identities, labor movements, and so forth. How is food different in these contexts, from other sorts of industrial goods? What does the trip from farm to table tell us about American culture and history?", "course_url": "https://ocw.mit.edu/courses/sts-429-food-and-power-in-the-twentieth-century-spring-2005/", "image_url": "https://ocw.mit.edu/courses/sts-429-food-and-power-in-the-twentieth-century-spring-2005/07af7c30518ea6fb9e698cd1c27b8cf7_sts-429s05.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-sts-429-spring-2005-course-home", "course_id": "mitocw-sts-429-spring-2005", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/sts-429-food-and-power-in-the-twentieth-century-spring-2005/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "54054ce5a8a8dfe34379704c8efc52fb4e75b646c85d22ffed2a0f768477e6c3", "error": null}, {"resource_id": "mitocw-sts-429-spring-2005-syllabus", "course_id": "mitocw-sts-429-spring-2005", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/sts-429-food-and-power-