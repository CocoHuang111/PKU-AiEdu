{"course": {"schema_version": "1.0", "course_id": "mitocw-2-068-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["2.068"], "cross_listed_codes": [], "course_title": "Computational Ocean Acoustics (13.853)", "course_slug": "2-068-computational-ocean-acoustics-13-853-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Mechanical Engineering"], "academic_levels": ["Graduate"], "instructors": ["Prof. Henrik Schmidt"], "subject_primary": "Mechanical Engineering", "subject_secondary": ["Fluid Mechanics", "Ocean Engineering", "Hydrodynamics", "Systems Engineering", "Computational Modeling and Simulation", "Science", "Earth Science", "Geophysics", "Physics", "Quantum Mechanics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Mechanical Engineering", "specialties": ["Fluid Mechanics"]}, {"name": "Ocean Engineering", "specialties": ["Hydrodynamics"]}, {"name": "Systems Engineering", "specialties": ["Computational Modeling and Simulation"]}]}, {"name": "Science", "subtopics": [{"name": "Earth Science", "specialties": ["Geophysics"]}, {"name": "Physics", "specialties": ["Quantum Mechanics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes"], "description": "This course examines wave equations for fluid and visco-elastic media, wave-theory formulations of acoustic source radiation and seismo-acoustic propagation in stratified ocean waveguides, and Wavenumber Integration and Normal Mode methods for propagation in plane-stratified media. Also covered are Seismo-Acoustic modeling of seabeds and ice covers, seismic interface and surface waves in a stratified seabed, Parabolic Equation and Coupled Mode approaches to propagation in range-dependent ocean waveguides, numerical modeling of target scattering and reverberation clutter in ocean waveguides, and ocean ambient noise modeling. Students develop propagation models using all the numerical approaches relevant to state-of-the-art acoustic research. This course was originally offered in Course 13 (Department of Ocean Engineering) as 13.853. In 2005, ocean engineering subjects became part of Course 2 (Department of Mechanical Engineering), and this course was renumbered 2.068.", "course_url": "https://ocw.mit.edu/courses/2-068-computational-ocean-acoustics-13-853-spring-2003/", "image_url": "https://ocw.mit.edu/courses/2-068-computational-ocean-acoustics-13-853-spring-2003/a8d89dd1fa663ecfbfe7b6bd8f4dd607_2-068s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-2-068-spring-2003-course-home", "course_id": "mitocw-2-068-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/2-068-computational-ocean-acoustics-13-853-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "045a7e3953bb6f8e8d97f00e466432b07b88ce3755dc322053380b0ae32a26eb", "error": null}, {"resource_id": "mitocw-2-068-spring-2003-syllabus", "course_id": "mitocw-2-068-spring-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/2-068-computational-ocean-acoustics-13-853-spring-2003/p