{"course": {"schema_version": "1.0", "course_id": "mitocw-15-099-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.099"], "cross_listed_codes": [], "course_title": "Readings in Optimization", "course_slug": "15-099-readings-in-optimization-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Sloan School of Management"], "academic_levels": ["Graduate"], "instructors": ["Prof. Robert Freund"], "subject_primary": "Systems Engineering", "subject_secondary": ["Systems Optimization", "Mathematics", "Applied Mathematics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Systems Engineering", "specialties": ["Systems Optimization"]}]}, {"name": "Mathematics", "subtopics": [{"name": "Applied Mathematics", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Presentation Assignments with Examples"], "description": "In keeping with the tradition of the last twenty-some years, the Readings in Optimization seminar will focus on an advanced topic of interest to a portion of the MIT optimization community: randomized methods for deterministic optimization. In contrast to conventional optimization algorithms whose iterates are computed and analyzed deterministically, randomized methods rely on stochastic processes and random number/vector generation as part of the algorithm and/or its analysis. In the seminar, we will study some very recent papers on this topic, many by MIT faculty, as well as some older papers from the existing literature that are only now receiving attention.", "course_url": "https://ocw.mit.edu/courses/15-099-readings-in-optimization-fall-2003/", "image_url": "https://ocw.mit.edu/courses/15-099-readings-in-optimization-fall-2003/87aeb842f1bebd83bb469b5a238b0574_15-099f03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativeco