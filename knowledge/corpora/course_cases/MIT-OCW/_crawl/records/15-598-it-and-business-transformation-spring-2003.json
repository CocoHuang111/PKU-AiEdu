{"course": {"schema_version": "1.0", "course_id": "mitocw-15-598-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.598"], "cross_listed_codes": [], "course_title": "IT and Business Transformation", "course_slug": "15-598-it-and-business-transformation-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Sloan School of Management"], "academic_levels": ["Graduate"], "instructors": ["Prof. Cyrus Gibson"], "subject_primary": "Information Technology", "subject_secondary": ["Innovation", "Management", "Organizational Behavior"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Information Technology", "specialties": []}, {"name": "Innovation", "specialties": []}, {"name": "Management", "specialties": []}, {"name": "Organizational Behavior", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "The purpose of this Proseminar in Information Technology and Business Transformation (ITBT) is to provide students with a view of IT-enabled transformation and the strategic issues in the management of IT. The seminar will bring in CIOs, CEOs, and experienced consultants and industry observers to provide their perspectives and tell their stories about the use and management of IT today. Their talks will deal with the new technology, the new applications, the issues of implementation, the changes in industries and companies, and the strategic management of IT. In addition, there will be several case discussions of issues to be decided by senior management, with students taking on the position of executives and consultants. There will also be frameworks presented and used to position all material and speakers. Finally, one session will consist of ITBT alumni discussing career opportunities and issues for students, particularly from MIT, with these interests. Students will gain a perspective of the strategic role of and issues in managing IT as manifested in e-business applications, as a driver and enabler of business transformation, and as an underlying infrastructure resource for all businesses.", "course_url": "https://ocw.mit.edu/courses/15-598-it-and-business-transformation-spring-2003/", "image_url": "https://ocw.mit.edu/courses/15-598-it-and-business-transformation-spring-2003/a624fc5bbb3b66f2847a30b397b95aed_15-598s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-15-598-spring-2003-course-home", "course_id": "mitocw-15-598-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/15-598-it-and-business-transformation-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "8c535b7a3e8cade70d2ff989d4424be9ff17b33f557ef7013265aa064054f394", "error": null}, {"resource_id": "mitocw-15-598-spring-2003-syllabus", "course_id": "mitocw-15-598-spring-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/15-598-it-and-business-transformation-spring-2003/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extract