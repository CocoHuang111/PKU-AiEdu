{"course": {"schema_version": "1.0", "course_id": "mitocw-11-946-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.946"], "cross_listed_codes": [], "course_title": "Planning in Transition Economies for Growth and Equity", "course_slug": "11-946-planning-in-transition-economies-for-growth-and-equity-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Annette M. Kim"], "subject_primary": "Philosophy", "subject_secondary": ["Political Philosophy", "Social Science", "Economics", "Developmental Economics", "International Economics", "Political Economy", "Urban Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Philosophy", "specialties": ["Political Philosophy"]}]}, {"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["Developmental Economics", "International Economics", "Political Economy"]}, {"name": "Urban Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes"], "description": "During the last fifteen years, nations across the globe embarked on a historic transformation away from centrally planned economies to market-oriented ones. However, in the common pursuit for economic growth, these transition countries implemented widely different reform strategies with mixed results. With over a decade of empirical evidence now available, this new course examines this phenomenon that has pushed the discourse in a number of disciplines, requiring us to reconsider fundamental issues such as: the proper relationship between business, government, and the public interest the possible synergies and tensions between economic growth and equity how economic transition has reshaped cities The premise of the course is that the core issue in transition involves institution-building and re-building in different contexts.", "course_url": "https://ocw.mit.edu/courses/11-946-planning-in-transition-economies-for-growth-and-equity-spring-2004/", "image_url": "https://ocw.mit.edu/courses/11-946-planning-in-transition-economies-for-growth-and-equity-spring-2004/43ac3fdad6212047c7823a6223d9af73_11-946s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-946-spring-2004-course-home", "course_id": "mitocw-11-946-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-946-planning-in-transition-economies-for-growth-and-equity-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "fbacfbadc9c1319ce799ba5c34c2ae151f3e9814a5e01eed18bf949313cabffd", "error": null}, {"resource_id": "mitocw-11-946-spring-2004-syllabus", "course_id": "mitocw-11-946-spring-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/11-946-planning-in-transition-economies-for-growth-and-equity-spring-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03",