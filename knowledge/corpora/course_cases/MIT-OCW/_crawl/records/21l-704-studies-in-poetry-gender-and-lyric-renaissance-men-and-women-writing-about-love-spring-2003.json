{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-704-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.704"], "cross_listed_codes": [], "course_title": "Studies in Poetry: Gender and Lyric -- Renaissance Men and Women Writing about Love", "course_slug": "21l-704-studies-in-poetry-gender-and-lyric-renaissance-men-and-women-writing-about-love-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Literature"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Mary Fuller"], "subject_primary": "Literature", "subject_secondary": ["Criticism", "International Literature", "Poetry", "Society", "Gender Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["Criticism", "International Literature", "Poetry"]}]}, {"name": "Society", "subtopics": [{"name": "Gender Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "The core of this seminar will be the great sequences of English love sonnets written by William Shakespeare, Philip Sidney, Edmund Spenser, and Mary Wroth. These poems cover an enormous amount of aesthetic and psychological ground: ranging from the utterly subjective to the entirely public or conventional, from licit to forbidden desires, they might also serve as a manual of experimentation with the resources of sound, rhythm, and figuration in poetry. Around these sequences, we will develop several other contexts, using both Renaissance texts and modern accounts: the Petrarchan literary tradition (poems by Francis Petrarch and Sir Thomas Wyatt); the social, political, and ethical uses of love poetry (seduction, getting famous, influencing policy, elevating morals, compensating for failure); other accounts of ideal masculinity and femininity (conduct manuals, theories of gender and anatomy); and the other limits of the late sixteenth century vogue for love poetry: narrative poems, pornographic poems, poems that don’t work.", "course_url": "https://ocw.mit.edu/courses/21l-704-studies-in-poetry-gender-and-lyric-renaissance-men-and-women-writing-about-love-spring-2003/", "image_url": "https://ocw.mit.edu/courses/21l-704-studies-in-poetry-gender-and-lyric-renaissance-men-and-women-writing-about-love-spring-2003/33e27be254fb3b5b18eab41da6f858f1_21l-704s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-704-spring-2003-course-home", "course_id": "mitocw-21l-704-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-704-studies-in-poetry-gender-and-lyric-renaissance-men-and-women-writing-about-love-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "9ebe58f387cc24f70e7ba382c70d767aece524ee7ab14f0b773b35dcd4dba6e7", "error": null}, {"resource_id": "mitocw-21l-704-spring-2003-syllabus", "course_id": "mitocw-21l-704-spring-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/21l-704-studies-in-poetry-gender-and-lyric-renaissance-men-and-women-writing-about-love-spring-2003