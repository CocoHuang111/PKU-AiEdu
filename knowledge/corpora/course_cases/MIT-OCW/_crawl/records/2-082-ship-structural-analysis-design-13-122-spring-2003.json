{"course": {"schema_version": "1.0", "course_id": "mitocw-2-082-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["2.082"], "cross_listed_codes": [], "course_title": "Ship Structural Analysis & Design (13.122)", "course_slug": "2-082-ship-structural-analysis-design-13-122-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Mechanical Engineering"], "academic_levels": ["Graduate"], "instructors": ["Prof. David Burke"], "subject_primary": "Aerospace Engineering", "subject_secondary": ["Structural Mechanics", "Civil Engineering", "Structural Engineering", "Ocean Engineering", "Ocean Structures"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Aerospace Engineering", "specialties": ["Structural Mechanics"]}, {"name": "Civil Engineering", "specialties": ["Structural Engineering"]}, {"name": "Ocean Engineering", "specialties": ["Ocean Structures"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes"], "description": "This course is intended for first year graduate students and advanced undergraduates with an interest in design of ships or offshore structures. It requires a sufficient background in structural mechanics. Computer applications are utilized, with emphasis on the theory underlying the analysis. Hydrostatic loading, shear load and bending moment, and resulting primary hull primary stresses will be developed. Topics will include; ship structural design concepts, effect of superstructures and dissimilar materials on primary strength, transverse shear stresses in the hull girder, and torsional strength among others. Failure mechanisms and design limit states will be developed for plate bending, column and panel buckling, panel ultimate strength, and plastic analysis. Matrix stiffness, grillage, and finite element analysis will be introduced. Design of a ship structure will be analyzed by “hand” with desktop computer tools and a final design project using current applications for structural design of a section will be accomplished. This course was originally offered in Course 13 (Department of Ocean Engineering) as 13.122. In 2005, ocean engineering subjects became part of Course 2 (Department of Mechanical Engineering), and this course was renumbered 2.082.", "course_url": "https://ocw.mit.edu/courses/2-082-ship-structural-analysis-design-13-122-spring-2003/", "image_url": "https://ocw.mit.edu/courses/2-082-ship-structural-analysis-design-13-122-spring-2003/43dfd58c0358dd809267e10ff528a5b7_2-082s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": true, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-2-082-spring-2003-course-home", "course_id": "mitocw-2-082-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/2-082-ship-structural-analysis-design-13-122-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "3570559c6163acec126ce8be8101c0da6c9eb667f1f3f7a395666a0dd1f8c863", "error": null}, {"resource_id": "mitocw-2-082-spring-2003-syllabus", "course_id": "mitocw-2-082-spring-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/2-082