{"course": {"schema_version": "1.0", "course_id": "mitocw-15-431-spring-2011", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.431"], "cross_listed_codes": [], "course_title": "Entrepreneurial Finance", "course_slug": "15-431-entrepreneurial-finance-spring-2011", "term": "Spring", "year": 2011, "as_taught_in": "Spring 2011", "language": "en", "departments": ["Sloan School of Management"], "academic_levels": ["Graduate"], "instructors": ["Prof. Antoinette Schoar"], "subject_primary": "Entrepreneurship", "subject_secondary": ["Finance", "Social Science", "Economics", "Financial Economics"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Entrepreneurship", "specialties": []}, {"name": "Finance", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["Financial Economics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments"], "description": "15.431 Entrepreneurial Finance examines the elements of entrepreneurial finance, focusing on technology-based start-up ventures and the early stages of company development. The course addresses key questions which challenge all entrepreneurs: how much money can and should be raised; when should it be raised and from whom; what is a reasonable valuation of the company; and how should funding, employment contracts and exit decisions be structured. It aims to prepare students for these decisions, both as entrepreneurs and venture capitalists. In addition, the course includes an in-depth analysis of the structure of the private equity industry.", "course_url": "https://ocw.mit.edu/courses/15-431-entrepreneurial-finance-spring-2011/", "image_url": "https://ocw.mit.edu/courses/15-431-entrepreneurial-finance-spring-2011/b2b18a4faac95bb76b6ceaa47bbe7045_15-431s11.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecomm