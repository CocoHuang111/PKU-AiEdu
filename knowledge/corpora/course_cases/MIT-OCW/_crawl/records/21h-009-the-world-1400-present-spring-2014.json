{"course": {"schema_version": "1.0", "course_id": "mitocw-21h-009-spring-2014", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21H.009"], "cross_listed_codes": [], "course_title": "The World: 1400-Present", "course_slug": "21h-009-the-world-1400-present-spring-2014", "term": "Spring", "year": 2014, "as_taught_in": "Spring 2014", "language": "en", "departments": ["History"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Anne McCants", "Prof. Jeffrey S. Ravel"], "subject_primary": "History", "subject_secondary": ["World History"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["World History"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments", "Lecture Notes", "Written Assignments"], "description": "This course surveys the increasing interaction between communities, as the barrier of distance succumbed to both curiosity and new transport technologies. It explores Western Europe and the United States’ rise to world dominance, as well as the great divergence in material, political, and technological development between Western Europe and East Asia post–1750, and its impact on the rest of the world. It examines a series of evolving relationships, including human beings and their physical environment; religious and political systems; and sub-groups within communities, sorted by race, class, and gender. It introduces historical and other interpretive methodologies using both primary and secondary source materials.", "course_url": "https://ocw.mit.edu/courses/21h-009-the-world-1400-present-spring-2014/", "image_url": "https://ocw.mit.edu/courses/21h-009-the-world-1400-present-spring-2014/e784103eace7c035da208c6614752572_21h-009s14.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "r