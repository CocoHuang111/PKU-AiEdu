{"course": {"schema_version": "1.0", "course_id": "mitocw-21h-224-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21H.224"], "cross_listed_codes": [], "course_title": "Law and Society in US History", "course_slug": "21h-224-law-and-society-in-us-history-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["History"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Christopher Capozzola"], "subject_primary": "History", "subject_secondary": ["American History", "Philosophy", "Political Philosophy", "Social Science", "Anthropology", "Cultural Anthropology", "Legal Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["American History"]}, {"name": "Philosophy", "specialties": ["Political Philosophy"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}, {"name": "Legal Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "As events of the last few years have shown, the Supreme Court has played a crucial role in American political life. There is practically no issue of social significance in the American past that did not at some point end up in the nation’s courtrooms, yet much of the workings of the constitution remain obscure. This subject is designed to introduce students to the main themes and events of American constitutional law since 1787. It introduces terms and concepts of law and legal history, focusing on three recurring themes in American public life: liberty, equality, and property. Readings consist mostly of original court cases, especially from the U.S. Supreme Court, but the focus of the class is on the historical connections between those cases and broader social, political, and cultural trends.", "c