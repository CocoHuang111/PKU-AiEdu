{"course": {"schema_version": "1.0", "course_id": "mitocw-21a-501j-spring-2013", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21A.501J"], "cross_listed_codes": ["STS.074J"], "course_title": "Art, Craft, Science", "course_slug": "21a-501j-art-craft-science-spring-2013", "term": "Spring", "year": 2013, "as_taught_in": "Spring 2013", "language": "en", "departments": ["Anthropology", "Science, Technology, and Society"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Heather Paxson"], "subject_primary": "Fine Arts", "subject_secondary": ["Social Science", "Anthropology", "Cultural Anthropology", "Economics", "Industrial Organization", "International Development"], "topic_tree": [{"name": "Fine Arts", "subtopics": []}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}, {"name": "Economics", "specialties": ["Industrial Organization", "International Development"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "This course examines how people learn, practice, and evaluate traditional and contemporary craft techniques. Social science theories of design, embodiment, apprenticeship learning, skill, labor, expertise, and tacit knowledge are used to explore distinctions and connections among art, craft, and science. We will also discuss the commoditization of craft into market goods, collectible art, and tourism industries. Ethnographic and historical case studies include textiles, glassblowing, quilting, cheese making, industrial design, home cooking, factory and laboratory work, CAD-CAM. In-class demonstrations and hands-on craft projects will be included.", "course_url": "https://ocw.mit.edu/courses/21a-501j-art-craft-science-spring-2013/", "image_url": "https://ocw.mit.edu/courses/21a-501j-art-craft-science-spring-2013/273e847de801972b18977a2d9fb9b11c_21a-5