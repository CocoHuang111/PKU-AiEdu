{"course": {"schema_version": "1.0", "course_id": "mitocw-mas-s60-spring-2025", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["MAS.S60"], "cross_listed_codes": [], "course_title": "How to AI (Almost) Anything", "course_slug": "mas-s60-how-to-ai-almost-anything-spring-2025", "term": "Spring", "year": 2025, "as_taught_in": "Spring 2025", "language": "en", "departments": ["Media Arts and Sciences"], "academic_levels": ["Graduate"], "instructors": ["Prof. Paul Liang"], "subject_primary": "Computer Science", "subject_secondary": ["Artificial Intelligence"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Artificial Intelligence"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Readings", "Written Assignments"], "description": "Artificial Intelligence (AI) holds great promise as a technology to enhance digital productivity, physical interactions, overall well-being, and the human experience. To enable the true impact of AI, these systems will need to be grounded in real-world data modalities, from language-only systems to vision, audio, sensors, medical data, music, art, smell, and taste. This course will introduce the basic principles of AI (focusing on modern deep learning and foundation models) and how we can apply AI to novel real-world data modalities. In addition, we will introduce the principles of multimodal AI that can process many modalities at once, such as connecting language and multimedia, music and art, sensing and actuation, and more. Through lectures, readings, discussions, and a significant research component, this course will develop critical thinking skills and intuitions when applying AI to new data modalities, knowledge of recent technical achievements in AI, and a deeper understanding of the AI research process.", "course_url": "https://ocw.mit.edu/courses/mas-s60-how-to-ai-almost-anything-spring-2025/", "image_url": "https://ocw.mit.edu/courses/mas-s60-how-to-ai-almost-anything-spring-2025/mitmas_s60_s25.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-mas-s60-spring-2025-course-home", "course_id": "mitocw-mas-s60-spring-2025", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/mas-s60-how-to-ai-almost-anything-spring-2025/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "f65491889a308b97f5b927bc65254262993b466a5e75af9f09dc1e3334d76157", "error": null}, {"resource_id": "mitocw-mas-s60-spring-2025-course-website", "course_id": "mitocw-mas-s60-spring-2025", "resource_type": "course_website", "source_title": "Course Website", "source_url": "https://mit-mi.github.io/how2ai-course/spring2025/", "source_format": "html", "availability": "available", "extraction_policy": "index_only", "extraction_status": "skipped", "local_path": null, "capture_date": "2026-10-03", "content_sha256": null, "error": null}]}