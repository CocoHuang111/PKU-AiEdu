{"course": {"schema_version": "1.0", "course_id": "mitocw-14-01sc-fall-2011", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["14.01SC"], "cross_listed_codes": [], "course_title": "Principles of Microeconomics", "course_slug": "14-01sc-principles-of-microeconomics-fall-2011", "term": "Fall", "year": 2011, "as_taught_in": "Fall 2011", "language": "en", "departments": ["Economics"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Jonathan Gruber"], "subject_primary": "Economics", "subject_secondary": ["Microeconomics"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["Microeconomics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exam Solutions", "Exams", "Lecture Notes", "Lecture Videos", "Open Textbooks", "Problem Set Solutions", "Problem Sets", "Problem-solving Videos", "Supplemental Exam Materials"], "description": "14.01 Principles of Microeconomics is an introductory undergraduate course that teaches the fundamentals of microeconomics. This course introduces microeconomic concepts and analysis, supply and demand analysis, theories of the firm and individual behavior, competition and monopoly, and welfare economics. Students will also be introduced to the use of microeconomic applications to address problems in current economic policy throughout the semester. This course is a core subject in MIT’s undergraduate Energy Studies Minor . This Institute-wide program complements the deep expertise obtained in any major with a broad understanding of the interlinked realms of science, technology, and social sciences as they relate to energy and associated environmental challenges. Course Format This course has been designed for independent study. It includes all of the materials you will need to understand the concepts covered in this subject. The materials in this course include: A complete set of Lecture Videos by Prof. Jon Gruber. Reading Assignments in your choice of two textbooks – one of which is a free online edition - as preparation for the lectures. Multiple-choice Quizzes to assess your understanding of the key concepts in each session. Problem Sets with solution keys to test your ability to apply to concepts covered in lecture, and Problem Solving Videos to provide step-by-step instruction through several problem set solutions. A collection of links For Further Study to provide supplemental online content. A full set of Exams , including review material and practice exams to help you prepare.", "course_url": "https://ocw.mit.edu/courses/14-01sc-principles-of-microeconomics-fall-2011/", "image_url": "https://ocw.mit.edu/courses/14-01sc-principles-of-microeconomics-fall-2011/4aca9caa520d6e6ce06d163f4c3ba7f8_14-01scf11.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": true, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-14-01sc-fall-2011-course-home", "course_id": "mitocw-14-01sc-fall-2011", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/14-01sc-principles-of-microeconomics-fall-2011/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "a38f6d4256ba4cc008ce2f707ec9cb3884d17dd6f05901b5f813f6a2ecf21cd4", "error": null}, {"resource_id": 