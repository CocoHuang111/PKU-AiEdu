{"course": {"schema_version": "1.0", "course_id": "mitocw-res-6-001-spring-2008", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.6-001"], "cross_listed_codes": [], "course_title": "Electromagnetic Fields and Energy", "course_slug": "res-6-001-electromagnetic-fields-and-energy-spring-2008", "term": "Spring", "year": 2008, "as_taught_in": "Spring 2008", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate"], "instructors": ["Hermann A. Haus", "James R. Melcher", "Markus Zahn", "Manuel L. Silva"], "subject_primary": "Electrical Engineering", "subject_secondary": ["Science", "Physics", "Electromagnetism"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Electrical Engineering", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Physics", "specialties": ["Electromagnetism"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Videos", "Open Textbooks", "Problem Set Solutions", "Problem Sets"], "description": "Published in 1989 by Prentice-Hall, this book is a useful resource for educators and self-learners alike. The text is aimed at those who have seen Maxwell’s equations in integral and differential form and who have been exposed to some integral theorems and differential operators. A hypertext version of this textbook can be found here . An accompanying set of video demonstrations is available below. These video demonstrations convey electromagnetism concepts. The demonstrations are related to topics covered in the textbook. They were prepared by Markus Zahn, James R. Melcher, and Manuel L. Silva and were produced by the Department of Electrical Engineering and Computer Science at the Massachusetts Institute of Technology. The purpose of these demonstrations is to make mathematical analysis of electromagnetism take on physical meaning. Based on relatively simple configurations and arrangements of equipment, they make a direct connection between what has been analytically derived and what is observed. They permit the student to observe physically what has been described symbolically. Often presented with a plot of theoretical predictions that are compared to measured data, these demonstrations give the opportunity to test the range of validity of the theory and present a quantitative approach to dealing with the physical world. The short form of these videos contains the demonstrations only. The long form also presents theory, diagrams, and calculations in support of the demonstrations. These videos are used in the courses 6.013/ESD.013J and 6.641 .", "course_url": "https://ocw.mit.edu/courses/res-6-001-electromagnetic-fields-and-energy-spring-2008/", "image_url": "https://ocw.mit.edu/courses/res-6-001-electromagnetic-fields-and-energy-spring-2008/22be3daa0aa336953e173ab8d8e4a6a5_res-6-001s08.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-res-6-001-spring-2008-course-home", "course_id": "mitocw-res-6-001-spring-2008", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/res-6-001-electromagnetic-fields-and-energy-spring-2008/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2