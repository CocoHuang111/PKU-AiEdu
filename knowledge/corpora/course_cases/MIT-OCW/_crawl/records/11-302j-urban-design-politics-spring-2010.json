{"course": {"schema_version": "1.0", "course_id": "mitocw-11-302j-spring-2010", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.302J"], "cross_listed_codes": ["4.253J"], "course_title": "Urban Design Politics", "course_slug": "11-302j-urban-design-politics-spring-2010", "term": "Spring", "year": 2010, "as_taught_in": "Spring 2010", "language": "en", "departments": ["Urban Studies and Planning", "Architecture"], "academic_levels": ["Graduate"], "instructors": ["Prof. Lawrence Vale"], "subject_primary": "Political Science", "subject_secondary": ["Public Administration", "Public Policy", "Urban Studies", "Urban Planning"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Political Science", "specialties": []}, {"name": "Public Administration", "specialties": ["Public Policy"]}, {"name": "Urban Studies", "specialties": ["Urban Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments with Examples"], "description": "This is a seminar about the ways that urban design contributes to the distribution of political power and resources in cities. “Design,” in this view, is not some value-neutral aesthetic applied to efforts at urban development but is, instead, an integral part of the motives driving that development. The class investigates the nature of the relations between built form and political purposes through close examination of a wide variety of situations where public and private sector design commissions and planning processes have been clearly motivated by political pressures, as well as situations where the political assumptions have remained more tacit. We will explore cases from both developed and developing countries.", "course_url": "https://ocw.mit.edu/courses/11-302j-urban-design-politics-spring-2010/", "image_url": "https://ocw.mit.edu/courses/11-302j-urban-design-politics-spring-2010/36063fdccca43fd9bd3589e