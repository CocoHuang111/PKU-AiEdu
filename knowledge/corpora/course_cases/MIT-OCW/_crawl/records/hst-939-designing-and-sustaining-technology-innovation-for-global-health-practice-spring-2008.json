ionale design of technology and service solutions. The lectures provide the foundation for faculty-mentored pilot project from MOH, students, or non-profit sponsors that may involve creation of a market or business plan, product development, or a research study design.", "course_url": "https://ocw.mit.edu/courses/hst-939-designing-and-sustaining-technology-innovation-for-global-health-practice-spring-2008/", "image_url": "https://ocw.mit.edu/courses/hst-939-designing-and-sustaining-technology-innovation-for-global-health-practice-spring-2008/021465f77927a52d6d932580d106fb92_hst-939s08.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": true, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-hst-939-spring-2008-course-home", "course_id": "mitocw-hst-939-spring-2008", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/hst-939-designing-and-sustaining-technology-innovation-for-global-health-practice-spring-2008/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "ef757b5afeb841d223a0eddee58767645e7f28f93c16f2dd52a6d337e1398225", "error": null}, {"resource_id": "mitocw-hst-939-spring-2008-syllabus", "course_id": "mitocw-hst-939-spring-2008", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/hst-939-designing-