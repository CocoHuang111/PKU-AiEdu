{"course": {"schema_version": "1.0", "course_id": "mitocw-6-s079-spring-2013", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.S079"], "cross_listed_codes": [], "course_title": "Nanomaker", "course_slug": "6-s079-nanomaker-spring-2013", "term": "Spring", "year": 2013, "as_taught_in": "Spring 2013", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Katey Lo", "Dr. Joseph Summers", "Prof. Vladimir Bulovic", "Prof. Rajeev Ram"], "subject_primary": "Technology", "subject_secondary": ["Engineering", "Electrical Engineering", "Electronics", "Materials Science and Engineering", "Electronic Materials", "Nanotechnology"], "topic_tree": [{"name": "Energy", "subtopics": [{"name": "Technology", "specialties": []}]}, {"name": "Engineering", "subtopics": [{"name": "Electrical Engineering", "specialties": ["Electronics"]}, {"name": "Materials Science and Engineering", "specialties": ["Electronic Materials"]}, {"name": "Nanotechnology", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Demonstration Videos", "Written Assignments"], "description": "This course links clean energy sources and storage technology to energy consumption case studies to give students a concept of the full circle of production and consumption. Specifically, photovoltaic, organic photovoltaic, piezoelectricity and thermoelectricity sources are applied to electrophoresis, lab on a chip, and paper microfluidic applications–relevant analytical techniques in biology and chemistry. Hands-on experimentation with everyday materials and equipment help connect the theory with the implementation. Complementary laboratories fabricating LEDs, organic LEDs and spectrometers introduce the diagnostic tools used to characterize energy efficiency. This course is one of many OCW Energy Courses , and it is an elective subject in MIT’s undergraduate Energy Studies Minor . This Institute-wide program complements the deep expertise obtained in any major with a broad understanding of the interlinked realms of science, technology, and social sciences as they relate to energy and associated environmental challenges.", "course_url": "https://ocw.mit.edu/courses/6-s079-nanomaker-spring-2013/", "image_url": "https://ocw.mit.edu/courses/6-s079-nanomaker-spring-2013/c28ded7272e98e277c81ca2b3d475106_6-s079s13.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": false, "assignments": false, "projects": true, "exams": false, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-6-s079-spring-2013-course-home", "course_id": "mitocw-6-s079-spring-2013", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/6-s079-nanomaker-spring-2013/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "71aebfabfcc5a359ed9c49e75d8a8701a4f86069fddda116122e513e300bd5df", "error": null}, {"resource_id": "mitocw-6-s079-spring-2013-syllabus", "course_id": "mitocw-6-s079-spring-2013", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/6-s079-nanomaker-spring-2013/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": 