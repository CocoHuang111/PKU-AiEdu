{"course": {"schema_version": "1.0", "course_id": "mitocw-6-s890-fall-2024", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.S890"], "cross_listed_codes": [], "course_title": "Topics in Multiagent Learning", "course_slug": "6-s890-topics-in-multiagent-learning-fall-2024", "term": "Fall", "year": 2024, "as_taught_in": "Fall 2024", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Gabriele Farina"], "subject_primary": "Computer Science", "subject_secondary": ["Artificial Intelligence"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Artificial Intelligence"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Set Solutions", "Problem Sets", "Projects", "Readings"], "description": "While machine learning techniques have had significant success in single-agent settings, an increasingly large body of literature has been studying settings involving several learning agents with different objectives. In these settings, standard training methods such as gradient descent are less successful and the simultaneous learning of the agents commonly leads to non-stationary and even chaotic system dynamics. Motivated by these challenges, this course presents the foundations of multi-agent systems from a combined game-theoretic, optimization, and learning-theoretic perspective. We start with basic matrix games, such as rock-paper-scissors, and advance to more complex forms including imperfect information games and structured games like combinatorial games, polymatrix games, and stochastic games. Topics will cover various equilibrium concepts, aspects of equilibrium computation and learning, as well as the computational complexity of finding equilibria. Additionally, we will examine how these models and methods have driven recent breakthroughs in AI, producing human- and superhuman-level agents for well known games such as Go, poker, Diplomacy, and Stratego.", "course_url": "https://ocw.mit.edu/courses/6-s890-topics-in-multiagent-learning-fall-2024/", "image_url": "https://ocw.mit.edu/courses/6-s890-topics-in-multiagent-learning-fall-2024/mit6_s890_f24.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-6-s890-fall-2024-course-home", "course_id": "mitocw-6-s890-fall-2024", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/6-s890-topics-in-multiagent-learning-fall-2024/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "2c5dd5dd66f89abcd26ca1cf3ad2df91bdef332d80169eb8e5207cd46ab38ab7", "error": null}, {"resource_id": "mitocw-6-s890-fall-2024-syllabus", "course_id": "mitocw-6-s890-fall-2024", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/6-s890-topics-in-multiagent-learning-fall-2024/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "825edf5fc9f2af62ef67ca3ed3feb55ab25e86cef2d5616a3bb9893370ef4bac