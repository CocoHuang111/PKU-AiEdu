{"course": {"schema_version": "1.0", "course_id": "mitocw-1-221j-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["1.221J"], "cross_listed_codes": ["11.527J", "ESD.201J"], "course_title": "Transportation Systems", "course_slug": "1-221j-transportation-systems-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Civil and Environmental Engineering", "Urban Studies and Planning", "Engineering Systems Division"], "academic_levels": ["Graduate"], "instructors": ["Prof. Joseph Sussman"], "subject_primary": "Civil Engineering", "subject_secondary": ["Transportation Engineering", "Social Science", "Urban Studies", "Transportation Planning"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Civil Engineering", "specialties": ["Transportation Engineering"]}]}, {"name": "Social Science", "subtopics": [{"name": "Urban Studies", "specialties": ["Transportation Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments with Examples"], "description": "Approaching transportation as a complex, large-scale, integrated, open system (CLIOS), this course strives to be an interdisciplinary systems subject in the “open” sense. It introduces qualitative modeling ideas and various techniques and philosophies of modeling complex transportation enterprises. It also introduces conceptual frameworks for qualitative analysis, such as frameworks for regional strategic planning, institutional change analysis, and new technology development and deployment. And it covers transportation as a large-scale, integrated system that interacts directly with the social, political, and economic aspects of contemporary society. Fundamental elements and issues shaping traveler and freight transportation systems are covered, along with underlying principles governing transportation planning, investment, operations, and maintenance.", "course_url": "https://ocw.mit.edu/courses/1-221j-transportation-systems-fall-2004/", "image_url": "https://ocw.mit.edu/courses/1-221j-transportation-systems-fall-2004/7b789dd189d4638798e6775374387127_1-221jf04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": true, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-1-221j-fall-2004-course-home", "course_id": "mitocw-1-221j-fall-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/1-221j-transportation-systems-fall-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "7359ad3c4d997e1434305f9b3fb10b0e1a167729b83f5aeff05a9e34ae3af8b3", "error": null}, {"resource_id": "mitocw-1-221j-fall-2004-syllabus", "course_id": "mitocw-1-221j-fall-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/1-221j-transportation-systems-fall-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "caa3c7f22493db7819aa261340eec95205077433db6de55f8beb03992da4c925", "error": null}, {"resource_id": "mitocw-1-221j-fall-2004-calendar", "course_id": "mitocw-1-221j-f