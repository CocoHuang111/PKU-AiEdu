{"course": {"schema_version": "1.0", "course_id": "mitocw-mas-742-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["MAS.742"], "cross_listed_codes": [], "course_title": "Industrial Design Intelligence: A Cognitive Approach to Engineering", "course_slug": "mas-742-industrial-design-intelligence-a-cognitive-approach-to-engineering-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Media Arts and Sciences"], "academic_levels": ["Graduate"], "instructors": ["Prof. Ted Selker"], "subject_primary": "Electrical Engineering", "subject_secondary": ["Electronics", "Mechanical Engineering", "Mechanical Design", "Science", "Cognitive Science"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Electrical Engineering", "specialties": ["Electronics"]}, {"name": "Mechanical Engineering", "specialties": ["Mechanical Design"]}]}, {"name": "Science", "subtopics": [{"name": "Cognitive Science", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Projects with Examples"], "description": "This class investigates cognitive science and technology as it is applied to the industrial design process. The class introduces prototyping techniques and approaches for objective evaluation as part of the design process. Students practice evaluating products with mechanical and electronic aspects. Evaluation processes are applied to creating functioning smart product prototypes. This is a project oriented subject that draws upon engineering, aesthetic, and creative skills. It is geared toward students interested in creating physical products which encompass electronics and computers, aimed at including them in smart scenarios. Students in the class will present readings, learn prototyping skills, create a product prototype, and complete a publication style paper.", "course_url": "https: