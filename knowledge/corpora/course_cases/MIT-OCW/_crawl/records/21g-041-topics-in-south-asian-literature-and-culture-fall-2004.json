{"course": {"schema_version": "1.0", "course_id": "mitocw-21g-041-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21G.041"], "cross_listed_codes": [], "course_title": "Topics in South Asian Literature and Culture", "course_slug": "21g-041-topics-in-south-asian-literature-and-culture-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Global Studies and Languages"], "academic_levels": ["Undergraduate"], "instructors": ["Arundhati Banerjee"], "subject_primary": "Media Studies", "subject_secondary": ["Humanities", "Literature", "International Literature", "Social Science", "Anthropology", "Cultural Anthropology", "Society", "Asian Studies"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Media Studies", "specialties": []}]}, {"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["International Literature"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}]}, {"name": "Society", "subtopics": [{"name": "Asian Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments with Examples"], "description": "This subject aims to provide an overview of contemporary texts in regional languages in South Asian Literature and Cinema. We will cover major authors and film makers, writing from Bangladesh, India, Nepal, Pakistan and Sri Lanka. Within India, we will look at authors and directors working in different regional languages and as we examine their different socio-cultural, political and historical contexts we will attempt to understand what it means to study them under the all-unifying category of “South Asian Literature and Culture”. Some of the major issues we shall explore include caste, gender, globalization and social change. We will end with exploring some of the newer, younger writers and directors and try to analyze some of the thematic and formal shifts in their work. Authors include Ashapurna Devi, Manto, Vijayan, Premchand, Mohanty, and Nasreen and film makers will include Adoor Gopalakrishnan, Satyajit Ray, Shyam Benegal, Aparna Sen and Rituporno Ghosh.", "course_url": "https://ocw.mit.edu/courses/21g-041-topics-in-south-asian-literature-and-culture-fall-2004/", "image_url": "https://ocw.mit.edu/courses/21g-041-topics-in-south-asian-literature-and-culture-fall-2004/7e2a6b1aea1db4ec6ad1f50f2b03cd0e_21g-041f04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21g-041-fall-2004-course-home", "course_id": "mitocw-21g-041-fall-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21g-041-topics-in-south-asian-literature-and-culture-fall-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "ee0ee0006f4496624e0dacf162ffc5f7409a672a83d78e9b1bc6ea4c3875676d", "error": null}, {"resource_id": "mitocw-21g-041-fall-2004-syllabus", "course_id": "mitocw-21g-041-fall-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/21g-041-topics-in-south-asian-literature-and-culture-fall-2004/pages/syllabus/", "source_f