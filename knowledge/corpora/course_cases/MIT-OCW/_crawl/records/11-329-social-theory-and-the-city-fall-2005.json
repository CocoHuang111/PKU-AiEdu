{"course": {"schema_version": "1.0", "course_id": "mitocw-11-329-fall-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.329"], "cross_listed_codes": [], "course_title": "Social Theory and the City", "course_slug": "11-329-social-theory-and-the-city-fall-2005", "term": "Fall", "year": 2005, "as_taught_in": "Fall 2005", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Richard Sennett"], "subject_primary": "Anthropology", "subject_secondary": ["Social Anthropology", "Sociology", "Urban Studies"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Social Anthropology"]}, {"name": "Sociology", "specialties": []}, {"name": "Urban Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments with Examples"], "description": "This course explores how social theories of urban life can be related to the city’s architecture and spaces. It is grounded in classic or foundational writings about the city addressing such topics as the public realm and public space, impersonality, crowds and density, surveillance and civility, imprinting time on space, spatial justice, and the segregation of difference. The aim of the course is to generate new ideas about the city by connecting the social and the physical, using Boston as a visual laboratory. Students are required to present a term paper mediating what is read with what has been observed.", "course_url": "https://ocw.mit.edu/courses/11-329-social-theory-and-the-city-fall-2005/", "image_url": "https://ocw.mit.edu/courses/11-329-social-theory-and-the-city-fall-2005/bb7d1d0fe6263cb9a88300e67466c905_11-329f05.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calend