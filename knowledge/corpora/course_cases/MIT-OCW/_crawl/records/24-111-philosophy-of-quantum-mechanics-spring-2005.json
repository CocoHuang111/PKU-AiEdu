{"course": {"schema_version": "1.0", "course_id": "mitocw-24-111-spring-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["24.111"], "cross_listed_codes": [], "course_title": "Philosophy of Quantum Mechanics", "course_slug": "24-111-philosophy-of-quantum-mechanics-spring-2005", "term": "Spring", "year": 2005, "as_taught_in": "Spring 2005", "language": "en", "departments": ["Linguistics and Philosophy"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Edward Hall"], "subject_primary": "Philosophy", "subject_secondary": ["Metaphysics", "Science", "Physics", "Quantum Mechanics"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Philosophy", "specialties": ["Metaphysics"]}]}, {"name": "Science", "subtopics": [{"name": "Physics", "specialties": ["Quantum Mechanics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments"], "description": "Quantum mechanics–even in the ordinary, non-relativistic, “particle” formulation that will be the primary focus of this course–has been a staggeringly successful physical theory, surely one of the crowning achievements of 20th century science. It’s also rather bizarre–bizarre enough to lead very intelligent and otherwise sensible people to make such claims as that the universe is perpetually splitting into many copies of itself, that conscious minds have the power to make physical systems “jump” in unpredictable ways, that classical logic stands in need of fundamental revision, and much, much more. In this course, we intelligent and sensible people will attempt to take a sober look at these and other alleged implications of quantum mechanics, as well as certain stubborn problems that continue to trouble its foundations. Along the way, we will take plenty of time out to discuss philosophical questions about science that quantum mechanics raises in new and interesting ways: e.g., what it means to attribute probabilities to physical events, what the aims of scientific inquiry are (does it aim at something true, or merely at something useful?), what the role of observation is in constructing a scientific theory, what it means to say that there is an “objective” physical world, whether something as basic as logic can be viewed as an empirical discipline, whether there can be meaningful scientific questions whose answers cannot possibly be settled by experiment, and more.", "course_url": "https://ocw.mit.edu/courses/24-111-philosophy-of-quantum-mechanics-spring-2005/", "image_url": "https://ocw.mit.edu/courses/24-111-philosophy-of-quantum-mechanics-spring-2005/d46f7083a5c959aab95afb6acb2678da_24-111s05.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-24-111-spring-2005-course-home", "course_id": "mitocw-24-111-spring-2005", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/24-111-philosophy-of-quantum-mechanics-spring-2005/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "0f12546b58e21c67d361ac1560969d4e111c3da51b9e5db055633608a52bb977", "error": null}, {"resource_id": "mitocw-24-111-spring-2005-syllabus", "course_id": "mitocw-24-111-spring-2005", "resource_type"