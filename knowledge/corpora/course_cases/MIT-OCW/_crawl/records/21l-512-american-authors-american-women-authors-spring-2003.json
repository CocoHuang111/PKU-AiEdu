{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-512-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.512"], "cross_listed_codes": ["WGS.517"], "course_title": "American Authors: American Women Authors", "course_slug": "21l-512-american-authors-american-women-authors-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Literature", "Women's and Gender Studies"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Wyn Kelley"], "subject_primary": "Literature", "subject_secondary": ["American Literature", "Criticism", "Society", "Gender Studies", "Women's Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["American Literature", "Criticism"]}]}, {"name": "Society", "subtopics": [{"name": "Gender Studies", "specialties": []}, {"name": "Women's Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "This subject, cross-listed in Literature and Women’s Studies, examines a range of American women authors from the seventeenth century to the present. It aims to introduce a number of literary genres and styles- the captivity narrative, slave novel, sensational, sentimental, realistic, and postmodern fiction- and also to address significant historical events in American women’s history: Puritanism, the American Revolution, industrialization and urbanization in the nineteenth century, the Harlem Renaissance, World War II, the 60s civil rights movements. A primary focus will be themes studied and understood through the lens of gender: war, violence, and sexual exploitation (Keller, Rowlandson, Rowson); the relationship between women and religion (Rowlandson, Rowson, Stowe); labor, poverty, and working conditions for women (Fern, Davis, Wharton); captivity and slavery (Rowlandson, Jacobs); class struggle (Fern, Davis, Wharton, Larsen); race and identity (Keller, Jacobs, Larsen, Morrison); feminist revisions of history (Stowe, Morrison, Keller); and the myth of the fallen woman (take your pick). Essays and in-class reports will focus more particularly on specific writers and themes and will stress the skills of close reading, annotation, research, and uses of multimedia where appropriate.", "course_url": "https://ocw.mit.edu/courses/21l-512-american-authors-american-women-authors-spring-2003/", "image_url": "https://ocw.mit.edu/courses/21l-512-american-authors-american-women-authors-spring-2003/5df9454bc59cedd0a1aad8aac145c180_21l-512s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-512-spring-2003-course-home", "course_id": "mitocw-21l-512-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-512-american-authors-american-women-authors-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "68eda50677cb32a83c737d83a47399d3c18002c2a36e09d301065c3b523039c8", "error": null}, {"resource_id": "mitocw-21l-512-spring-2003-syllabus", "course_id": "mitocw-21l-512-spring-2003", "resource_type": "syllabus", "source_title": "Syllabus", "sourc