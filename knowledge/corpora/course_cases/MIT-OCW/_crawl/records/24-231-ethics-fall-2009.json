{"course": {"schema_version": "1.0", "course_id": "mitocw-24-231-fall-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["24.231"], "cross_listed_codes": [], "course_title": "Ethics", "course_slug": "24-231-ethics-fall-2009", "term": "Fall", "year": 2009, "as_taught_in": "Fall 2009", "language": "en", "departments": ["Linguistics and Philosophy"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Julia Markovits"], "subject_primary": "Philosophy", "subject_secondary": ["Ethics"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Philosophy", "specialties": ["Ethics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Presentation Assignments", "Written Assignments"], "description": "This will be a seminar on classic and contemporary work on central topics in ethics. The first third of the course will focus on metaethics : we will examine the meaning of moral claims and ask whether there is any sense in which moral principles are objectively valid. The second third of the course will focus on normative ethics : what makes our lives worth living, what makes our actions right or wrong, and what do we owe to others? The final third of the course will focus on moral character : what is virtue, and how important is it? Can we be held responsible for what we do? When and why?", "course_url": "https://ocw.mit.edu/courses/24-231-ethics-fall-2009/", "image_url": "https://ocw.mit.edu/courses/24-231-ethics-fall-2009/03f3d1554a04cb93112454f4d9b448ff_24-231f09.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source