{"course": {"schema_version": "1.0", "course_id": "mitocw-17-436-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["17.436"], "cross_listed_codes": [], "course_title": "Territorial Conflict", "course_slug": "17-436-territorial-conflict-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Political Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. M. Taylor Fravel"], "subject_primary": "History", "subject_secondary": ["Military History", "Social Science", "Political Science", "International Relations", "Public Administration", "Military Studies", "Security Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["Military History"]}]}, {"name": "Social Science", "subtopics": [{"name": "Political Science", "specialties": ["International Relations"]}, {"name": "Public Administration", "specialties": ["Military Studies", "Security Studies"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "This graduate seminar introduces an emerging research program within International Relations on territorial conflict. While scholars have recognized that territory has been one of the most frequent issues over which states go to war, territorial conflicts have only recently become the subject of systematic study. This course will examine why territorial conflicts arise in the first place, why some of these conflicts escalate to high levels of violence and why other territorial disputes reach settlement, thereby reducing the likelihood of war. Readings in the course draw upon political geography and history as well as qualitative and quantitative approaches to political science.", "course_url": "https://ocw.mit.edu/courses/17-436-territorial-conflict-fall-2004/", "image_url": "https://ocw.mit.edu/courses/17-436-territorial-