{"course": {"schema_version": "1.0", "course_id": "mitocw-11-965-january-iap-2007", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.965"], "cross_listed_codes": [], "course_title": "Reflective Practice: An Approach for Expanding Your Learning Frontiers", "course_slug": "11-965-reflective-practice-an-approach-for-expanding-your-learning-frontiers-january-iap-2007", "term": "January IAP", "year": 2007, "as_taught_in": "January IAP 2007", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Ceasar McDowell", "Claudia Canepa", "Sebastiao Ferriera"], "subject_primary": "Innovation", "subject_secondary": ["Social Science", "Psychology"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Innovation", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Psychology", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Lecture Videos", "Written Assignments"], "description": "The course is an introduction to the approach of Reflective Practice developed by Donald Schön. It is an approach that enables professionals to understand how they use their knowledge in practical situations and how they can combine practice and learning in a more effective way. Through greater awareness of how they deploy their knowledge in practical situations, professionals can increase their capacities of learning in a more timely way. Understanding how they frame situations and ideas helps professionals to achieve greater flexibility and increase their capacity of conceptual innovation. The objective of the course is to introduce students to the approach and methods of reflective practice by raising their awareness about their own cognitive resources and how they use them in their practice. The course will introduce theories of learning, knowledge generation, framing and reframing, theories of action, reflection-in-practice, and conceptual innovation, and provide students with opportunities to experiment with these theories in real life through practical exercises in which they reflect on real situations that they have faced in their past professional experience. Through these practical exercises, students will have the opportunity to reflect on their thinking capacities in the context of their practice.", "course_url": "https://ocw.mit.edu/courses/11-965-reflective-practice-an-approach-for-expanding-your-learning-frontiers-january-iap-2007/", "image_url": "https://ocw.mit.edu/courses/11-965-reflective-practice-an-approach-for-expanding-your-learning-frontiers-january-iap-2007/0240a5fbf0bdf718971641a9482528c5_11-965iap07.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-965-january-iap-2007-course-home", "course_id": "mitocw-11-965-january-iap-2007", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-965-reflective-practice-an-approach-for-expanding-your-learning-frontiers-january-iap-2007/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "d5d07081400204fa99f2f89c36583ab54dcae6644910a4e5d28003ce5f87fdfd", "error": null}, {"resource_id": "mitocw-11