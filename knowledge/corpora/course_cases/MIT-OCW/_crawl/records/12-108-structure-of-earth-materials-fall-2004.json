{"course": {"schema_version": "1.0", "course_id": "mitocw-12-108-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["12.108"], "cross_listed_codes": [], "course_title": "Structure of Earth Materials", "course_slug": "12-108-structure-of-earth-materials-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Earth, Atmospheric, and Planetary Sciences"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. J. Evans", "Prof. Timothy Grove"], "subject_primary": "Mechanical Engineering", "subject_secondary": ["Solid Mechanics", "Science", "Chemistry", "Physical Chemistry", "Earth Science", "Geology", "Planetary Science"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Mechanical Engineering", "specialties": ["Solid Mechanics"]}]}, {"name": "Science", "subtopics": [{"name": "Chemistry", "specialties": ["Physical Chemistry"]}, {"name": "Earth Science", "specialties": ["Geology", "Planetary Science"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Image Gallery", "Lecture Notes", "Problem Sets"], "description": "This course provides a comprehensive introduction to crystalline structure, crystal chemistry, and bonding in rock-forming minerals. It introduces the theory relating crystal structure and crystal symmetry to physical properties such as refractive index, elastic modulus, and seismic velocity. It surveys the distribution of silicate, oxide, and metallic minerals in the interiors and on the surfaces of planets, and discusses the processes that led to their formation. It also addresses why diamonds are hard and why micas split into thin sheets.", "course_url": "https://ocw.mit.edu/courses/12-108-structure-of-earth-materials-fall-2004/", "image_url": "https://ocw.mit.edu/courses/12-108-structure-of-earth-materials-fall-2004/1b7356145d818eb27adc5682cfdff9ef_12-108f04.jpg", "license_n