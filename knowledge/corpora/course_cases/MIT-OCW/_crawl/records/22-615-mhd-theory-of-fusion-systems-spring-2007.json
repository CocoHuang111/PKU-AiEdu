{"course": {"schema_version": "1.0", "course_id": "mitocw-22-615-spring-2007", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["22.615"], "cross_listed_codes": [], "course_title": "MHD Theory of Fusion Systems", "course_slug": "22-615-mhd-theory-of-fusion-systems-spring-2007", "term": "Spring", "year": 2007, "as_taught_in": "Spring 2007", "language": "en", "departments": ["Nuclear Science and Engineering"], "academic_levels": ["Graduate"], "instructors": ["Prof. Jeffrey Freidberg"], "subject_primary": "Chemistry", "subject_secondary": ["Physical Chemistry", "Physics", "Electromagnetism", "High Energy Physics", "Nuclear Physics"], "topic_tree": [{"name": "Science", "subtopics": [{"name": "Chemistry", "specialties": ["Physical Chemistry"]}, {"name": "Physics", "specialties": ["Electromagnetism", "High Energy Physics", "Nuclear Physics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Lecture Notes", "Problem Sets"], "description": "This course discusses MHD equilibria in cylindrical, toroidal, and noncircular tokamaks. It covers derivation of the basic MHD model from the Boltzmann equation, use of MHD equilibrium theory in poloidal field design, MHD stability theory including the Energy Principle, interchange instability, ballooning modes, second region of stability, and external kink modes. Emphasis is on discovering configurations capable of achieving good confinement at high beta.", "course_url": "https://ocw.mit.edu/courses/22-615-mhd-theory-of-fusion-systems-spring-2007/", "image_url": "https://ocw.mit.edu/courses/22-615-mhd-theory-of-fusion-systems-spring-2007/48c6fdcd52c936a87f8852e3a8f73527_22-615s07.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": false, "lecture_notes": true, "assignments": true, "projects": false, "exams