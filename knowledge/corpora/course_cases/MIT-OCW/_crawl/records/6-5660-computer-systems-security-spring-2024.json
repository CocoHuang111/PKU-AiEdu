{"course": {"schema_version": "1.0", "course_id": "mitocw-6-5660-spring-2024", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.5660"], "cross_listed_codes": [], "course_title": "Computer Systems Security", "course_slug": "6-5660-computer-systems-security-spring-2024", "term": "Spring", "year": 2024, "as_taught_in": "Spring 2024", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate", "Graduate"], "instructors": ["Prof. Nickolai Zeldovich"], "subject_primary": "Computer Science", "subject_secondary": ["Computer Design and Engineering", "Software Design and Engineering"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Computer Design and Engineering", "Software Design and Engineering"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Instructor Insights"], "description": "This course covers design and implementation of secure computer systems. The lectures cover attacks that compromise security as well as techniques for achieving security, based on recent research papers. Topics include operating system security, privilege separation, capabilities, language-based security, cryptographic network protocols, trusted hardware, and security in web applications and mobile phones. The labs involve implementing and compromising a web application that sandboxes arbitrary code, supporting TLS certificates, and adding two-factor authentication. The course materials, which can be accessed via the external link to the left, are available for reuse under a Creative Commons Attribution 3.0 license.", "course_url": "https://ocw.mit.edu/courses/6-5660-computer-systems-security-spring-2024/", "image_url": "https://ocw.mit.edu/courses/6-5660-computer-systems-security-spring-2024/6-5660s24.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecomm