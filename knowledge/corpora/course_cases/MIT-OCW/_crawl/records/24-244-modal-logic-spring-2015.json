{"course": {"schema_version": "1.0", "course_id": "mitocw-24-244-spring-2015", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["24.244"], "cross_listed_codes": [], "course_title": "Modal Logic", "course_slug": "24-244-modal-logic-spring-2015", "term": "Spring", "year": 2015, "as_taught_in": "Spring 2015", "language": "en", "departments": ["Linguistics and Philosophy"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Stephen Yablo"], "subject_primary": "Linguistics", "subject_secondary": ["Semantics", "Philosophy", "Logic"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Linguistics", "specialties": ["Semantics"]}, {"name": "Philosophy", "specialties": ["Logic"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets", "Written Assignments"], "description": "Modal logic is the logic of necessity and possibility, and by extension of analogously paired notions like validity and consistency, obligation and permission, the known and the not-ruled-out. This a first course in the area. A solid background in first-order logic is essential. Topics to be covered include (some or all of) the main systems of propositional modal logic, Kripkean “possible world” semantics, strict implication, contingent identity, intensional objects, counterpart theory, the logic of actuality, and deontic and / or epistemic logic. The emphasis will be more on technical methods and results than philosophical applications.", "course_url": "https://ocw.mit.edu/courses/24-244-modal-logic-spring-2015/", "image_url": "https://ocw.mit.edu/courses/24-244-modal-logic-spring-2015/a3e1446a22c869dccb112479634da5e8_24-244s15.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": true, "assignments": true, "projects"