{"course": {"schema_version": "1.0", "course_id": "mitocw-9-71-fall-2007", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["9.71"], "cross_listed_codes": [], "course_title": "Functional MRI of High-Level Vision", "course_slug": "9-71-functional-mri-of-high-level-vision-fall-2007", "term": "Fall", "year": 2007, "as_taught_in": "Fall 2007", "language": "en", "departments": ["Brain and Cognitive Sciences"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Nancy Kanwisher"], "subject_primary": "Biomedical Instrumentation", "subject_secondary": ["Biomedical Signal and Image Processing", "Medical Imaging", "Science", "Biology", "Neuroscience"], "topic_tree": [{"name": "Health and Medicine", "subtopics": [{"name": "Biomedical Instrumentation", "specialties": []}, {"name": "Biomedical Signal and Image Processing", "specialties": []}, {"name": "Medical Imaging", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Biology", "specialties": ["Neuroscience"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Presentation Assignments", "Written Assignments with Examples"], "description": "We are now at an unprecedented point in the field of neuroscience: We can watch the human brain in action as it sees, thinks, decides, reads, and remembers. Functional magnetic resonance imaging (fMRI) is the only method that enables us to monitor local neural activity in the normal human brain in a noninvasive fashion and with good spatial resolution. A large number of far-reaching and fundamental questions about the human mind and brain can now be answered using straightforward applications of this technology. This is particularly true in the area of high-level vision, the study of how we interpret and use visual information including object recognition, mental imagery, visual attention, perceptual awareness, visually guided action, and visual memory. The goals of this course are to help students become savvy and critical readers of the current neuroimaging literature, to understand the strengths and weaknesses of the technique, and to design their own cutting-edge, theoretically motivated studies. Students will read, present to the class, and critique recently published neuroimaging articles, as well as write detailed proposals for experiments of their own. Lectures will cover the theoretical background on some of the major areas in high-level vision, as well as an overview of what fMRI has taught us and can in future teach us about each of these topics. Lectures and discussions will also cover fMRI methods and experimental design. A prior course in statistics and at least one course in perception or cognition are required.", "course_url": "https://ocw.mit.edu/courses/9-71-functional-mri-of-high-level-vision-fall-2007/", "image_url": "https://ocw.mit.edu/courses/9-71-functional-mri-of-high-level-vision-fall-2007/aee63f17841c908d66f95ea6d2912dab_9-71f07.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": true, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-9-71-fall-2007-course-home", "course_id": "mitocw-9-71-fall-2007", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/9-71-functional-mri-of-high-level-vision-fall-2007/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-