{"course": {"schema_version": "1.0", "course_id": "mitocw-6-005-fall-2008", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.005"], "cross_listed_codes": [], "course_title": "Elements of Software Construction", "course_slug": "6-005-elements-of-software-construction-fall-2008", "term": "Fall", "year": 2008, "as_taught_in": "Fall 2008", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Daniel Jackson", "Prof. Robert Miller"], "subject_primary": "Computer Science", "subject_secondary": ["Programming Languages", "Software Design and Engineering"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Programming Languages", "Software Design and Engineering"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets", "Programming Assignments with Examples", "Projects"], "description": "This course provides an introduction to the fundamental principles and techniques of software development that have greatest impact on practice. Topics include capturing the essence of a problem by recognizing and inventing suitable abstractions; key paradigms, including state machines, functional programming, and object-oriented programming; use of design patterns to bridge gap between models and code; the role of interfaces and specification in achieving modularity and decoupling; reasoning about code using invariants; testing, test-case generation and coverage; and essentials of programming with objects, functions, and abstract types. The course includes exercises in modeling, design, implementation and reasoning.", "course_url": "https://ocw.mit.edu/courses/6-005-elements-of-software-construction-fall-2008/", "image_url": "https://ocw.mit.edu/courses/6-005-elements-of-software-construction-fall-2008/d8a8e8172f2492649d68e