{"course": {"schema_version": "1.0", "course_id": "mitocw-17-317-spring-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["17.317"], "cross_listed_codes": [], "course_title": "U.S. Social Policy", "course_slug": "17-317-u-s-social-policy-spring-2006", "term": "Spring", "year": 2006, "as_taught_in": "Spring 2006", "language": "en", "departments": ["Political Science"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Andrea Campbell"], "subject_primary": "Political Science", "subject_secondary": ["American Politics", "Public Administration", "Public Policy", "Social Welfare"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Political Science", "specialties": ["American Politics"]}, {"name": "Public Administration", "specialties": ["Public Policy", "Social Welfare"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": [], "description": "This subject examines the historical development and contemporary politics of social policy in the United States. We will discuss the kinds of risks individuals face over a lifetime and why some are ameliorated by social policy while others are not (and how the U.S. is similar or different from other countries in this regard). We will examine the policymaking process in the U.S., why some alternatives are implemented and others abandoned, why some interests are privileged over others, and how the designs of policies can feed back and shape politics in a given policy area. Along the way we will examine interactions among political institutions, policy elites, the media, and the mass public.", "course_url": "https://ocw.mit.edu/courses/17-317-u-s-social-policy-spring-2006/", "image_url": "https://ocw.mit.edu/courses/17-317-u-s-social-policy-spring-2006/427d4fc35d71e4890d037d1925d7eed4_17-317s06.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", 