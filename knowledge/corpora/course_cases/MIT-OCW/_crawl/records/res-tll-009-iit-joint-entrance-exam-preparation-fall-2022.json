{"course": {"schema_version": "1.0", "course_id": "mitocw-res-tll-009-fall-2016", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.TLL-009"], "cross_listed_codes": [], "course_title": "Indian Institutes of Technology Joint Entrance Exam", "course_slug": "res-tll-009-iit-joint-entrance-exam-preparation-fall-2022", "term": "Fall", "year": 2016, "as_taught_in": "Fall 2016", "language": "en", "departments": [], "academic_levels": ["High School"], "instructors": ["Dr. Ankur  Gupta"], "subject_primary": "Teaching and Education", "subject_secondary": [], "topic_tree": [{"name": "Teaching and Education", "subtopics": []}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Videos"], "description": "The Joint Entrance Examination—Advanced* is a prestigious exam for high school students in India, as successful candidates go onto pursue undergraduate education from top colleges such as Indian Institutes of Technology and National Institutes of Technology. This resource provides free, open-source videos for students preparing for JEE-Advanced. This project was conceptualized and implemented by Dr. Ankur Gupta, now a professor at the University of Colorado Boulder. He holds a Ph.D. in Chemical Engineering from MIT and is an alumnus of IIT-Dehli. He had support for this project from Dr. Anshul Singhal, also an alumnus of IIT-Dehli and MIT. The initiative attracted several volunteers at MIT, including Rohit Kannan, Neelkanth Bardhan, Vaibhav Unhelkar, Ananth Govind Rajan, Pritish Kamath and Mikhil Ranka. *(Formerly the Indian Institutes of Technology—Joint Entrance Examination or IIT-JEE)", "course_url": "https://ocw.mit.edu/courses/res-tll-009-iit-joint-entrance-exam-preparation-fall-2022/", "image_url": "https://ocw.mit.edu/courses/res-tll-009-iit-joint-entrance-exam-preparation-fall-2022/res-tll-009-iit.png", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://