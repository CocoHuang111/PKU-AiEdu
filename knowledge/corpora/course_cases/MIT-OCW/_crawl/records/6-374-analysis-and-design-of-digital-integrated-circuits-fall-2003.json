{"course": {"schema_version": "1.0", "course_id": "mitocw-6-374-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.374"], "cross_listed_codes": [], "course_title": "Analysis and Design of Digital Integrated Circuits", "course_slug": "6-374-analysis-and-design-of-digital-integrated-circuits-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Anantha Chandrakasan"], "subject_primary": "Computer Science", "subject_secondary": ["Computer Design and Engineering", "Electrical Engineering", "Digital Systems", "Electronics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Computer Design and Engineering"]}, {"name": "Electrical Engineering", "specialties": ["Digital Systems", "Electronics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exam Solutions", "Exams", "Problem Sets", "Projects"], "description": "6.374 examines the device and circuit level optimization of digital building blocks. Topics covered include: MOS device models including Deep Sub-Micron effects; circuit design styles for logic, arithmetic and sequential blocks; estimation and minimization of energy consumption; interconnect models and parasitics; device sizing and logical effort; timing issues (clock skew and jitter) and active clock distribution techniques; memory architectures, circuits (sense amplifiers) and devices; testing of integrated circuits. The course employs extensive use of circuit layout and SPICE in design projects and software labs.", "course_url": "https://ocw.mit.edu/courses/6-374-analysis-and-design-of-digital-integrated-circuits-fall-2003/", "image_url": "https://ocw.mit.edu/courses/6-374-analysis-and-design-of-digital-integrated-circuits-fall-2003/886ef46329cb