{"course": {"schema_version": "1.0", "course_id": "mitocw-2-993-january-iap-2007", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["2.993"], "cross_listed_codes": [], "course_title": "Special Topics in Mechanical Engineering: The Art and Science of Boat Design", "course_slug": "2-993-special-topics-in-mechanical-engineering-the-art-and-science-of-boat-design-january-iap-2007", "term": "January IAP", "year": 2007, "as_taught_in": "January IAP 2007", "language": "en", "departments": ["Mechanical Engineering"], "academic_levels": ["Undergraduate"], "instructors": ["Christopher Dewart", "Kurt Hasselbalch", "Prof. Nicholas Patrikalakis", "Reuben Smith", "Antonio Dias"], "subject_primary": "Mechanical Engineering", "subject_secondary": ["Mechanical Design", "Ocean Engineering"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Mechanical Engineering", "specialties": ["Mechanical Design"]}, {"name": "Ocean Engineering", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Image Gallery", "Lecture Videos"], "description": "This class is jointly sponsored by the MIT Museum, Massachusetts Bay Maritime Artisans, the Department of Mechanical Engineering’s Center for Ocean Engineering, and the Department of Architecture. The course teaches the fundamental steps in traditional boat design and demonstrates connections between craft and modern methods. Instructors provide vessel design orientation and then students carve their own shape ideas in the form of a wooden half-hull model. Experts teach the traditional skills of visualizing and carving your model in this phase of the class. After the models are completed, a practicing naval architect guides students in translating shape from models into a lines plan. The final phase of the class is a comparative analysis of the designs generated by the group. This course is offered during the Independent Activities Period (IAP), which is a special 4-week term at MIT that runs from the first week of January until the end of the month.", "course_url": "https://ocw.mit.edu/courses/2-993-special-topics-in-mechanical-engineering-the-art-and-science-of-boat-design-january-iap-2007/", "image_url": "https://ocw.mit.edu/courses/2-993-special-topics-in-mechanical-engineering-the-art-and-science-of-boat-design-january-iap-2007/7bc5155780b293a6bc5a37c8d0911886_2-993iap07.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-2-993-january-iap-2007-course-home", "course_id": "mitocw-2-993-january-iap-2007", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/2-993-special-topics-in-mechanical-engineering-the-art-and-science-of-boat-design-january-iap-2007/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "8b5c4c73e5dc7d83db5464d62ffbb0b688d85d715156a66c20e900f14cd46def", "error": null}, {"resource_id": "mitocw-2-993-january-iap-2007-syllabus", "course_id": "mitocw-2-993-january-iap-2007", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/2-993-special-topics-in-mechanical-engineering-the-art-and-science-of-boat-design-january-iap-2007/pages/syllabus/", "source_for