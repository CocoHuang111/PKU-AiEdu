{"course": {"schema_version": "1.0", "course_id": "mitocw-12-141-january-iap-2012", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["12.141"], "cross_listed_codes": [], "course_title": "Electron Microprobe Analysis", "course_slug": "12-141-electron-microprobe-analysis-january-iap-2012", "term": "January IAP", "year": 2012, "as_taught_in": "January IAP 2012", "language": "en", "departments": ["Earth, Atmospheric, and Planetary Sciences"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Nilanjan Chatterjee"], "subject_primary": "Chemistry", "subject_secondary": ["Analytical Chemistry", "Physical Chemistry"], "topic_tree": [{"name": "Science", "subtopics": [{"name": "Chemistry", "specialties": ["Analytical Chemistry", "Physical Chemistry"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Lecture Notes", "Problem Sets"], "description": "The electron microprobe provides a complete micrometer-scale quantitative chemical analysis of inorganic solids. The method is nondestructive and utilizes characteristic X-rays excited by an electron beam incident on a flat surface of the sample. This course provides an introduction to the theory of X-ray microanalysis through wavelength and energy dispersive spectrometry (WDS and EDS), ZAF matrix correction procedures and scanning electron imaging with back-scattered electron (BSE), secondary electron (SE), X-ray using WDS or EDS (elemental mapping), and cathodoluminescence (CL). Lab sessions involve hands-on use of the JEOL JXA-8200 Superprobe.", "course_url": "https://ocw.mit.edu/courses/12-141-electron-microprobe-analysis-january-iap-2012/", "image_url": "https://ocw.mit.edu/courses/12-141-electron-microprobe-analysis-january-iap-2012/ff49b987744ee11ed3fd6820d389796a_12-141iap12.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabu