{"course": {"schema_version": "1.0", "course_id": "mitocw-3-012sx-spring-2019", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["3.012Sx"], "cross_listed_codes": ["3.012"], "course_title": "Structure of Materials", "course_slug": "3-012sx-structure-of-materials-spring-2019", "term": "Spring", "year": 2019, "as_taught_in": "Spring 2019", "language": "en", "departments": ["Materials Science and Engineering"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Silvija Gradecak"], "subject_primary": "Materials Science and Engineering", "subject_secondary": [], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Materials Science and Engineering", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exam Solutions", "Exams", "Lecture Videos"], "description": "Structure—or the arrangement of materials’ internal components—determines virtually everything about a material: its properties, its potential applications, and its performance within those applications. This three-part course explores the structure of a wide variety of materials with current-day engineering applications. Taken together, the three modules provide similar content to MIT’s sophomore-level materials structure curriculum. Part 1 of the course introduces amorphous materials and explores glasses and polymers, the factors that influence their structure, and how materials scientists measure and describe the structure of these materials. Then we discuss what it means for a material to be crystalline, how we describe periodic arrangement of atoms in a crystal, and how we can determine the structure of crystals through x-ray diffraction. Parts 2 and 3 explore the structure of materials in further depth. This course was organized as a three-part series on MITx by MIT’s Department of Materials Science and Engineering and is now archived on the Open Learning Library , which is free to use. You have the option to sign up and enroll in each module if you want to track your progress, or you can view and use all the materials without enrolling.", "course_url": "https://ocw.mit.edu/courses/3-012sx-structure-of-materials-spring-2019/", "image_url": "https://ocw.mit.edu/courses/3-012sx-structure-of-materials-spring-2019/0a515ca484bae72371cd7160c367f1e3_MIT3.012Sx.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-3-012sx-spring-2019-course-home", "course_id": "mitocw-3-012sx-spring-2019", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/3-012sx-structure-of-materials-spring-2019/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "3ea6d5a04c189b30c95977b465248351ceb6f10516309b379f8467fbac13eca5", "error": null}, {"resource_id": "mitocw-3-012sx-spring-2019-part-1-fundamentals-of-materials-structure", "course_id": "mitocw-3-012sx-spring-2019", "resource_type": "part_1_fundamentals_of_materials_structure", "source_title": "Part 1: Fundamentals of Materials Structure", "source_url": "https://openlearninglibrary.mit.edu/courses/course-v1:MITx+3.012S.1x+1T2019/about", "source_format": "html", "availability": "available", "extraction_policy": "index_only", "extraction_status": "skipped", "local_path": n