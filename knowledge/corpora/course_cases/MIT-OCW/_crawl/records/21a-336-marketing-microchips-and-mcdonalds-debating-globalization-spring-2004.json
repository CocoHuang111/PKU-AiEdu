{"course": {"schema_version": "1.0", "course_id": "mitocw-21a-336-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21A.336"], "cross_listed_codes": [], "course_title": "Marketing, Microchips and McDonalds: Debating Globalization", "course_slug": "21a-336-marketing-microchips-and-mcdonalds-debating-globalization-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Anthropology"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Christine Walley"], "subject_primary": "Globalization", "subject_secondary": ["Humanities", "History", "World History", "Social Science", "Anthropology", "Cultural Anthropology", "Social Anthropology"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Globalization", "specialties": []}]}, {"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["World History"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology", "Social Anthropology"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "Everyday we are bombarded with the word “global” and encouraged to see globalization as the quintessential transformation of our age. But what exactly does “globalization” mean? How is it affecting the lives of people around the world, not only in economic, but social and cultural terms? How do contemporary changes compare with those from other historical periods? Are such changes positive, negative or simply inevitable? And, finally, how does the concept of the “global” itself shape our perceptions in ways that both help us understand the contemporary world and potentially distort it? This course begins by offering a brief overview of historical “world systems,” including those centered in Asia as well as Europe. It explores the nature of contemporary transformations, including those in economics, media & information technologies, population flows, and consumer habits, not through abstractions but by focusing on the daily lives of people in various parts of the world. This course considers such topics as the day-to-day impact of computers in Silicon Valley and among Tibetan refugees; the dilemmas of factory workers in the US and rural Java; the attractions of Bombay cinema in Nigeria, the making of rap music in Japan, and the cultural complexities of immigrant life in France. This course seeks not only to understand the various forms globalization takes, but to understand its very different impacts world-wide.", "course_url": "https://ocw.mit.edu/courses/21a-336-marketing-microchips-and-mcdonalds-debating-globalization-spring-2004/", "image_url": "https://ocw.mit.edu/courses/21a-336-marketing-microchips-and-mcdonalds-debating-globalization-spring-2004/826361662d16a8ba7a989c6ec1883528_21a-336s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21a-336-spring-2004-course-home", "course_id": "mitocw-21a-336-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21a-336-marketing-microchips-and-mcdonalds-debating-globalization-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-descriptio