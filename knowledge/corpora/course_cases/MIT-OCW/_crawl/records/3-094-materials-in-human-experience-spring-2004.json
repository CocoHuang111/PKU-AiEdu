{"course": {"schema_version": "1.0", "course_id": "mitocw-3-094-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["3.094"], "cross_listed_codes": [], "course_title": "Materials in Human Experience", "course_slug": "3-094-materials-in-human-experience-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Materials Science and Engineering"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Heather Lechtman"], "subject_primary": "Materials Science and Engineering", "subject_secondary": ["Metallurgical Engineering", "Humanities", "History", "Ancient History", "History of Science and Technology"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Materials Science and Engineering", "specialties": ["Metallurgical Engineering"]}]}, {"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["Ancient History", "History of Science and Technology"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": [], "description": "This course examines the ways in which people in ancient and contemporary societies have selected, evaluated, and used materials of nature, transforming them to objects of material culture. Some examples are: glass in ancient Egypt and Rome; sounds and colors of powerful metals in Mesoamerica; cloth and fiber technologies in the Inca empire. It also explores ideological and aesthetic criteria often influential in materials development. Laboratory/workshop sessions provide hands-on experience with materials discussed in class. This course complements 3.091 .", "course_url": "https://ocw.mit.edu/courses/3-094-materials-in-human-experience-spring-2004/", "image_url": "https://ocw.mit.edu/courses/3-094-materials-in-human-experience-spring-2004/9ed466d0dc8efa65776c99a039dd0971_3-094s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativeco