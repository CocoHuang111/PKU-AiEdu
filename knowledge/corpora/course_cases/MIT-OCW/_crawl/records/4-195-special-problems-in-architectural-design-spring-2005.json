{"course": {"schema_version": "1.0", "course_id": "mitocw-4-195-spring-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["4.195"], "cross_listed_codes": [], "course_title": "Special Problems in Architectural Design", "course_slug": "4-195-special-problems-in-architectural-design-spring-2005", "term": "Spring", "year": 2005, "as_taught_in": "Spring 2005", "language": "en", "departments": ["Architecture"], "academic_levels": ["Graduate"], "instructors": ["Prof. Alexandros Tsamis"], "subject_primary": "Computer Science", "subject_secondary": ["Graphics and Visualization", "Fine Arts", "Architecture", "Architectural Design", "Media Studies", "Digital Media"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Graphics and Visualization"]}]}, {"name": "Fine Arts", "subtopics": [{"name": "Architecture", "specialties": ["Architectural Design"]}, {"name": "Media Studies", "specialties": ["Digital Media"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Projects with Examples"], "description": "This class focuses on representation tools used by architects during the design process and attempts to discuss the relationship they develop with the object of design. Representation plays a key role in architectural design, not only as a medium of conveying and narrating a determined meaning or a preconceived idea, but also as a code of creating new meaning, while the medium seeks to establish a relationship with itself. In this sense, mediums of representation, as external parameters to the design process, are not neutral tools of translating an idea into its concrete form. They are neither authentic means of creativity, nor vapid carriers of an idea. Therefore, an important aspect in issues of meaning is how the architect manipulates the play of translating a concept to its concrete version, through the use of a medium of representation. The course is a continuation of the equivalent course taught in the fall semester and specifically focuses on digital media. The course is intended to establish a reciprocal relationship with the design studio, feeding from and contributing to its content.", "course_url": "https://ocw.mit.edu/courses/4-195-special-problems-in-architectural-design-spring-2005/", "image_url": "https://ocw.mit.edu/courses/4-195-special-problems-in-architectural-design-spring-2005/b2f466b270f328d10f359e8fb2a0661b_4-195s05.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-4-195-spring-2005-course-home", "course_id": "mitocw-4-195-spring-2005", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/4-195-special-problems-in-architectural-design-spring-2005/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "f796d4c3ca97839e65fb443bad277fe5056a1e4d7aeaec872254254f97e7c1ae", "error": null}, {"resource_id": "mitocw-4-195-spring-2005-syllabus", "course_id": "mitocw-4-195-spring-2005", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/4-195-special-problems-in-architectural-design-spring-2005/pages/syllabus/", "source_format": "html", "availability": "available",