{"course": {"schema_version": "1.0", "course_id": "mitocw-res-14-001-spring-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.14-001"], "cross_listed_codes": [], "course_title": "Abdul Latif Jameel Poverty Action Lab Executive Training: Evaluating Social Programs 2009", "course_slug": "res-14-001-abdul-latif-jameel-poverty-action-lab-executive-training-evaluating-social-programs-2009-spring-2009", "term": "Spring", "year": 2009, "as_taught_in": "Spring 2009", "language": "en", "departments": ["Economics"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Esther Duflo", "Rachel Glennerster", "Prof. Abhijit Banerjee"], "subject_primary": "Economics", "subject_secondary": ["Developmental Economics", "Public Administration", "Public Policy", "Social Welfare", "Society", "Global Poverty", "The Developing World"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["Developmental Economics"]}, {"name": "Public Administration", "specialties": ["Public Policy", "Social Welfare"]}]}, {"name": "Society", "subtopics": [{"name": "Global Poverty", "specialties": []}, {"name": "The Developing World", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments", "Lecture Notes", "Lecture Videos"], "description": "This five-day program on evaluating social programs will provide a thorough understanding of randomized evaluations and pragmatic step-by-step training for conducting one’s own evaluation. While the course focuses on randomized evaluations, many of the topics, such as measuring outcomes and dealing with threats to the validity of an evaluation, are relevant for other methodologies. About the Abdul Latif Jameel Poverty Action Lab J-PAL’s goal is to reduce poverty by ensuring that policy is based on scientific evidence. Every day, evidence generated by J-PAL researchers is influencing policy and improving lives, sometimes very directly – for example through the scale-up of effective programs – but also in less direct but equally important ways. To date, our evidence has helped improve the lives of at least 30 million people around the world through the scale-up of highly effective policies and programs. By 2013, J-PAL aims to have positively impacted 100 million lives.", "course_url": "https://ocw.mit.edu/courses/res-14-001-abdul-latif-jameel-poverty-action-lab-executive-training-evaluating-social-programs-2009-spring-2009/", "image_url": "https://ocw.mit.edu/courses/res-14-001-abdul-latif-jameel-poverty-action-lab-executive-training-evaluating-social-programs-2009-spring-2009/698b16c21d0b79fca069d623e89dde8e_res-14-001s09.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-res-14-001-spring-2009-course-home", "course_id": "mitocw-res-14-001-spring-2009", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/res-14-001-abdul-latif-jameel-poverty-action-lab-executive-training-evaluating-social-programs-2009-spring-2009/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "6216124be9cea16da834e39f22ecdec41c884d00aad59b7c063faa208a0932c6", "error": null}, {"resource_id": "mit