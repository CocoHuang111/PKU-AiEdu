{"course": {"schema_version": "1.0", "course_id": "mitocw-15-311-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.311"], "cross_listed_codes": [], "course_title": "Organizational Processes", "course_slug": "15-311-organizational-processes-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Sloan School of Management"], "academic_levels": ["Graduate"], "instructors": ["Prof. John Van Maanen", "Prof. Paul Carlile", "Prof. Roberto Fernandez"], "subject_primary": "Leadership", "subject_secondary": ["Management", "Organizational Behavior"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Leadership", "specialties": []}, {"name": "Management", "specialties": []}, {"name": "Organizational Behavior", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "Organizational Processes enhances students’ ability to take effective action in complex organizational settings by providing the analytic tools needed to analyze, manage, and lead the organizations of the future. Emphasis is placed on the importance of the organizational context in influencing which individual styles and skills are effective. The subject centers on three complementary perspectives, or “lenses”, on an organization: political, cultural, and strategic design. Students enrolled in this class are also jointly enrolled in 15.328 , Team Project, in order to complete a field study of an organizational change initiative. Organizational Processes also operates in conjunction with 15.280, Communication for Managers, by sharing certain assignments and holding some joint classes.", "course_url": "https://ocw.mit.edu/courses/15-311-organizational-processes-fall-2003/", "image_url": "https://ocw.mit.edu/courses/15-311-organizational-processes-fall-2003/ec142bf992f660fb52027abeefb86161_15