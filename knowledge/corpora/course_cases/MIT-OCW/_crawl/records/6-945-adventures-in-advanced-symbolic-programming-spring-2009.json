{"course": {"schema_version": "1.0", "course_id": "mitocw-6-945-spring-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.945"], "cross_listed_codes": [], "course_title": "Adventures in Advanced Symbolic Programming", "course_slug": "6-945-adventures-in-advanced-symbolic-programming-spring-2009", "term": "Spring", "year": 2009, "as_taught_in": "Spring 2009", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Gerald Sussman"], "subject_primary": "Computer Science", "subject_secondary": ["Artificial Intelligence", "Programming Languages", "Software Design and Engineering"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Artificial Intelligence", "Programming Languages", "Software Design and Engineering"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Problem Sets", "Projects"], "description": "This course covers concepts and techniques for the design and implementation of large software systems that can be adapted to uses not anticipated by the designer. Applications include compilers, computer-algebra systems, deductive systems, and some artificial intelligence applications. Topics include combinators, generic operations, pattern matching, pattern-directed invocation, rule systems, backtracking, dependencies, indeterminacy, memoization, constraint propagation, and incremental refinement. Substantial weekly programming assignments are an integral part of the subject. There will be extensive programming assignments, using MIT/GNU Scheme . Students should have significant programming experience in Scheme, Common Lisp, Haskell, CAML or some other “functional” language.", "course_url": "https://ocw.mit.edu/courses/6-945-adventures-in-advanced-symbolic-programming-spring-2009/", "image_url": "https://ocw.mit.edu/courses/6-