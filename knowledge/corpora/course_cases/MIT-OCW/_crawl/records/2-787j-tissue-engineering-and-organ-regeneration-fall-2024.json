{"course": {"schema_version": "1.0", "course_id": "mitocw-2-787j-fall-2024", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["2.787J"], "cross_listed_codes": ["HST.535J"], "course_title": "Tissue Engineering and Organ Regeneration", "course_slug": "2-787j-tissue-engineering-and-organ-regeneration-fall-2024", "term": "Fall", "year": 2024, "as_taught_in": "Fall 2024", "language": "en", "departments": ["Mechanical Engineering", "Health Sciences and Technology"], "academic_levels": ["Graduate"], "instructors": ["Prof. Myron Spector", "Prof. Ioannis Yannas"], "subject_primary": "Biological Engineering", "subject_secondary": ["Biomaterials", "Biomechanics", "Cell and Tissue Engineering", "Materials Science and Engineering", "Mechanical Engineering", "Health and Medicine", "Anatomy and Physiology", "Science", "Biology", "Biophysics", "Cell Biology", "Developmental Biology"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Biological Engineering", "specialties": ["Biomaterials", "Biomechanics", "Cell and Tissue Engineering"]}, {"name": "Materials Science and Engineering", "specialties": []}, {"name": "Mechanical Engineering", "specialties": []}]}, {"name": "Health and Medicine", "subtopics": [{"name": "Anatomy and Physiology", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Biology", "specialties": ["Biophysics", "Cell Biology", "Developmental Biology"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Lecture Videos", "Readings"], "description": "This course presents the fundamentals of tissue engineering (TE) and organ regeneration (OR). Emphasis is on clinical translation and the development of workable medical devices. Topics include factors that prevent the spontaneous regeneration of tissues/organs in the adult (following traumatic injury, surgical excision, disease, and aging), and the cellular and molecular mechanisms that can identify the agents to employ therapeutically to enable induced regeneration. A principal focus is the assessment of the criteria that need to be met by biomaterials to deliver these agents and to fill defects. The course presents the principles underlying strategies for employing select biomaterial scaffolds, exogenous cells, and soluble regulators for the formation of tissue in vitro (TE) and regeneration of tissues/organs in vivo (regenerative medicine / OR). The course describes the methodologies for producing biomaterial scaffolds to accommodate the infiltration of endogenous cells (e.g., for the treatment of stroke) and for delivering cells and regulatory molecules (e.g., for the treatment of blindness). Examples of clinical successes and failures of regenerative devices are analyzed as case studies.", "course_url": "https://ocw.mit.edu/courses/2-787j-tissue-engineering-and-organ-regeneration-fall-2024/", "image_url": "https://ocw.mit.edu/courses/2-787j-tissue-engineering-and-organ-regeneration-fall-2024/mit2_787j_f24.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": true, "assignments": false, "projects": false, "exams": false, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-2-787j-fall-2024-course-home", "course_id": "mitocw-2-787j-fall-2024", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/2-787j-tissue-engineering-and-organ-regeneration-fall-2024/", "source_format": "html", "availability": "available", "extraction_policy": "full_tex