actice, and reflect on insights gained in the process. Our hope is that student work will contribute to new initiatives in both communities. The class Web site can be found here: Media Technology and City Design and Development . It is sponsored by the West Philadelphia Landscape Project and the Center for Reflective Community Practice.", "course_url": "https://ocw.mit.edu/courses/11-310j-media-technology-and-city-design-and-development-spring-2002/", "image_url": "https://ocw.mit.edu/courses/11-310j-media-technology-and-city-design-and-development-spring-2002/c4b99edfe6632fead219df9565121858_11-310js02.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-310j-spring-2002-course-home", "course_id": "mitocw-11-310j-spring-2002", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-310j-media-technology-and-city-design-and-development-spring-2002/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "2f6bc5d9b96d42bc54b5dae4954959c18f7d1aad0d8258d1f6acc848b2d983a8", "error": null}, {"resource_id": "mitocw-11-310j-spring-2002-syllabus", "course_id": "mitocw-11-310j-spring-2002", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/11-310j-media-technolog