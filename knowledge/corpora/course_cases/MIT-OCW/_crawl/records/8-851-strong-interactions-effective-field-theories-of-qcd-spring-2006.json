{"course": {"schema_version": "1.0", "course_id": "mitocw-8-851-spring-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["8.851"], "cross_listed_codes": [], "course_title": "Strong Interactions: Effective Field Theories of QCD", "course_slug": "8-851-strong-interactions-effective-field-theories-of-qcd-spring-2006", "term": "Spring", "year": 2006, "as_taught_in": "Spring 2006", "language": "en", "departments": ["Physics"], "academic_levels": ["Graduate"], "instructors": ["Prof. Iain Stewart"], "subject_primary": "Physics", "subject_secondary": ["Particle Physics", "Quantum Mechanics", "Theoretical Physics"], "topic_tree": [{"name": "Science", "subtopics": [{"name": "Physics", "specialties": ["Particle Physics", "Quantum Mechanics", "Theoretical Physics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets"], "description": "This is a course in the construction and application of effective field theories, which are the modern tool of choice in making predictions based on the Standard Model. Concepts such as matching, renormalization, the operator product expansion, power counting, and running with the renormalization group will be discussed. Topics will be taken from factorization in hard processes relevant for the LHC, heavy quark decays and CP violation, chiral perturbation theory, non-relativistic bound states in field theory (QED and QCD), nucleon effective theories with a fine-tuning, and possibly other subjects from QCD, electroweak physics, and gravity.", "course_url": "https://ocw.mit.edu/courses/8-851-strong-interactions-effective-field-theories-of-qcd-spring-2006/", "image_url": "https://ocw.mit.edu/courses/8-851-strong-interactions-effective-field-theories-of-qcd-spring-2006/023795e672850a64515555458cdf6bb7_8-851s06.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0