{"course": {"schema_version": "1.0", "course_id": "mitocw-11-469-spring-2016", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.469"], "cross_listed_codes": [], "course_title": "Urban Sociology in Theory and Practice", "course_slug": "11-469-urban-sociology-in-theory-and-practice-spring-2016", "term": "Spring", "year": 2016, "as_taught_in": "Spring 2016", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Justin Steil", "Aditi Mehta"], "subject_primary": "Sociology", "subject_secondary": ["Social Justice", "Urban Studies", "Urban Planning"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Sociology", "specialties": ["Social Justice"]}, {"name": "Urban Studies", "specialties": ["Urban Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Instructor Insights", "Presentation Assignments"], "description": "This course explores the creative dialectic—and sometimes conflict—between sociology and urban policy and design. Topics include the changing conceptions of “community,” the effects of neighborhood characteristics on individual outcomes, the significance of social capital and networks, the drivers of categorical inequality, and the interaction of social structure and political power. Students will examine key theoretical paradigms that have constituted sociology since its founding, assess how and why they have changed over time, and discuss the implications of these shifts for urban research and planning practice. This seminar took place at the Massachusetts Correctional Institution in Norfolk, MA, with half the class from MIT and half of the class from MCI Norfolk via the Boston University Prison Education Program. The location and composition of the class was chosen based on the belief that bringing together students of sociology and urban studies who are incarcerated with those who are at MIT would create a unique and valuable environment in which to generate new knowledge about our social world and the repeated mechanisms that contribute to persistent socio-economic inequality and other pressing social problems.", "course_url": "https://ocw.mit.edu/courses/11-469-urban-sociology-in-theory-and-practice-spring-2016/", "image_url": "https://ocw.mit.edu/courses/11-469-urban-sociology-in-theory-and-practice-spring-2016/3531d60ea44b4fa33f4c08adb5916038_11-469s16.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": true, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-469-spring-2016-course-home", "course_id": "mitocw-11-469-spring-2016", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-469-urban-sociology-in-theory-and-practice-spring-2016/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "ca6eec385f16f14956335259f572afb2151a6ae8755d2a2c9fa09101da27c7db", "error": null}, {"resource_id": "mitocw-11-469-spring-2016-syllabus", "course_id": "mitocw-11-469-spring-2016", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/11-469-urban-sociology-in-theory-and-practice-spring-2016/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_poli