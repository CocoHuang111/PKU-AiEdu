{"course": {"schema_version": "1.0", "course_id": "mitocw-11-167-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.167"], "cross_listed_codes": [], "course_title": "Economic Development & Technical Capabilities", "course_slug": "11-167-economic-development-technical-capabilities-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Alice Amsden"], "subject_primary": "Economics", "subject_secondary": ["Developmental Economics", "International Development", "Public Administration", "Science and Technology Policy"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["Developmental Economics", "International Development"]}, {"name": "Public Administration", "specialties": ["Science and Technology Policy"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes"], "description": "The economic growth of developing countries requires the acquisition of technological capabilities. In countries at the world technological frontier, such capabilities refer to cutting edge skills to innovate entirely new products. In developing countries, the requisite technological capabilities are broader, and include production engineering, project execution and incremental innovation to make borrowed technology work. Theories of technology acquisition are examined. The empirical evidence is taken from two sets of developing countries; the most advanced (Taiwan, Korea, India, China and Brazil) and the least advanced (Africa and Middle Eastern countries).", "course_url": "https://ocw.mit.edu/courses/11-167-economic-development-technical-capabilities-spring-2004/", "image_url": "https://ocw.mit.edu/courses/11-167-economic-development-technical-capabilities-spring-2004/8455723eb