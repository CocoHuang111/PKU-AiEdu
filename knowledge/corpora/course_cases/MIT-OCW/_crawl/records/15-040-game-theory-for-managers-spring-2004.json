{"course": {"schema_version": "1.0", "course_id": "mitocw-15-040-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.040"], "cross_listed_codes": [], "course_title": "Game Theory for Managers", "course_slug": "15-040-game-theory-for-managers-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Sloan School of Management"], "academic_levels": ["Graduate"], "instructors": ["Prof. David McAdams"], "subject_primary": "Management", "subject_secondary": ["Organizational Behavior", "Social Science", "Game Theory"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Management", "specialties": []}, {"name": "Organizational Behavior", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Game Theory", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exam Solutions", "Exams", "Lecture Notes", "Problem Sets", "Written Assignments"], "description": "This half-term course examines the choices that we make which affect others and the choices others make that affect us. Such situations are known as “games” and game-playing, while sounding whimsical, is serious business. Managers frequently play “games” both within the firm and outside it – with competitors, customers, regulators, and even capital markets! The goal of this course is to enhance a student’s ability to think strategically in complex, interactive environments. Knowledge of game theory will give students an advantage in such strategic settings. The course is structured around three “themes for acquiring advantage in games”: commitment / strategic moves, exploiting hidden information, and limited rationality.", "course_url": "https://ocw.mit.edu/courses/15-040-game-theory-for-managers-spring-2004/", "image_url": "https://ocw.mit.edu/courses/15-040-game-theory-for-managers-spring-2004/db0ad91ebb14437