{"course": {"schema_version": "1.0", "course_id": "mitocw-18-s66-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["18.S66"], "cross_listed_codes": [], "course_title": "The Art of Counting", "course_slug": "18-s66-the-art-of-counting-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Mathematics"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Richard Stanley"], "subject_primary": "Algebra and Number Theory", "subject_secondary": [], "topic_tree": [{"name": "Mathematics", "subtopics": [{"name": "Algebra and Number Theory", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Problem Sets"], "description": "The subject of enumerative combinatorics deals with counting the number of elements of a finite set. For instance, the number of ways to write a positive integer n as a sum of positive integers, taking order into account, is 2 n-1 . We will be concerned primarily with bijective proofs , i.e., showing that two sets have the same number of elements by exhibiting a bijection (one-to-one correspondence) between them. This is a subject which requires little mathematical background to reach the frontiers of current research. Students will therefore have the opportunity to do original research. It might be necessary to limit enrollment.", "course_url": "https://ocw.mit.edu/courses/18-s66-the-art-of-counting-spring-2003/", "image_url": "https://ocw.mit.edu/courses/18-s66-the-art-of-counting-spring-2003/4bbe9c55a2b30dac463c4a6eeb779389_18-s66s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": f