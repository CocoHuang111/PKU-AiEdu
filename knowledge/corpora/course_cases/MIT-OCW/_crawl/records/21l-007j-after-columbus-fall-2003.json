{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-007j-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.007J"], "cross_listed_codes": ["21G.020J"], "course_title": "After Columbus", "course_slug": "21l-007j-after-columbus-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Literature", "Global Studies and Languages"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Mary Fuller"], "subject_primary": "Literature", "subject_secondary": ["American Literature", "Comparative Literature", "International Literature"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["American Literature", "Comparative Literature", "International Literature"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Presentation Assignments", "Written Assignments"], "description": "Sometime after 1492, the concept of the New World or America came into being, and this concept appeared differently - as an experience or an idea - for different people and in different places. This semester, we will read three groups of texts: first, participant accounts of contact between native Americans and French or English speaking Europeans, both in North America and in the Caribbean and Brazil; second, transformations of these documents into literary works by contemporaries; third, modern texts which take these earlier materials as a point of departure for rethinking the experience and aftermath of contact. The reading will allow us to compare perspectives across time and space, across the cultural geographies of religion, nation and ethnicity, and finally across a range of genres - reports, captivity narratives, essays, novels, poetry, drama, and film. Some of the earlier authors we will read are Michel Montaigne, William Shakespeare, Jean de Léry, Daniel Defoe and Mary Rowlandson; more recent authors include Derek Walcott, and J. M. Coetzee.", "course_url": "https://ocw.mit.edu/courses/21l-007j-after-columbus-fall-2003/", "image_url": "https://ocw.mit.edu/courses/21l-007j-after-columbus-fall-2003/0b333315674ad9126629b0b0ea08b224_21l-007jf03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-007j-fall-2003-course-home", "course_id": "mitocw-21l-007j-fall-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-007j-after-columbus-fall-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "0f3d09bc62bee887d72bb129bfb822c465be57ff10f04662e282550ae0302e64", "error": null}, {"resource_id": "mitocw-21l-007j-fall-2003-syllabus", "course_id": "mitocw-21l-007j-fall-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/21l-007j-after-columbus-fall-2003/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "95fe4d736f3999dd2080a49909450ccf6efba0318a73981b217b24774de813c6", "error": null}, {"resource_id": "mitocw-21l-007j-fall-2003-calendar", "course_id"