{"course": {"schema_version": "1.0", "course_id": "mitocw-21g-067j-fall-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21G.067J"], "cross_listed_codes": ["WGS.608J"], "course_title": "Cultural Performances of Asia", "course_slug": "21g-067j-cultural-performances-of-asia-fall-2005", "term": "Fall", "year": 2005, "as_taught_in": "Fall 2005", "language": "en", "departments": ["Global Studies and Languages", "Women's and Gender Studies"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Ian Condry"], "subject_primary": "Media Studies", "subject_secondary": ["Performance Arts", "Social Science", "Anthropology", "Cultural Anthropology", "Society", "Asian Studies"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Media Studies", "specialties": []}, {"name": "Performance Arts", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}]}, {"name": "Society", "subtopics": [{"name": "Asian Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments with Examples", "Lecture Notes", "Written Assignments"], "description": "This course examines cultural performances of Asia, including both traditional and contemporary forms, in a variety of genres. Students will explore the communicative power of performances with attention to the ways performers, media, cultural settings, and audiences interact. The representation of cultural difference is considered and how it is altered through processes of globalization. Performances are viewed live when possible, but the course also relies on video, audio, and online materials as necessary. There are no prerequisites for this course and it is taught in English.", "course_url": "https://ocw.mit.edu/courses/21g-067j-cultural-performances-of-asia-fall-2005/", "image_url": "https://ocw.mit.edu/course