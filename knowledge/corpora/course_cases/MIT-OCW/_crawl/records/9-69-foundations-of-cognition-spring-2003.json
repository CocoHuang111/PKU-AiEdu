{"course": {"schema_version": "1.0", "course_id": "mitocw-9-69-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["9.69"], "cross_listed_codes": [], "course_title": "Foundations of Cognition", "course_slug": "9-69-foundations-of-cognition-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Brain and Cognitive Sciences"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Josh Tenenbaum", "Prof. Lera Boroditsky"], "subject_primary": "Philosophy", "subject_secondary": ["Science", "Cognitive Science", "Social Science", "Psychology"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Philosophy", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Cognitive Science", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Psychology", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments"], "description": "Advances in cognitive science have resolved, clarified, and sometimes complicated some of the great questions of Western philosophy: what is the structure of the world and how do we come to know it; does everyone represent the world the same way; what is the best way for us to act in the world. Specific topics include color, objects, number, categories, similarity, inductive inference, space, time, causality, reasoning, decision-making, morality and consciousness. Readings and discussion include a brief philosophical history of each topic and focus on advances in cognitive and developmental psychology, computation, neuroscience, and related fields. At least one subject in cognitive science, psychology, philosophy, linguistics, or artificial intelligence is required. An additional project is required for graduate credit.", "course_url": "https://ocw.mit.edu/courses/9-69-foundations-of-cognition-spring-2003/",