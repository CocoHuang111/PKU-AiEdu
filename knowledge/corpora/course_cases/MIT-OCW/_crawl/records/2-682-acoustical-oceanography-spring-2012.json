{"course": {"schema_version": "1.0", "course_id": "mitocw-2-682-spring-2012", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["2.682"], "cross_listed_codes": [], "course_title": "Acoustical Oceanography", "course_slug": "2-682-acoustical-oceanography-spring-2012", "term": "Spring", "year": 2012, "as_taught_in": "Spring 2012", "language": "en", "departments": ["Mechanical Engineering"], "academic_levels": ["Graduate"], "instructors": ["James Lynch"], "subject_primary": "Ocean Engineering", "subject_secondary": ["Science", "Earth Science", "Oceanography", "Physics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Ocean Engineering", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Earth Science", "specialties": ["Oceanography"]}, {"name": "Physics", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets"], "description": "This course will begin with brief overview of what important current research topics are in oceanography (physical, geological, and biological) and how acoustics can be used as a tool to address them. Three typical examples are climate, bottom geology, and marine mammal behavior. Will then address the acoustic inverse problem, reviewing inverse methods (linear and nonlinear) and the combination of acoustical methods with other measurements as an integrated system. Last part of course will concentrate on specific case studies, taken from current research journals. This course is taught on campus at MIT and with simultaneous video at Woods Hole Oceanographic Institution.", "course_url": "https://ocw.mit.edu/courses/2-682-acoustical-oceanography-spring-2012/", "image_url": "https://ocw.mit.edu/courses/2-682-acoustical-oceanography-spring-2012/3e921d8674aea039073766c1e2801db4_2-682s12.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/license