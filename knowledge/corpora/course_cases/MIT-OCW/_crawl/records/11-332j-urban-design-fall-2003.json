{"course": {"schema_version": "1.0", "course_id": "mitocw-11-332j-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.332J"], "cross_listed_codes": ["4.163J"], "course_title": "Urban Design", "course_slug": "11-332j-urban-design-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Urban Studies and Planning", "Architecture"], "academic_levels": ["Graduate"], "instructors": ["Prof. Carol Burns", "Prof. John de Monchaux"], "subject_primary": "Architecture", "subject_secondary": ["Environmental Design", "Social Science", "Urban Studies", "Urban Planning"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Architecture", "specialties": ["Environmental Design"]}]}, {"name": "Social Science", "subtopics": [{"name": "Urban Studies", "specialties": ["Urban Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Design Assignments", "Written Assignments"], "description": "For many years, Cambridge, MA, as host to two major research universities, has been the scene of debates as to how best to meet the competing expectations of different stakeholders. Where there has been success, it has frequently been the result, at least in part, of inventive urban design proposals and the design and implementation of new institutional arrangements to accomplish those proposals. Where there has been failure it has often been explained by the inability - or unwillingness - of one stakeholder to accept and accommodate the expectations of another. The two most recent fall Urban Design Studios have examined these issues at a larger scale. In 2001 we looked at the possible patterns for growth and change in Cambridge, UK, as triggered by the plans of Cambridge University. And in 2002 we looked at these same issues along the length of the MIT ‘frontier’ in Cambridge, MA as they related to the development of MIT and the biotech research industry. In the fall 2003 Urban Design Studio we propose to focus in on an area adjacent to Cambridgeport and the western end of the MIT campus, roughly centered on Fort Washington. Our goal is to discover the ways in which good urban form, an apt mix of activities, and effective institutional mechanisms might all be brought together in ways that respect shared expectations and reconcile competing expectations - perhaps in unexpected and adroit ways.", "course_url": "https://ocw.mit.edu/courses/11-332j-urban-design-fall-2003/", "image_url": "https://ocw.mit.edu/courses/11-332j-urban-design-fall-2003/3d11876b69713b2025b7012502f9c06a_11-332jf03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-332j-fall-2003-course-home", "course_id": "mitocw-11-332j-fall-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-332j-urban-design-fall-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "089799f36b611642ed4aa2da49caebdb6e755d3d4b1e9ce686d7dee6d7a564fd", "error": null}, {"resource_id": "mitocw-11-332j-fall-2003-syllabus", "course_id": "mitocw-11-332j-fall-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/11-3