{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-470-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.470"], "cross_listed_codes": [], "course_title": "Eighteenth-Century Literature: Versions of the Self in 18th-C Britain", "course_slug": "21l-470-eighteenth-century-literature-versions-of-the-self-in-18th-c-britain-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Literature"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Noel Jackson"], "subject_primary": "History", "subject_secondary": ["European History", "Intellectual History", "Literature", "Philosophy", "Metaphysics"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["European History", "Intellectual History"]}, {"name": "Literature", "specialties": []}, {"name": "Philosophy", "specialties": ["Metaphysics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "When John Locke declared (in the 1690 Essay Concerning Human Understanding) that knowledge was derived solely from experience, he raised the possibility that human understanding and identity were not the products of God’s will or of immutable laws of nature so much as of one’s personal history and background. If on the one hand Locke’s theory led some to pronounce that individuals could determine the course of their own lives, however, the idea that we are the products of our experience just as readily supported the conviction that we are nothing more than machines acting out lives whose destinies we do not control. This course will track the formulation of that problem, and a variety of responses to it, in the literature of the “long eighteenth century.” Readings will range widely across genre, from lyric poetry and the novel to diary entries, philosophical prose, and political essays, including texts by Alexander Pope, Jonathan Swift, Mary Astell, David Hume, Laurence Sterne, Olaudah Equiano, Mary Hays, and Mary Shelley. Topics to be discussed include the construction of gender identities; the individual in society; imagination and the poet’s work. There will be two essays, one 5-6 pages and one 8-10 pages in length, and required presentations.", "course_url": "https://ocw.mit.edu/courses/21l-470-eighteenth-century-literature-versions-of-the-self-in-18th-c-britain-spring-2003/", "image_url": "https://ocw.mit.edu/courses/21l-470-eighteenth-century-literature-versions-of-the-self-in-18th-c-britain-spring-2003/79081b2c4b6ba7ccac26e1bffc91daa4_21l-470s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-470-spring-2003-course-home", "course_id": "mitocw-21l-470-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-470-eighteenth-century-literature-versions-of-the-self-in-18th-c-britain-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "a239b6cdcda1b84c909392a4be308576774c80b7308a946e3a6a4892053600c4", "error": null}, {"resource_id": "mitocw-21l-470-spring-2003-syllabus", "course_id": "mitocw-21l-470-spring-2003", "resource_type": 