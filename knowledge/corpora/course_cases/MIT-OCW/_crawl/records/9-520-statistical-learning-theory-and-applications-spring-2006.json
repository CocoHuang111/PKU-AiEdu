{"course": {"schema_version": "1.0", "course_id": "mitocw-9-520-spring-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["9.520"], "cross_listed_codes": [], "course_title": "Statistical Learning Theory and Applications", "course_slug": "9-520-statistical-learning-theory-and-applications-spring-2006", "term": "Spring", "year": 2006, "as_taught_in": "Spring 2006", "language": "en", "departments": ["Brain and Cognitive Sciences"], "academic_levels": ["Graduate"], "instructors": ["Prof. Tomaso Poggio"], "subject_primary": "Probability and Statistics", "subject_secondary": ["Science", "Biology", "Computation and Systems Biology", "Neuroscience", "Cognitive Science"], "topic_tree": [{"name": "Mathematics", "subtopics": [{"name": "Probability and Statistics", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Biology", "specialties": ["Computation and Systems Biology", "Neuroscience"]}, {"name": "Cognitive Science", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets"], "description": "This course is for upper-level graduate students who are planning careers in computational neuroscience. This course focuses on the problem of supervised learning from the perspective of modern statistical learning theory starting with the theory of multivariate function approximation from sparse data. It develops basic tools such as Regularization including Support Vector Machines for regression and classification. It derives generalization bounds using both stability and VC theory. It also discusses topics such as boosting and feature selection and examines applications in several areas: Computer Vision, Computer Graphics, Text Classification, and Bioinformatics. The final projects, hands-on applications, and exercises are designed to illustrate the rapidly increasing practical uses of the techniques described throughout