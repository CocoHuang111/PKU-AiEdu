{"course": {"schema_version": "1.0", "course_id": "mitocw-ec-721-spring-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["EC.721"], "cross_listed_codes": [], "course_title": "Wheelchair Design in Developing Countries", "course_slug": "ec-721-wheelchair-design-in-developing-countries-spring-2009", "term": "Spring", "year": 2009, "as_taught_in": "Spring 2009", "language": "en", "departments": ["Edgerton Center"], "academic_levels": ["Undergraduate"], "instructors": ["Mr. Amos G. Winter", "Amy J. Smith"], "subject_primary": "Mechanical Engineering", "subject_secondary": ["Mechanical Design", "Health and Medicine", "Public Health", "Society", "The Developing World"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Mechanical Engineering", "specialties": ["Mechanical Design"]}]}, {"name": "Health and Medicine", "subtopics": [{"name": "Public Health", "specialties": []}]}, {"name": "Society", "subtopics": [{"name": "The Developing World", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Demonstration Videos", "Image Gallery", "Lecture Notes", "Projects with Examples"], "description": "According to the United States Agency for International Development , 20 million people in developing countries require wheelchairs, and the United Nations Development Programme estimates below 1% of their need is being met in Africa by local production. Wheelchair Design in Developing Countries (WDDC) gives students the chance to better the lives of others by improving wheelchairs and tricycles made in the developing world. Lectures will focus on understanding local factors, such as operating environments, social stigmas against the disabled, and manufacturing constraints, and then applying sound scientific/engineering knowledge to develop appropriate technical solutions. Multidisciplinary student teams will conduct term-long projects on topics such as hardware design, manufacturing optimization, biomechanics modeling, and business plan development. Theory will further be connected to real-world implementation during guest lectures by MIT faculty, Third-World community partners, and U.S. wheelchair organizations. This class is made possible by an MIT Alumni Sponsored Funding Opportunities grant with additional support from the National Collegiate Inventors and Innovators Alliance (now VentureWell) , the MIT Public Service Center , and the MIT Edgerton Center ; special thanks to CustomInk.com .", "course_url": "https://ocw.mit.edu/courses/ec-721-wheelchair-design-in-developing-countries-spring-2009/", "image_url": "https://ocw.mit.edu/courses/ec-721-wheelchair-design-in-developing-countries-spring-2009/55fff7754f6f0eee9d0bfd757a9b32ff_ec-721s09.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": true, "lecture_notes": true, "assignments": false, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-ec-721-spring-2009-course-home", "course_id": "mitocw-ec-721-spring-2009", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/ec-721-wheelchair-design-in-developing-countries-spring-2009/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "99399ed9adc08d340ab6917b1ba797dd3e21e7fae6a10ea021bebae25c4e58bc", "error": null}, {"resource_id": "mitocw-ec-72