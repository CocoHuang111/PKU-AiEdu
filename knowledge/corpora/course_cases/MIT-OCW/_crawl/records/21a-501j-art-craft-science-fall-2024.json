{"course": {"schema_version": "1.0", "course_id": "mitocw-21a-501j-fall-2024", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21A.501J"], "cross_listed_codes": ["STS.074J"], "course_title": "Art, Craft, Science", "course_slug": "21a-501j-art-craft-science-fall-2024", "term": "Fall", "year": 2024, "as_taught_in": "Fall 2024", "language": "en", "departments": ["Anthropology", "Science, Technology, and Society"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Franco Rossi"], "subject_primary": "Visual Arts", "subject_secondary": ["Social Science", "Anthropology", "Cultural Anthropology"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Visual Arts", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments with Examples", "Readings", "Student Work", "Written Assignments with Examples"], "description": "This course examines how people learn, practice, and evaluate traditional and contemporary craft techniques. Social science theories of design, embodiment, apprenticeship learning, skill, labor, expertise, and tacit knowledge are used to explore distinctions among art, craft, and science. It also discusses the commoditization of craft into market goods, collectible art, and tourism industries. Ethnographic and historical case studies include textiles, Shaker furniture, glassblowing, quilting, cheesemaking, industrial design, home and professional cooking, factory and laboratory work, and CAD/CAM. Demonstrations, optional field trips, and/or hands-on craft projects may be included.", "course_url": "https://ocw.mit.edu/courses/21a-501j-art-craft-science-fall-2024/", "image_url": "https://ocw.mit.edu/courses/21a-501j-art-craft-science-fall-2024/mit21a_501j_f24.jpg", "license_name": "CC BY-NC-SA 4.0", "li