ons, and many kinds of cultural productions. The Graduate Consortium in Women’s Studies (GCWS) This course is part of the Graduate Consortium in Women’s Studies. The GCWS at MIT brings together scholars and teachers at nine degree-granting institutions in the Boston area who are devoted to graduate teaching and research in Women’s Studies and to advancing interdisciplinary Women’s Studies scholarship. Learn more about the GCWS .", "course_url": "https://ocw.mit.edu/courses/wgs-640-gender-race-and-the-construction-of-the-american-west-fall-2014/", "image_url": "https://ocw.mit.edu/courses/wgs-640-gender-race-and-the-construction-of-the-american-west-fall-2014/d392f4045081e3c96f560c743570e602_wgs-640f14.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": true, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-wgs-640-fall-2014-course-home", "course_id": "mitocw-wgs-640-fall-2014", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/wgs-640-gender-race-and-the-construction-of-the-american-west-fall-2014/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "a8039f2089db41561d45fb0f66fa2a2007c0803315a9ca3841ffedd83575f681", "error": null}, {"resource_id": "mitocw-wgs-640-fall-2014-syllabus", "course_id": "mitocw-wgs-640-fall-2014", "resource_type": "syllabus",