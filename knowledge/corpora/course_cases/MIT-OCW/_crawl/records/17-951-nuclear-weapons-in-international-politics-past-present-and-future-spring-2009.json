{"course": {"schema_version": "1.0", "course_id": "mitocw-17-951-spring-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["17.951"], "cross_listed_codes": [], "course_title": "Nuclear Weapons in International Politics: Past, Present and Future", "course_slug": "17-951-nuclear-weapons-in-international-politics-past-present-and-future-spring-2009", "term": "Spring", "year": 2009, "as_taught_in": "Spring 2009", "language": "en", "departments": ["Political Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Owen Cote", "Dr. James Walsh"], "subject_primary": "History", "subject_secondary": ["Military History", "Social Science", "Political Science", "International Relations", "Public Administration", "Military Studies", "Security Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["Military History"]}]}, {"name": "Social Science", "subtopics": [{"name": "Political Science", "specialties": ["International Relations"]}, {"name": "Public Administration", "specialties": ["Military Studies", "Security Studies"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Projects"], "description": "This course will expose students to tools and methods of analysis for use in assessing the challenges and dangers associated with nuclear weapons in international politics. The first two weeks of the course will look at the technology and design of nuclear weapons and their means of production. The next five weeks will look at the role they played in the Cold War, the organizations that managed them, the technologies that were developed to deliver them, and the methods used to analyze nuclear force structures and model nuclear exchanges. The last six weeks of the course will look at theories and cases of nuclear decision making beyond the original five weapon states, and will look particularly at why states pursue or forego nuclear weapons, the role that individuals and institutions play, and the potential for both new sources of proliferation and new consequences.", "course_url": "https://ocw.mit.edu/courses/17-951-nuclear-weapons-in-international-politics-past-present-and-future-spring-2009/", "image_url": "https://ocw.mit.edu/courses/17-951-nuclear-weapons-in-international-politics-past-present-and-future-spring-2009/952ef97172061c9daece4e3821f7f3f6_17-951S09.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": false, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-17-951-spring-2009-course-home", "course_id": "mitocw-17-951-spring-2009", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/17-951-nuclear-weapons-in-international-politics-past-present-and-future-spring-2009/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "bb79b6965413ee6805e2edaed7fb045b673660c479957999cc69b772dd92e784", "error": null}, {"resource_id": "mitocw-17-951-spring-2009-syllabus", "course_id": "mitocw-17-951-spring-2009", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/17-951-nuclear-weapons-in-international-politics-past-present-and-future-spring-2009/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_poli