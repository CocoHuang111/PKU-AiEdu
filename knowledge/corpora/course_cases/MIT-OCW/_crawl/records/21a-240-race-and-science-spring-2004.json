{"course": {"schema_version": "1.0", "course_id": "mitocw-21a-240-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21A.240"], "cross_listed_codes": [], "course_title": "Race and Science", "course_slug": "21a-240-race-and-science-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Anthropology"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Stefan Helmreich"], "subject_primary": "Anthropology", "subject_secondary": ["Cultural Anthropology", "Ethnography", "Sociology", "Social Justice"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology", "Ethnography"]}, {"name": "Sociology", "specialties": ["Social Justice"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments"], "description": "This course examines one of the most enduring and influential forms of identity and experience in the Americas and Europe, and in particular the ways race and racism have been created, justified, or contested in scientific practice and discourse. Drawing on classical and contemporary readings from Du Bois to Gould to Gilroy, we ask whether the logic of race might be changing in the world of genomics and informatics, and with that changed logic, how we can respond today to new configurations of race, science, technology, and inequality. Considered are the rise of evolutionary racism; debates about eugenics in the early twentieth century; Nazi notions of “racial hygiene”; nation-building projects and race in Latin America; and the movement in modern biology from race to populations to genes and genomes.", "course_url": "https://ocw.mit.edu/courses/21a-240-race-and-science-spring-2004/", "image_url": "https://ocw.mit.edu/courses/21a-240-race-and-science-spring-2004/3b0d708804a95df1d689a93dd64a0c16_21a-240s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21a-240-spring-2004-course-home", "course_id": "mitocw-21a-240-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21a-240-race-and-science-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "024b320c4d123c5a8398baa227e90a3832f3e9204247ac6be3aa013412e74f55", "error": null}, {"resource_id": "mitocw-21a-240-spring-2004-syllabus", "course_id": "mitocw-21a-240-spring-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/21a-240-race-and-science-spring-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "5f01f69d8998a7addd35f081344e21ac294081bee2d643ed94e0c2896c8e6c9a", "error": null}, {"resource_id": "mitocw-21a-240-spring-2004-calendar", "course_id": "mitocw-21a-240-spring-2004", "resource_type": "calendar", "source_title": "Calendar", "source_url": "https://ocw.mit.edu/courses/21a-240-race-and-science-spring-2004/pages/calendar/", "source_format": "html", "availability": "available", "extraction_p