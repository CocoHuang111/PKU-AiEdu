{"course": {"schema_version": "1.0", "course_id": "mitocw-6-701-spring-2010", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.701"], "cross_listed_codes": ["6.719"], "course_title": "Introduction to Nanoelectronics", "course_slug": "6-701-introduction-to-nanoelectronics-spring-2010", "term": "Spring", "year": 2010, "as_taught_in": "Spring 2010", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Marc  Baldo"], "subject_primary": "Technology", "subject_secondary": ["Engineering", "Electrical Engineering", "Electronics", "Nanotechnology", "Science", "Chemistry", "Physical Chemistry", "Physics", "Quantum Mechanics"], "topic_tree": [{"name": "Energy", "subtopics": [{"name": "Technology", "specialties": []}]}, {"name": "Engineering", "subtopics": [{"name": "Electrical Engineering", "specialties": ["Electronics"]}, {"name": "Nanotechnology", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Chemistry", "specialties": ["Physical Chemistry"]}, {"name": "Physics", "specialties": ["Quantum Mechanics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Open Textbooks", "Problem Sets"], "description": "Traditionally, progress in electronics has been driven by miniaturization. But as electronic devices approach the molecular scale, classical models for device behavior must be abandoned. To prepare for the next generation of electronic devices, this class teaches the theory of current, voltage and resistance from atoms up. To describe electrons at the nanoscale, we will begin with an introduction to the principles of quantum mechanics, including quantization, the wave-particle duality, wavefunctions and Schrödinger’s equation. Then we will consider the electronic properties of molecules, carbon nanotubes and crystals, including energy band formation and the o