{"course": {"schema_version": "1.0", "course_id": "mitocw-res-6-006-spring-2008", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.6-006"], "cross_listed_codes": [], "course_title": "Video Demonstrations in Lasers and Optics", "course_slug": "res-6-006-video-demonstrations-in-lasers-and-optics-spring-2008", "term": "Spring", "year": 2008, "as_taught_in": "Spring 2008", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Shaoul Ezekiel"], "subject_primary": "Physics", "subject_secondary": ["Atomic, Molecular, Optical Physics", "Electromagnetism", "Quantum Mechanics"], "topic_tree": [{"name": "Science", "subtopics": [{"name": "Physics", "specialties": ["Atomic, Molecular, Optical Physics", "Electromagnetism", "Quantum Mechanics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": [], "description": "This resource contains demonstrations used to illustrate the theory and applications of lasers and optics. A detailed listing of the topics can be found below. Lasers today are being used in an ever-increasing number of applications. In fact, there is hardly a field that has not been touched by the laser. Lasers are playing key roles in the home, office, hospital, factory, outdoors, and theater, as well as in the laboratory. To learn about lasers and related optics, one usually takes a course or two, or acquires the necessary information from books and journal articles. To make this learning more vivid and more exciting, and, one hopes, more understandable, one needs to see some of the basic phenomena involved. To fill this need, Professor Ezekiel has videotaped 48 demonstrations that illustrate most of the fundamental phenomena relating to lasers and physical optics. By using split-screen inserts and a wide range of video-recording capabilities, it is possible to show real-time effects in lasers and optics with the simultaneous manipulation of the components that cause these effects. In this way, one can see effects in close up that would be difficult, if not impossible, to display in front of an audience or in the classroom. These video demonstrations are designed for: The individual student of lasers and optics who wants to observe the various phenomena covered in theoretical treatments in courses, books, and technical papers. The Instructor in lasers and optics in a company, university, college, or high school who wants to illustrate, in class, many of the fundamental phenomena in optics and lasers. These videos were produced by the MIT Center for Advanced Engineering Study.", "course_url": "https://ocw.mit.edu/courses/res-6-006-video-demonstrations-in-lasers-and-optics-spring-2008/", "image_url": "https://ocw.mit.edu/courses/res-6-006-video-demonstrations-in-lasers-and-optics-spring-2008/fb156ff66c61543620d9827b973e1b5e_res-6-006s08.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-res-6-006-spring-2008-course-home", "course_id": "mitocw-res-6-006-spring-2008", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/res-6-006-video-demonstrations-in-lasers-and-optics-spring-2008/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date"