{"course": {"schema_version": "1.0", "course_id": "mitocw-6-s062-fall-2023", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.S062"], "cross_listed_codes": ["MAS.S10", "MAS.S60"], "course_title": "Generative Artificial Intelligence in K–12 Education", "course_slug": "6-s062-generative-artificial-intelligence-in-k12-education-fall-2023", "term": "Fall", "year": 2023, "as_taught_in": "Fall 2023", "language": "en", "departments": ["Electrical Engineering and Computer Science", "Media Arts and Sciences"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Harold Abelson", "Prof. Randall Davis", "Prof. Cynthia Breazeal", "Kate Moore", "Safinah Ali", "Prerna Ravi"], "subject_primary": "Computer Science", "subject_secondary": ["Artificial Intelligence", "Teaching and Education", "Curriculum and Teaching", "Educational Technology"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Artificial Intelligence"]}]}, {"name": "Teaching and Education", "subtopics": [{"name": "Curriculum and Teaching", "specialties": []}, {"name": "Educational Technology", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Multiple Assignment Types", "Podcasts"], "description": "The emergence of transformer architectures in 2017 triggered a breakthrough in machine learning that today lets anyone create computer-generated essays, stories, pictures, music, videos, and programs from high-level prompts in natural language, all without the need to code. That has stimulated fervent discussion among educators about the implications of generative AI systems for curricula and teaching methods across a broad range of subjects. It has also raised questions of how to understand both these systems and the at times overstated claims made for them. This class will introduce the foundations of generative AI technology, and participants will explore new opportunities it enables for K–12 education. It will also describe and explore how an analytical frame of mind can help make clear the core issues underlying both the successes and failures of these systems. Much of the work will be project-based, involving implementing innovative teaching and learning tools and testing these with K–12 students and teachers.", "course_url": "https://ocw.mit.edu/courses/6-s062-generative-artificial-intelligence-in-k12-education-fall-2023/", "image_url": "https://ocw.mit.edu/courses/6-s062-generative-artificial-intelligence-in-k12-education-fall-2023/mit6_s062_f23.jpeg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": true, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-6-s062-fall-2023-course-home", "course_id": "mitocw-6-s062-fall-2023", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/6-s062-generative-artificial-intelligence-in-k12-education-fall-2023/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "e1effe924112d56b93b0fb6e07015a01d4fbc8521e734e10e72b59ec3198f56f", "error": null}, {"resource_id": "mitocw-6-s062-fall-2023-online-publication", "course_id": "mitocw-6-s062-fall-2023", "resource_type": "online_publication", "source_title": "Online Publication", "source_url": 