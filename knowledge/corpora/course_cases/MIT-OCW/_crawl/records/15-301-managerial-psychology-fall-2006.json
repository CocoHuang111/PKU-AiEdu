{"course": {"schema_version": "1.0", "course_id": "mitocw-15-301-fall-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.301"], "cross_listed_codes": ["15.310"], "course_title": "Managerial Psychology", "course_slug": "15-301-managerial-psychology-fall-2006", "term": "Fall", "year": 2006, "as_taught_in": "Fall 2006", "language": "en", "departments": ["Sloan School of Management"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. John Carroll", "Prof. Li Tao"], "subject_primary": "Management", "subject_secondary": ["Organizational Behavior", "Social Science", "Psychology"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Management", "specialties": []}, {"name": "Organizational Behavior", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Psychology", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments"], "description": "This course introduces you to behavioral science theories, methods, and tools and provides opportunities to use and apply them to problems you will encounter in your work and career. The course material will begin with an overview of work and organizations in modern industrial society, and then examine individual behavior, move to behavior in groups or teams, and finally discuss organizations as a whole. It is expected that at the end of the course you will: (a) know something about managerial psychology, (b) know how to learn more, (c) understand the behavioral research process, and (d) develop skills in presenting your ideas in oral and written reports.", "course_url": "https://ocw.mit.edu/courses/15-301-managerial-psychology-fall-2006/", "image_url": "https://ocw.mit.edu/courses/15-301-managerial-psychology-fall-2006/6d216e41922479b6c9b2e7d6f9577aff_15-301f06.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons