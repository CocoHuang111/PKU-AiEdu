{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-487-spring-2002", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.487"], "cross_listed_codes": [], "course_title": "Modern Poetry", "course_slug": "21l-487-modern-poetry-spring-2002", "term": "Spring", "year": 2002, "as_taught_in": "Spring 2002", "language": "en", "departments": ["Literature"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Stephen Tapscott"], "subject_primary": "Literature", "subject_secondary": ["American Literature", "Criticism", "Poetry"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["American Literature", "Criticism", "Poetry"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments", "Presentation Assignments", "Written Assignments"], "description": "This course considers some of the substantial early twentieth-century poetic voices in America. Authors vary, but may include Moore, Frost, Eliot, Stevens, and Pound. We’ll read the major poems by the most important poets in English in the 20th century, emphazinig especially the period between post-WWI disillusionment and early WW II internationalism (ca. 1918-1940). Our special focus this term will be how the concept of “the Image” evolved during this period. The War had undercut beliefs in master-narratives of nationalism and empire, and the language-systems that supported them (religious transcendence, rationalism and formalism). Retrieving energies from the Symbolist movements of the preceding century, early 20th century poets began to rethink how images carry information, and in what ways the visual, visionary, and verbal image can take the place of transcendent beliefs. New theories of linguistics and anthropology helped to advance this interest in the artistic/religious image. So did Freud. So did Charlie Chaplin films. We’ll read poems that pay attention both to this disillusionment and to the compensatory joyous attention to the image: to ideas of the poet-as-language-priest, aesthetic-experience-as-displaced-religious impulse, to poetry as faith, ritual, and form.", "course_url": "https://ocw.mit.edu/courses/21l-487-modern-poetry-spring-2002/", "image_url": "https://ocw.mit.edu/courses/21l-487-modern-poetry-spring-2002/8341ab0a795088a7a07a8e54f61ab569_21l-487s02.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-487-spring-2002-course-home", "course_id": "mitocw-21l-487-spring-2002", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-487-modern-poetry-spring-2002/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "a155492c827339c28684ac989f87a810a7869097f29350f548d3b9e6131f5343", "error": null}, {"resource_id": "mitocw-21l-487-spring-2002-syllabus", "course_id": "mitocw-21l-487-spring-2002", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/21l-487-modern-poetry-spring-2002/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_