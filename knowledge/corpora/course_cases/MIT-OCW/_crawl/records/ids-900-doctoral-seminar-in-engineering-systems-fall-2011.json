{"course": {"schema_version": "1.0", "course_id": "mitocw-ids-900-fall-2011", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["IDS.900"], "cross_listed_codes": ["IDS.900 (formerly ESD.83)"], "course_title": "Doctoral Seminar in Engineering Systems", "course_slug": "ids-900-doctoral-seminar-in-engineering-systems-fall-2011", "term": "Fall", "year": 2011, "as_taught_in": "Fall 2011", "language": "en", "departments": ["Institute for Data, Systems, and Society"], "academic_levels": ["Graduate"], "instructors": ["Dr. Christopher L. Magee", "Prof. Joseph Sussman", "Rebecca Saari"], "subject_primary": "Systems Engineering", "subject_secondary": [], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Systems Engineering", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Presentation Assignments", "Written Assignments"], "description": "IDS.900 Doctoral Seminar in Engineering Systems examines the core theory and contextual applications of the emerging field of Engineering Systems. There is a focus on doctoral–level analysis of scholarship on key concepts such as complexity, uncertainty, fragility, and robustness, as well as a critical look at the historical roots of the field and related areas such as systems engineering, systems dynamics, agent modeling, and systems simulations. Contextual applications of the course range from aerospace to technology implementation to regulatory systems to large–scale systems change. Special attention is given to the interdependence of social and technical dimensions of engineering systems.", "course_url": "https://ocw.mit.edu/courses/ids-900-doctoral-seminar-in-engineering-systems-fall-2011/", "image_url": "https://ocw.mit.edu/courses/ids-900-doctoral-seminar-in-engineering-systems-fall-2011/5d8a7b8f83eaae7c74e42331cf763928_ids-900f11.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url":