{"course": {"schema_version": "1.0", "course_id": "mitocw-11-s196-spring-2011", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.S196"], "cross_listed_codes": ["11.191"], "course_title": "Global Freshwater Crisis", "course_slug": "11-s196-global-freshwater-crisis-spring-2011", "term": "Spring", "year": 2011, "as_taught_in": "Spring 2011", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Undergraduate"], "instructors": ["Susan Murcott"], "subject_primary": "Environmental Engineering", "subject_secondary": ["Aquatic Sciences and Water Quality Control", "Environmental Management", "Hydrodynamics and Coastal Engineering", "Social Science", "Economics", "International Development"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Environmental Engineering", "specialties": ["Aquatic Sciences and Water Quality Control", "Environmental Management", "Hydrodynamics and Coastal Engineering"]}]}, {"name": "Social Science", "subtopics": [{"name": "Economics", "specialties": ["International Development"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Projects", "Written Assignments"], "description": "For the first time in history, the global demand for freshwater is overtaking its supply in many parts of the world. The U.N. predicts that by 2025, more than half of the countries in the world will be experiencing water stress or outright shortages. Lack of water can cause disease, food shortages, starvation, migrations, political conflict, and even lead to war. Models of cooperation, both historic and contemporary, show the way forward. The first half of the course details the multiple facets of the water crisis. Topics include water systems, water transfers, dams, pollution, climate change, scarcity, water conflict/cooperation, food security, and agriculture. The second half of the course describes innovative solutions: Adaptive technologies and adaptation through policy, planning, management, economic tools, and finally, human behaviors required to preserve this precious and imperiled resource. Several field trips to water/wastewater/biosolids reuse and water-energy sites will help us to better comprehend both local and international challenges and solutions.", "course_url": "https://ocw.mit.edu/courses/11-s196-global-freshwater-crisis-spring-2011/", "image_url": "https://ocw.mit.edu/courses/11-s196-global-freshwater-crisis-spring-2011/db3430173a801ffdf4f4f2b545432580_11-s196s11.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": false, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-11-s196-spring-2011-course-home", "course_id": "mitocw-11-s196-spring-2011", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/11-s196-global-freshwater-crisis-spring-2011/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "8a69af1e3e381e2f70ad832adc988288221d84b7250b0f568206e8669f881744", "error": null}, {"resource_id": "mitocw-11-s196-spring-2011-syllabus", "course_id": "mitocw-11-s196-spring-2011", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/11-s196-global-freshwater-crisis-spring-2011/pages/syllabus/", "source_format": "html