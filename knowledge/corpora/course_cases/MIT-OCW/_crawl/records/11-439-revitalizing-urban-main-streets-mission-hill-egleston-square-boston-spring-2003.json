{"course": {"schema_version": "1.0", "course_id": "mitocw-11-439-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["11.439"], "cross_listed_codes": [], "course_title": "Revitalizing Urban Main Streets: Mission Hill & Egleston Square, Boston", "course_slug": "11-439-revitalizing-urban-main-streets-mission-hill-egleston-square-boston-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Karl Seidman", "Prof. Susan Silberberg"], "subject_primary": "Architecture", "subject_secondary": ["Environmental Design", "Social Science", "Public Administration", "Public Policy", "Sociology", "Community Development", "Urban Studies", "Urban Planning"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Architecture", "specialties": ["Environmental Design"]}]}, {"name": "Social Science", "subtopics": [{"name": "Public Administration", "specialties": ["Public Policy"]}, {"name": "Sociology", "specialties": ["Community Development"]}, {"name": "Urban Studies", "specialties": ["Urban Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments with Examples"], "description": "Revitalizing Urban Main Streets focuses on the physical and economic renewal of urban neighborhood Main Streets by combining classroom work with an applied class project. The course content covers three broad areas: an overview of the causes for urban business district decline, the challenges faced in revitalization and the type of revitalization strategies employed; the physical and economic development planning tools used to understand and assess urban Main Streets from physical design and economic development perspectives; and the policies, interventions, and investments used to foster urban commercial revit