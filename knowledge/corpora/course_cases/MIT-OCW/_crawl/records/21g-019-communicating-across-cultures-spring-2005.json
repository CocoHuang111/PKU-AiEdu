{"course": {"schema_version": "1.0", "course_id": "mitocw-21g-019-spring-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21G.019"], "cross_listed_codes": ["21G.021"], "course_title": "Communicating Across Cultures", "course_slug": "21g-019-communicating-across-cultures-spring-2005", "term": "Spring", "year": 2005, "as_taught_in": "Spring 2005", "language": "en", "departments": ["Global Studies and Languages"], "academic_levels": ["Undergraduate", "Graduate"], "instructors": ["Prof. Bernd Widdig", "Dr. Lori Breslow"], "subject_primary": "Anthropology", "subject_secondary": ["Cultural Anthropology", "Communication"], "topic_tree": [{"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Cultural Anthropology"]}, {"name": "Communication", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments", "Presentation Assignments", "Written Assignments"], "description": "It has become commonplace knowledge that globalization is one of the major forces shaping our world. If we look at the spread of information, ideas, capital, media, cultural artifacts - or for that matter, people - we can see the boundaries and borders that have historically separated one country or one group from another are becoming more and more permeable. For proof of this close to home, you need only to look at the composition of the MIT student body: 8 percent of the undergraduates and 37 percent of the graduate students are from 109 different countries. “Communicating Across Cultures” is designed to help you meet the challenges of living in a world in which, increasingly, you will be asked to interact with people who may not be like you in fundamental ways. Its primary goals are to help you become more sensitive to intercultural communication differences, and to provide you with the knowledge and skills that will help you interact successfully with people from cultures other than your own. We hope the course will accomplish those goals by exposing you to some of the best writers and scholars on the subject of intercultural communication, and by giving you a variety of opportunities to practice intercultural communication yourself. As you read the syllabus for this course, we hope you get a sense of our commitment to making this course a rewarding experience for you.", "course_url": "https://ocw.mit.edu/courses/21g-019-communicating-across-cultures-spring-2005/", "image_url": "https://ocw.mit.edu/courses/21g-019-communicating-across-cultures-spring-2005/73f12f117f42712f05f55cc52ac60fcc_21g-019s05.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21g-019-spring-2005-course-home", "course_id": "mitocw-21g-019-spring-2005", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21g-019-communicating-across-cultures-spring-2005/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "b561f668aea92677fd58f8018e43a3e22f1bfe66c76b34013c028724c599f60e", "error": null}, {"resource_id": "mitocw-21g-019-spring-2005-syllabus", "course_id": "mitocw-21g-019-spring-2005", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "http