{"course": {"schema_version": "1.0", "course_id": "mitocw-res-21w-01-fall-2015", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.21W-01"], "cross_listed_codes": [], "course_title": "Angles", "course_slug": "res-21w-01-angles-fall-2015", "term": "Fall", "year": 2015, "as_taught_in": "Fall 2015", "language": "en", "departments": ["Comparative Media Studies/Writing"], "academic_levels": ["Non-Credit"], "instructors": ["Jared David Berezin", "Louise Harrison Lepera", "Lucy Marx", "Karen Boiko", "Dr. Cynthia Taft", "Dr. Andrea Walsh", "Jane Kokernak"], "subject_primary": "Literature", "subject_secondary": ["Academic Writing", "Creative Writing", "Nonfiction Prose", "Social Science", "Communication"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["Academic Writing", "Creative Writing", "Nonfiction Prose"]}]}, {"name": "Social Science", "subtopics": [{"name": "Communication", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": [], "description": "Angles is an annual online magazine of exemplary writing by MIT students. All of the works published in Angles since its first edition in 2008 were written by students in the introductory writing courses. These courses, designated as CI-HW (Communications-Intensive Humanities Writing) subjects, bring together students who love to write, students who struggle with writing, students who thrive in seminar-style classes, and students who just want a chance to develop their English skills. These students prosper together and produce some remarkable work. Angles has provided them with a public outlet for that work. It also provides the CI-HW instructors with material that inspires and guides their current students. In these classes, students learn to read more critically, to address specific audiences for particular purposes, to construct effective arguments and narratives, and to use and cite source material properly. Students in these courses write a great deal; they prewrite, write, revise, and edit their work for content, clarity, tone, and grammar and receive detailed feedback from instructors and classmates. Assigned readings are related to the thematic focus of each course, and are used as demonstrations of writing techniques. The pieces in Angles may be used as teaching tools and practical examples for other students and self-learners to emulate. You can find Angles Online .", "course_url": "https://ocw.mit.edu/courses/res-21w-01-angles-fall-2015/", "image_url": "https://ocw.mit.edu/courses/res-21w-01-angles-fall-2015/2959781e4d90e150fac13e6d7e4e8125_res-21w-01f15.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-res-21w-01-fall-2015-course-home", "course_id": "mitocw-res-21w-01-fall-2015", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/res-21w-01-angles-fall-2015/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "702d0422d071c3021ea891dd216fee6e433e1dd853a9b1fc58290663c48d3ddb", "error": null}, {"resource_id": "mitocw-res-21w-01-fall-2015-angles-archives", "course_id": "mitocw-res-21w-01-fall-2015", "resource_type": "angles_archives", "source_title": "Angles Archives", "sou