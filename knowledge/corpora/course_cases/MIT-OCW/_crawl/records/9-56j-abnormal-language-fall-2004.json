{"course": {"schema_version": "1.0", "course_id": "mitocw-9-56j-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["9.56J"], "cross_listed_codes": ["24.907J"], "course_title": "Abnormal Language", "course_slug": "9-56j-abnormal-language-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Brain and Cognitive Sciences", "Linguistics and Philosophy"], "academic_levels": ["Undergraduate"], "instructors": ["Mr. Christopher Hirsch", "Prof. Ken Wexler"], "subject_primary": "Speech Pathology", "subject_secondary": ["Humanities", "Linguistics", "Science", "Cognitive Science"], "topic_tree": [{"name": "Health and Medicine", "subtopics": [{"name": "Speech Pathology", "specialties": []}]}, {"name": "Humanities", "subtopics": [{"name": "Linguistics", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Cognitive Science", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Problem Sets", "Written Assignments"], "description": "Introduction to the linguistic study of language pathology, concentrating on experimental approaches and theoretical explanations. Discussion of Specific Language Impairment, autism, Down syndrome, Williams syndrome, normal aging, Parkinson’s disease, Alzheimer’s disease, hemispherectomy and aphasia. Focuses on the comparison of linguistic abilities among these syndromes, while drawing clear comparisons with first and second language acquisition. Topics include the lexicon, morphology, syntax, semantics and pragmatics. Relates the lost linguistic abilities in these syndromes to properties of the brain.", "course_url": "https://ocw.mit.edu/courses/9-56j-abnormal-language-fall-2004/", "image_url": "https://ocw.mit.edu/courses/9-56j-abnormal-language-fall-2004/68c2cf9eb780d32a5afeae11e6d8a6fe_9-56jf04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https:/