{"course": {"schema_version": "1.0", "course_id": "mitocw-21a-219-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21A.219"], "cross_listed_codes": ["11.163J", "17.249J"], "course_title": "Law and Society", "course_slug": "21a-219-law-and-society-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Anthropology", "Urban Studies and Planning", "Political Science"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Susan S. Silbey"], "subject_primary": "Philosophy", "subject_secondary": ["Political Philosophy", "Social Science", "Anthropology", "Legal Studies", "Sociology", "Social Justice"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Philosophy", "specialties": ["Political Philosophy"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": []}, {"name": "Legal Studies", "specialties": []}, {"name": "Sociology", "specialties": ["Social Justice"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Written Assignments"], "description": "Law is a common and yet distinct aspect of everyday life in modern societies. This course examines the central features of law as a social institution and as a feature of popular culture. We will explore the nature of law as a set of social systems, central actors in the systems, legal reasoning, and the relationship of the legal form and reasoning to social change. The course emphasizes the relationship between the internal logic of legal devices and economic, political and social processes. Emphasis is placed upon developing a perspective which views law as a practical resource, a mechanism for handling the widest range of unspecified social issues, problems, and conflicts, and at the same time, as a set of shared representations and aspirations. We will explore the range of experiences of law for its ministers (lawyers, judges, law enforcement agents and administrators) as well as for its supplicants (citizens, plaintiffs, defendants). We will examine how law is mobilized and deployed by professionals and ordinary citizens. We cannot cover all aspects of the legal system, nor focus on all the different actors. A set of topics has been selected to develop understanding of the situational and systemic demands within which actors in the legal system operate and perform their roles; at the same time, we will try to discover systematic patterns in the uses and consequences of law. Throughout the course there is concern for understanding what we mean by legality and the rule of law.", "course_url": "https://ocw.mit.edu/courses/21a-219-law-and-society-spring-2003/", "image_url": "https://ocw.mit.edu/courses/21a-219-law-and-society-spring-2003/10723d22a0eb836cc03ec3fb121f3b62_21a-219s03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21a-219-spring-2003-course-home", "course_id": "mitocw-21a-219-spring-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21a-219-law-and-society-spring-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "baeedad79ddfd422b096edd7747e44447909