{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-015-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.015"], "cross_listed_codes": [], "course_title": "Introduction to Media Studies", "course_slug": "21l-015-introduction-to-media-studies-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Literature"], "academic_levels": ["Undergraduate"], "instructors": ["Dr. Andrea Walsh"], "subject_primary": "Media Studies", "subject_secondary": ["Humanities", "Literature", "Comparative Literature", "Criticism", "Social Science", "Anthropology", "Social Anthropology"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Media Studies", "specialties": []}]}, {"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["Comparative Literature", "Criticism"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Social Anthropology"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Presentation Assignments", "Written Assignments"], "description": "Introduction to Media Studies is designed for students who have grown up in a rapidly changing global multimedia environment and want to become more literate and critical consumers and producers of culture. Through an interdisciplinary comparative and historical lens, the course defines “media” broadly as including oral, print, theatrical, photographic, broadcast, cinematic, and digital cultural forms and practices. The course looks at the nature of mediated communication, the functions of media, the history of transformations in media and the institutions that help define media’s place in society. Over the course of the semester we explore different theoretical perspectives on the role and power of media in society in influencing our social values, political beliefs, identities and behaviors. Students also have the opportunity to analyze specific media texts (such as films and television shows) and explore the meaning of the changes that occur when a particular narrative is adapted into different media forms. We look at the ways in which the politics of class, gender and race influence both the production and reception of media. To represent different perspectives on media, several guest speakers also present lectures. Through the readings, lectures, and discussions as well as their own writing and oral presentations, students have multiple opportunities to engage with critical debates in the field as well as explore the role of media in their own lives.", "course_url": "https://ocw.mit.edu/courses/21l-015-introduction-to-media-studies-fall-2003/", "image_url": "https://ocw.mit.edu/courses/21l-015-introduction-to-media-studies-fall-2003/3c0dfd73418b6e8c731baee2d3b93662_21l-015f03.gif", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-015-fall-2003-course-home", "course_id": "mitocw-21l-015-fall-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-015-introduction-to-media-studies-fall-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "f3c94cbedaec420e9cbb388aaad8e1966ac15cb