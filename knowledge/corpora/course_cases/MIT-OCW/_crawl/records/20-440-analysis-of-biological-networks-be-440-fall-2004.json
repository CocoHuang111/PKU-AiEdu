{"course": {"schema_version": "1.0", "course_id": "mitocw-20-440-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["20.440"], "cross_listed_codes": [], "course_title": "Analysis of Biological Networks (BE.440)", "course_slug": "20-440-analysis-of-biological-networks-be-440-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Biological Engineering"], "academic_levels": ["Graduate"], "instructors": ["Prof. John Essigmann", "Prof. Ram Sasisekharan"], "subject_primary": "Biological Engineering", "subject_secondary": ["Computational Biology", "Science", "Biology", "Biochemistry", "Biophysics", "Computation and Systems Biology"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Biological Engineering", "specialties": ["Computational Biology"]}]}, {"name": "Science", "subtopics": [{"name": "Biology", "specialties": ["Biochemistry", "Biophysics", "Computation and Systems Biology"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Projects"], "description": "This class analyzes complex biological processes from the molecular, cellular, extracellular, and organ levels of hierarchy. Emphasis is placed on the basic biochemical and biophysical principles that govern these processes. Examples of processes to be studied include chemotaxis, the fixation of nitrogen into organic biological molecules, growth factor and hormone mediated signaling cascades, and signaling cascades leading to cell death in response to DNA damage. In each case, the availability of a resource, or the presence of a stimulus, results in some biochemical pathways being turned on while others are turned off. The course examines the dynamic aspects of these processes and details how biochemical mechanistic themes impinge on molecular/cellular/tissue/organ-level functions. Chemical and quantitative views of the interplay of multiple pathways as biological networks are emphasized. Student work culminates in the preparation of a unique grant application in an area of biological networks.", "course_url": "https://ocw.mit.edu/courses/20-440-analysis-of-biological-networks-be-440-fall-2004/", "image_url": "https://ocw.mit.edu/courses/20-440-analysis-of-biological-networks-be-440-fall-2004/35bfa14c33c3b437850f6dea8b931c54_20-440f04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": false, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-20-440-fall-2004-course-home", "course_id": "mitocw-20-440-fall-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/20-440-analysis-of-biological-networks-be-440-fall-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "9851a9f82808171f22f33e9fb4d5ec5521829780aeae008448ee8176400d281a", "error": null}, {"resource_id": "mitocw-20-440-fall-2004-syllabus", "course_id": "mitocw-20-440-fall-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/20-440-analysis-of-biological-networks-be-440-fall-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": 