{"course": {"schema_version": "1.0", "course_id": "mitocw-15-342j-fall-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["15.342J"], "cross_listed_codes": ["11.262J"], "course_title": "Organizations and Environments", "course_slug": "15-342j-organizations-and-environments-fall-2004", "term": "Fall", "year": 2004, "as_taught_in": "Fall 2004", "language": "en", "departments": ["Sloan School of Management", "Urban Studies and Planning"], "academic_levels": ["Graduate"], "instructors": ["Prof. Pablo Boczkowski"], "subject_primary": "Organizational Behavior", "subject_secondary": ["Social Science", "Anthropology", "Economics", "Political Science", "Psychology", "Sociology"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Organizational Behavior", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": []}, {"name": "Economics", "specialties": []}, {"name": "Political Science", "specialties": []}, {"name": "Psychology", "specialties": []}, {"name": "Sociology", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "The goal of this doctoral course is to familiarize students with major conceptual frameworks, debates, and developments in contemporary organization theory. This is an inter-disciplinary domain of inquiry drawing primarily from sociology, and secondarily from economics, psychology, anthropology, and political science. The course focuses on inter-organizational processes, and also addresses the economic, institutional and cultural contexts that organizations must face. This is an introduction to a vast and multifaceted domain of inquiry. Due to time limitations, this course will touch lightly on many important topics, and neglect others entirely; its design resembles more a map than an encyclopedia. Also, given the focus on theoretical matters, methodological issues will move to the background. Empirical material will be used to illustrate how knowledge is produced from a particular standpoint and trying to answer particular questions, leaving the bulk of the discussion on quantitative and qualitative procedures to seminars such as 15.347, 15.348, and the like.", "course_url": "https://ocw.mit.edu/courses/15-342j-organizations-and-environments-fall-2004/", "image_url": "https://ocw.mit.edu/courses/15-342j-organizations-and-environments-fall-2004/4abcbad59c097c624a38138a122e06f8_15-342jf04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-15-342j-fall-2004-course-home", "course_id": "mitocw-15-342j-fall-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/15-342j-organizations-and-environments-fall-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "22cabe45da811c2cb6068c9dc3e3b6e5b6ef0e8bb40f9f02ae584b07fa47927c", "error": null}, {"resource_id": "mitocw-15-342j-fall-2004-syllabus", "course_id": "mitocw-15-342j-fall-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/15-342j-organizations-and-environments-fall-2004/pages/syllabus/", "source_format": "html", "availabilit