{"course": {"schema_version": "1.0", "course_id": "mitocw-6-832-spring-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.832"], "cross_listed_codes": [], "course_title": "Underactuated Robotics", "course_slug": "6-832-underactuated-robotics-spring-2009", "term": "Spring", "year": 2009, "as_taught_in": "Spring 2009", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Russell Tedrake"], "subject_primary": "Computer Science", "subject_secondary": ["Artificial Intelligence", "Electrical Engineering", "Robotics and Control Systems"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Artificial Intelligence"]}, {"name": "Electrical Engineering", "specialties": ["Robotics and Control Systems"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Lecture Videos", "Problem Set Solutions", "Problem Sets", "Programming Assignments with Examples", "Projects"], "description": "Robots today move far too conservatively, using control systems that attempt to maintain full control authority at all times. Humans and animals move much more aggressively by routinely executing motions which involve a loss of instantaneous control authority. Controlling nonlinear systems without complete control authority requires methods that can reason about and exploit the natural dynamics of our machines. This course discusses nonlinear dynamics and control of underactuated mechanical systems, with an emphasis on machine learning methods. Topics include nonlinear dynamics of passive robots (walkers, swimmers, flyers), motion planning, partial feedback linearization, energy-shaping control, analytical optimal control, reinforcement learning/approximate optimal control, and the influence of mechanical design on control. Discussions include examples from biology and applications to legged locomotion, compliant manipulation, underwater robots, and flying machines. Acknowledgments Professor Tedrake would like to thank John Roberts for his help with the course and videotaping the lectures.", "course_url": "https://ocw.mit.edu/courses/6-832-underactuated-robotics-spring-2009/", "image_url": "https://ocw.mit.edu/courses/6-832-underactuated-robotics-spring-2009/e7c8a3779cf478cfc8365571e074ebc7_6-832s09.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": true, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-6-832-spring-2009-course-home", "course_id": "mitocw-6-832-spring-2009", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/6-832-underactuated-robotics-spring-2009/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "968cafbd282084763e0f97c384bbd6407cb8cb9b9e32f1b32810206b1589caaa", "error": null}, {"resource_id": "mitocw-6-832-spring-2009-syllabus", "course_id": "mitocw-6-832-spring-2009", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/6-832-underactuated-robotics-spring-2009/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_