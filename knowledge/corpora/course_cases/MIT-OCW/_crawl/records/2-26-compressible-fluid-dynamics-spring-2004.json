{"course": {"schema_version": "1.0", "course_id": "mitocw-2-26-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["2.26"], "cross_listed_codes": [], "course_title": "Compressible Fluid Dynamics", "course_slug": "2-26-compressible-fluid-dynamics-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Mechanical Engineering"], "academic_levels": ["Graduate"], "instructors": ["Prof. Anette Hosoi"], "subject_primary": "Mechanical Engineering", "subject_secondary": ["Fluid Mechanics", "Ocean Engineering", "Hydrodynamics", "Science", "Physics", "Thermodynamics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Mechanical Engineering", "specialties": ["Fluid Mechanics"]}, {"name": "Ocean Engineering", "specialties": ["Hydrodynamics"]}]}, {"name": "Science", "subtopics": [{"name": "Physics", "specialties": ["Thermodynamics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets", "Written Assignments with Examples"], "description": "2.26 is a 6-unit Honors-level subject serving as the Mechanical Engineering department’s sole course in compressible fluid dynamics. The prerequisites for this course are undergraduate courses in thermodynamics, fluid dynamics, and heat transfer. The goal of this course is to lay out the fundamental concepts and results for the compressible flow of gases. Topics to be covered include: appropriate conservation laws; propagation of disturbances; isentropic flows; normal shock wave relations, oblique shock waves, weak and strong shocks, and shock wave structure; compressible flows in ducts with area changes, friction, or heat addition; heat transfer to high speed flows; unsteady compressible flows, Riemann invariants, and piston and shock tube problems; steady 2D supersonic flow, Prandtl-Meyer function; and self-similar compressible flows. The emphasis will be on physical understanding of the phenomena and basic analytical techniques.", "course_url": "https://ocw.mit.edu/courses/2-26-compressible-fluid-dynamics-spring-2004/", "image_url": "https://ocw.mit.edu/courses/2-26-compressible-fluid-dynamics-spring-2004/d75c065ffe3fbc6c9f01f4552cb08a8d_2-26s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": true}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-2-26-spring-2004-course-home", "course_id": "mitocw-2-26-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/2-26-compressible-fluid-dynamics-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "995de750a08b1260cb41dee4b071cfb4781ff312d5c2b2ec31985334023454bf", "error": null}, {"resource_id": "mitocw-2-26-spring-2004-syllabus", "course_id": "mitocw-2-26-spring-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/2-26-compressible-fluid-dynamics-spring-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "4b65c741ac4fe08a2bbf5778b667edde7d8fb5efbfa9f1e23cf1241ce2574ecd", "error": null}, {"reso