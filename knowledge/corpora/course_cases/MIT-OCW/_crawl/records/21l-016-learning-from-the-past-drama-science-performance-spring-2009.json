{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-016-spring-2009", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.016"], "cross_listed_codes": [], "course_title": "Learning from the Past: Drama, Science, Performance", "course_slug": "21l-016-learning-from-the-past-drama-science-performance-spring-2009", "term": "Spring", "year": 2009, "as_taught_in": "Spring 2009", "language": "en", "departments": ["Literature"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Diana Henderson", "Prof. Janet Sonenberg"], "subject_primary": "History", "subject_secondary": ["European History", "History of Science and Technology", "Literature", "Comparative Literature", "Drama", "International Literature"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["European History", "History of Science and Technology"]}, {"name": "Literature", "specialties": ["Comparative Literature", "Drama", "International Literature"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Image Gallery", "Presentation Assignments", "Projects with Examples", "Written Assignments"], "description": "This class explores the creation (and creativity) of the modern scientific and cultural world through study of western Europe in the 17th century, the age of Descartes and Newton, Shakespeare, Milton and Ford. It compares period thinking to present-day debates about the scientific method, art, religion, and society. This team-taught, interdisciplinary subject draws on a wide range of literary, dramatic, historical, and scientific texts and images, and involves theatrical experimentation as well as reading, writing, researching and conversing. The primary theme of the class is to explore how England in the mid-seventeenth century became “a world turned upside down” by the new ideas and upheavals in religion, politics, and philosophy, ideas that would shape our modern world. Paying special attention to the “theatricality” of the new models and perspectives afforded by scientific experimentation, the class will read plays by Shakespeare, Tate, Brecht, Ford, Churchill, and Kushner, as well as primary and secondary texts from a wide range of disciplines. Students will also compose and perform in scenes based on that material.", "course_url": "https://ocw.mit.edu/courses/21l-016-learning-from-the-past-drama-science-performance-spring-2009/", "image_url": "https://ocw.mit.edu/courses/21l-016-learning-from-the-past-drama-science-performance-spring-2009/717f8357bed3df4496fb7faf6b6d0784_21l-016s09.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-016-spring-2009-course-home", "course_id": "mitocw-21l-016-spring-2009", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-016-learning-from-the-past-drama-science-performance-spring-2009/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "bb7ae62f0a88bb2967c6a76a1a96f982a8ad89fa223cb0024d11a81792f03e03", "error": null}, {"resource_id": "mitocw-21l-016-spring-2009-syllabus", "course_id": "mitocw-21l-016-spring-2009", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https:/