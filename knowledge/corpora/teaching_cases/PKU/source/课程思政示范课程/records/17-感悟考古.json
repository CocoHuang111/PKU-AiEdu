  "detail": {
    "id": "DB49AABDB240606BE050007F010066D3",
    "cjr": "0006172222",
    "cjsj": "2022-03-28T23:07:12.000+08:00",
    "zhxgr": "0006172222",
    "zhxgsj": "2022-03-28T23:07:12.000+08:00",
    "rsylj": "<p><span style=\"color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">&ldquo;课程思政&rdquo;是高校以习近平新时代中国特色社会主义思想为指导，以习近平总书记关于教育工作的重要论述为根本遵循，落实立德树人根本任务的重要举措。&ldquo;课程思政&rdquo;建设对高校坚持社会主义办学方向，落实立德树人根本任务，保证育人工作贯穿教育教学全过程具有重要意义。习近平总书记指出，中华文明是中华民族自强不息、发展壮大的强大精神力量。考古学作为探寻文明基因，助力民族复兴的重要渠道，理应在教育教学中融入思政元素，培养更多、更好的中华遗产的保护者、中华文明的诠释者和中华文化的传播者。</span></p>",
    "rsyljfjlj": null,
    "rsyljfjmc": null,
    "kcmb": "<p><span style=\"color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">本课程为新生导学项目，旨在帮助学生建立起考古学学科框架，掌握基本学习方法，培养学生真正成为一名具有田野考古工作能力的考古学研究者和具有社会责任感和家国情怀的考古工作者。</span></p>",
    "jxff": "<div class=\"jxff list\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px 0px 40px; padding: 0px; color: #333333; font-family: 微软雅黑, 'Microsoft YaHei', 黑体; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\">\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">授课为主，结合参观、讨论</p>\n</div>",
    "pjfa": "<div class=\"pjfa list\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px 0px 40px; padding: 0px; color: #333333; font-family: 微软雅黑, 'Microsoft YaHei', 黑体; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\">\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">平时考勤10%+期末论文90%</p>\n</div>",
    "xgyq": "<p><span style=\"color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">线下选课同学，考勤形式为不定期点名；线上选课同学，需在第十六周结课后每人提交四篇课程笔记给助教，作为平时考勤依据。</span></p>",
    "jxffjal": "<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt; text-align: center;\"><span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\"><strong style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; font-weight: bolder;\">考古文博学院2020级本科生赴陕西周原开展专业实践、思政实践</strong></span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">2020</span><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">年<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">10</span>月<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">30</span>日<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">-11</span>月<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">1</span>日，考古文博学院<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">2020</span>级本科生前往陕西周原考古实习基地，走出《感悟考古》的课堂，来到考古发掘一线，观摩考古工作，体验考古生活，感受考古的意义与价值。考古文博学院副院长、强基班首席导师沈睿文、考古文博学院<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">2020</span>级本科生班班主任彭明浩参与活动。</span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">10</span><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">月<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">31</span>日早，同学们乘车前往周原考古工地和周原博物馆参观学习。<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">2018</span>级考古实习领队曹大志老师向同学们介绍了目前的工作进展，带领同学们走近探方参观学习，了解考古发掘的详细过程，耐心解答了同学们提出的问题。曹老师带同学们参观了于河沟内发现的古城墙，同学们亲手触摸刚出土的陶片，触摸历史，触摸考古。</span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\"><img style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; border-style: none; margin: 0px auto; padding: 0px; max-width: 100%; display: block;\" src=\"../../../tp/1906193065/ab8bedf0-49a5-4db7-ba2a-1bbfea08cb45.png\" /></span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">工地参观结束后，同学们前往周原考古博物院，了解周原的地理、历史背景，周原考古工作的出土文物和成就。同学们欣赏出土的编钟、玉玦、马车，聆听历代考古人筚路蓝缕、呕心沥血的故事。展厅里陈列的文物，既是源远流长的文化，也是我们的责任。周原的考古工作还没有结束，考古学的新生血液，将在这片历史悠久的土地上继续勤奋工作。</span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">下午，考古文博学院师生乘车前往法门寺参观学习，在法门寺博物馆内了解法门寺的历史和地宫内出土的文物，感受佛教的独特魅力。</span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\"><img style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; border-style: none; margin: 0px auto; padding: 0px; max-width: 100%; display: block;\" src=\"../../../tp/1906193065/85e26d6b-2881-4490-8a58-eac50297107b.png\" /></span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">10</span><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">月<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">31</span>日晚，同学们在周原博物馆与周原考古队的学长学姐们举行了座谈会。新生们踊跃提问，学长学姐们热心分享了自己的工地经历和感受，细心解答了同学们的问题。座谈会在热烈而又温馨的气氛中落下帷幕。同学们了解了考古工地上的生活，获得许多在学习生活上的宝贵经验。</span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">11</span><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">月<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">1</span>日上午，同学们参观唐乾陵陪葬墓永泰公主墓，深入了解了公主墓出土文物。同学们前往乾陵主陵，学习石像生的源流故事。针对著名的武则天无字碑&ldquo;无字&rdquo;谜题，同学们展开了热烈的交流与讨论。</span></p>\n<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0cm 0cm 0.0001pt; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-indent: 24pt;\"><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-size: 10.5pt; letter-spacing: 0.75pt;\">在为期三天的感悟考古活动中，同学们加深了对于考古的认识和感受，获得了前所未有的新奇体验。习近平总书记在中央政治局第二十三次集体学习时强调，要高度重视考古工作，努力建设中国特色、中国风格、中国气派的考古学，更好认识源远流长、博大精深的中华文明，为弘扬中华优秀传统文化、增强文化自信提供坚强支撑。新一代的考古人，正应像雷兴山院长寄语的那样&ldquo;凝练文明基因，阐发传统价值，厚植文化自信，助力民族复兴&rdquo;，在新时代绽放自己的光彩。<span lang=\"EN-US\" style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px;\">2020</span>级本科的每一位同学，都怀着对考古满满的热情和期待，准备在燕园开启考古学习之旅。相信每一位同学都会在不断地学习和锻炼中，用自己稚嫩却日渐成熟的双肩扛起弘扬中华优秀传统文化的重任！</span></p>",
    "jxffjalfjlj": null,
    "jxffjalfjmc": null,
    "xgpj": "<p style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\">本课程相关新闻报道：</p>\n<h3 style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\"><span style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px;\">考古文博学院2020级本科生赴陕西周原开展专业实践、思政实践：https://news.pku.edu.cn/xwzh/943aa27e1dd840739b3df5b2465d8918.htm</span></h3>\n<h3 style=\"box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; color: #333333; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decor