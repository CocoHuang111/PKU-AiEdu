      "cjr": "1106579109",
      "cjsj": "2022-12-18T20:44:50.000+08:00",
      "zhxgr": "1106579109",
      "zhxgsj": "2022-12-18T20:44:50.000+08:00",
      "zj": "需求分析",
      "zsd": "需求获取",
      "szys": "与人为善。开发软件的目的是为了帮助用户提高工作效率的，所以要首先知道用户需要什么的帮助，这就是需求获取。需求获取首先主要和人（用户）打交道，软件需求获取时，软件分析师要与人为善，把用户往好处想，热心帮助用户思考问题解决之道，才能获得用户的认同。",
      "szwd": "如何做人",
      "jxff": "课堂讲授，融入教学内容中",
      "xssx": 16,
      "kcdm": "CB170A99B943AF09E050007F010011F0",
      "fjs": [

      ],
