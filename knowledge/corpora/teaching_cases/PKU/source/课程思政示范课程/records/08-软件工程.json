      "cjr": "1106579109",
      "cjsj": "2022-12-18T20:44:50.000+08:00",
      "zhxgr": "1106579109",
      "zhxgsj": "2022-12-18T20:44:50.000+08:00",
      "zj": "需求分析",
      "zsd": "需求规约",
      "szys": "抽象思维。要把用户的需要（needs）变成系统的需求（requirements），系统分析师必须具备抽象思维，能够去伪存真，把用户使用自然语言描述的需要，抽象成软件工具描述的系统需求。",
      "szwd": "如何做事",
      "jxff": "课堂讲授，融入教学内容中",
      "xssx": 17,
