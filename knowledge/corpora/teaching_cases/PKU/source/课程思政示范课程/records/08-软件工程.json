    {
      "id": "F01A86C8423934A6E050007F0100181A",
      "cjr": "1106579109",
      "cjsj": "2022-12-18T20:44:50.000+08:00",
      "zhxgr": "1106579109",
      "zhxgsj": "2022-12-18T20:44:50.000+08:00",
      "zj": "需求分析",
      "zsd": "需求获取",
      "szys": "换位思考。沟通中的黄金定律就是用对方喜欢被对待的方式来对待他们。做到这一点，首先要换位思考。换位思考不是”己所不欲勿施于人“而是”人之所欲方施予人“，是站在对方的视角感受对方的感受，达到感同身受。做到了换位思考，才能获取用户的真实需求。",
      "szwd": "如何做事/职业素养",
      "jxff": "小组讨论，互评中自悟",
      "xssx": 15,
      "kcdm": "CB170A99B943AF09E050007F010011F0",
      "fjs": [

      ],
      "szwdArr": [

      ],
