{"course": {"schema_version": "1.0", "course_id": "mitocw-res-tll-008-spring-2026", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["RES.TLL-008"], "cross_listed_codes": [], "course_title": "Social and Ethical Responsibilities of Computing (SERC)", "course_slug": "res-tll-008-social-and-ethical-responsibilities-of-computing-serc", "term": "Spring", "year": 2026, "as_taught_in": "Spring 2026", "language": "en", "departments": [], "academic_levels": ["Non-Credit"], "instructors": ["SERC Contributors"], "subject_primary": "Computer Science", "subject_secondary": ["Artificial Intelligence", "Teaching and Education", "Curriculum and Teaching", "Higher Education"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Artificial Intelligence"]}]}, {"name": "Teaching and Education", "subtopics": [{"name": "Curriculum and Teaching", "specialties": []}, {"name": "Higher Education", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Editable Files", "Instructor Insights", "Lecture Notes", "Multiple Assignment Types", "Podcasts"], "description": "Social and Ethical Responsibilities of Computing (SERC) , a cross-cutting initiative of the MIT Schwarzman College of Computing , works to train students and facilitate research to assess the broad challenges and opportunities associated with computing, and improve design, policy, implementation, and impacts. This site is a resource for SERC pedagogical materials developed for use in MIT courses. SERC brings together cross-disciplinary teams of faculty, researchers, and students to develop original pedagogical materials that meet our goal of training students to practice responsible technology development through incorporation of insights and methods from the humanities and social sciences, including an emphasis on social responsibility. Materials include the MIT Case Studies Series in Social and Ethical Responsibilities of Computing , original Active Learning Projects, and lecture materials that provide students hands-on practice and training in SERC, together with other resources and tools found useful in education at MIT. Original homework assignments and in-class demonstrations are specially created by multidisciplinary teams, to enable instructors to embed SERC-related material into a wide variety of existing courses. The aim of SERC is to facilitate the development of responsible “habits of mind and action” for those who create and deploy computing technologies, and fostering the creation of technologies in the public interest.", "course_url": "https://ocw.mit.edu/courses/res-tll-008-social-and-ethical-responsibilities-of-computing-serc/", "image_url": "https://ocw.mit.edu/courses/res-tll-008-social-and-ethical-responsibilities-of-computing-serc/5bffed1db8808a9990e7cce29e5b27c6_res-tll-008f21.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": false, "calendar": false, "readings": false, "lecture_notes": false, "assignments": false, "projects": false, "exams": false, "videos": false, "instructor_insights": true, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-res-tll-008-spring-2026-course-home", "course_id": "mitocw-res-tll-008-spring-2026", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/res-tll-008-social-and-ethical-responsibilities-of-computing-serc/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "captur