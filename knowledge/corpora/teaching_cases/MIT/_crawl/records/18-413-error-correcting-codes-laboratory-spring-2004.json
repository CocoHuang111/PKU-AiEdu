{"course": {"schema_version": "1.0", "course_id": "mitocw-18-413-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["18.413"], "cross_listed_codes": [], "course_title": "Error-Correcting Codes Laboratory", "course_slug": "18-413-error-correcting-codes-laboratory-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Mathematics"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Daniel Spielman"], "subject_primary": "Computer Science", "subject_secondary": ["Algorithms and Data Structures", "Cryptography", "Theory of Computation", "Mathematics", "Computation"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Algorithms and Data Structures", "Cryptography", "Theory of Computation"]}]}, {"name": "Mathematics", "subtopics": [{"name": "Computation", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Projects"], "description": "This course introduces students to iterative decoding algorithms and the codes to which they are applied, including Turbo Codes, Low-Density Parity-Check Codes, and Serially-Concatenated Codes. The course will begin with an introduction to the fundamental problems of Coding Theory and their mathematical formulations. This will be followed by a study of Belief Propagation–the probabilistic heuristic which underlies iterative decoding algorithms. Belief Propagation will then be applied to the decoding of Turbo, LDPC, and Serially-Concatenated codes. The technical portion of the course will conclude with a study of tools for explaining and predicting the behavior of iterative decoding algorithms, including EXIT charts and Density Evolution.", "course_url": "https://ocw.mit.edu/courses/18-413-error-correcting-codes-laboratory-spring-2004/", "image_url": "https://ocw.mit.edu/courses/18-