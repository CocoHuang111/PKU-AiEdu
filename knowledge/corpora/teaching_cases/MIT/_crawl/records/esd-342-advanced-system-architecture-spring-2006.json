{"course": {"schema_version": "1.0", "course_id": "mitocw-esd-342-spring-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["ESD.342"], "cross_listed_codes": [], "course_title": "Advanced System Architecture", "course_slug": "esd-342-advanced-system-architecture-spring-2006", "term": "Spring", "year": 2006, "as_taught_in": "Spring 2006", "language": "en", "departments": ["Engineering Systems Division"], "academic_levels": ["Graduate"], "instructors": ["Dr. Daniel E. Whitney", "Prof. Joel Moses", "Dr. Christopher L. Magee"], "subject_primary": "Systems Engineering", "subject_secondary": ["Systems Design"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Systems Engineering", "specialties": ["Systems Design"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Activity Assignments with Examples", "Lecture Notes", "Projects with Examples", "Written Assignments"], "description": "This course provides a deep understanding of engineering systems at a level intended for research on complex engineering systems. It provides a review and extension of what is known about system architecture and complexity from a theoretical point of view while examining the origins of and recent developments in the field. The class considers how and where the theory has been applied, and uses key analytical methods proposed. Students examine the level of observational (qualitative and quantitative) understanding necessary for successful use of the theoretical framework for a specific engineering system. Case studies apply the theory and principles to engineering systems.", "course_url": "https://ocw.mit.edu/courses/esd-342-advanced-system-architecture-spring-2006/", "image_url": "https://ocw.mit.edu/courses/esd-342-advanced-system-architecture-spring-2006/6a2ccdc85ca42e301c47890c18054d4b_esd-342s06.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativeco