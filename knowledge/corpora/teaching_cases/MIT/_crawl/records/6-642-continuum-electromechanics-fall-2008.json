{"course": {"schema_version": "1.0", "course_id": "mitocw-6-642-fall-2008", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.642"], "cross_listed_codes": [], "course_title": "Continuum Electromechanics", "course_slug": "6-642-continuum-electromechanics-fall-2008", "term": "Fall", "year": 2008, "as_taught_in": "Fall 2008", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Graduate"], "instructors": ["Markus Zahn"], "subject_primary": "Electrical Engineering", "subject_secondary": ["Mechanical Engineering", "Science", "Physics", "Electromagnetism", "Quantum Mechanics"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Electrical Engineering", "specialties": []}, {"name": "Mechanical Engineering", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Physics", "specialties": ["Electromagnetism", "Quantum Mechanics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exam Solutions", "Exams", "Lecture Notes", "Problem Set Solutions", "Problem Sets"], "description": "This course focuses on laws, approximations and relations of continuum electromechanics. Topics include mechanical and electromechanical transfer relations, statics and dynamics of electromechanical systems having a static equilibrium, electromechanical flows, and field coupling with thermal and molecular diffusion. Also covered are electrokinetics, streaming interactions, application to materials processing, magnetohydrodynamic and electrohydrodynamic pumps and generators, ferrohydrodynamics, physiochemical systems, heat transfer, continuum feedback control, electron beam devices, and plasma dynamics. Acknowledgements The instructor would like to thank Xuancheng Shao and Anyang Hou for transcribing into LaTeX the problem set solutions and exam solutions, respectively.", "course_url": "https://ocw.mit.edu/courses/6-642-continuum-electromechanics-fall-2008/", "image_url": "https://ocw.mit.edu/courses/6-642-continuum-electromechanics-fall-2008/c9081c2a03089313981bf71c7c309ece_6-642f08.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": true, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-6-642-fall-2008-course-home", "course_id": "mitocw-6-642-fall-2008", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/6-642-continuum-electromechanics-fall-2008/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "185da26fcc8693e02a420507195dd1c13c1b31786fd54a2fb511282b4a055a17", "error": null}, {"resource_id": "mitocw-6-642-fall-2008-syllabus", "course_id": "mitocw-6-642-fall-2008", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/6-642-continuum-electromechanics-fall-2008/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "9ef743379597b9da69dfb9214571194b453f2d5aa3c5541512326fa9cf448368", "error": null}, {"resource_id": "mitocw-6-642-fall-2008-calendar", "course_id": "mitocw-6-642-fall-2008", "resource_type": "calendar", "source_title": "Calendar", "source_url": "https://ocw