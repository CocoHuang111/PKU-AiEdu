{"course": {"schema_version": "1.0", "course_id": "mitocw-17-504-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["17.504"], "cross_listed_codes": [], "course_title": "Ethnic Politics I", "course_slug": "17-504-ethnic-politics-i-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Political Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Roger Petersen"], "subject_primary": "Philosophy", "subject_secondary": ["Political Philosophy", "Social Science", "Anthropology", "Ethnography", "Political Science"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Philosophy", "specialties": ["Political Philosophy"]}]}, {"name": "Social Science", "subtopics": [{"name": "Anthropology", "specialties": ["Ethnography"]}, {"name": "Political Science", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "This course is designed to provide students with a broad overview of the major theories on the relationship between ethnicity and politics. The course is divided into three sections. The first covers general theory and discusses the social construction of ethnicity as well as the limits of construction. The second section discusses ethnicity as a dependent variable. This section studies the forces that shape the development of ethnic identities and their motivating power. The third section addresses ethnicity as an independent variable. In other words, it focuses on how ethnicity operates to affect important political and economic outcomes. This course is the first semester of a year-long sequence on ethnic politics. However, each semester is self-contained and students may take the course in either or both semesters. Ethnic Politics I aims for breadth over depth. It covers many works in the “canon” of texts on ethnic politics as well as addressing many major topics (modernization, entrepreneurship, prejudice, ethnic party formation, etc.) in one week sessions. Ethnic Politics II covers some of these topics in greater depth and also requires a major research paper.", "course_url": "https://ocw.mit.edu/courses/17-504-ethnic-politics-i-fall-2003/", "image_url": "https://ocw.mit.edu/courses/17-504-ethnic-politics-i-fall-2003/768770ea1b92a1b851808943ca5de0ca_17-504f03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-17-504-fall-2003-course-home", "course_id": "mitocw-17-504-fall-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/17-504-ethnic-politics-i-fall-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "e08edd09e9174ba70a2dace23d257eb63e0e50bf0fc81aa49aaba2da9ee4365f", "error": null}, {"resource_id": "mitocw-17-504-fall-2003-syllabus", "course_id": "mitocw-17-504-fall-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/17-504-ethnic-politics-i-fall-2003/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "conten