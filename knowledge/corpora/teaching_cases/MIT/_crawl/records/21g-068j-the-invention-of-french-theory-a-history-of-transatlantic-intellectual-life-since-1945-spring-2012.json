{"course": {"schema_version": "1.0", "course_id": "mitocw-21g-068j-spring-2012", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21G.068J"], "cross_listed_codes": ["WGS.234J"], "course_title": "The Invention of French Theory: A History of Transatlantic Intellectual Life since 1945", "course_slug": "21g-068j-the-invention-of-french-theory-a-history-of-transatlantic-intellectual-life-since-1945-spring-2012", "term": "Spring", "year": 2012, "as_taught_in": "Spring 2012", "language": "en", "departments": ["Global Studies and Languages", "Women's and Gender Studies"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Bruno Perreau"], "subject_primary": "Language", "subject_secondary": ["French", "Literature", "Comparative Literature"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Language", "specialties": ["French"]}, {"name": "Literature", "specialties": ["Comparative Literature"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Media Assignments", "Presentation Assignments", "Written Assignments"], "description": "In the decades following the Second World War, a cluster of extraordinary French thinkers were widely translated and read in American universities. Their works were soon labeled as “French Theory.” Why would sharing the same nationality make authors such as Lacan, Cixous, Derrida, Foucault or Debord, ambassadors of a specifically “French” theory? The course will explore the maze of transatlantic intellectual debates since 1945 and the heyday of French existentialism. We will study the debates on communism, decolonization, neo‐liberalism, gender, youth culture and mass media. This course is taught in English.", "course_url": "https://ocw.mit.edu/courses/21g-068j-the-invention-of-french-theory-a-history-of-transatlantic-intellectual-life-since-1945-spring-2012/", "image_url": "https://ocw.mit.edu/courses/21g-068j-the-invention-