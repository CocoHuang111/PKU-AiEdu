{"course": {"schema_version": "1.0", "course_id": "mitocw-16-225-fall-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["16.225"], "cross_listed_codes": [], "course_title": "Computational Mechanics of Materials", "course_slug": "16-225-computational-mechanics-of-materials-fall-2003", "term": "Fall", "year": 2003, "as_taught_in": "Fall 2003", "language": "en", "departments": ["Aeronautics and Astronautics"], "academic_levels": ["Graduate"], "instructors": ["Prof. Raúl Radovitzky"], "subject_primary": "Aerospace Engineering", "subject_secondary": ["Materials Selection", "Structural Mechanics", "Systems Engineering", "Computational Science and Engineering"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Aerospace Engineering", "specialties": ["Materials Selection", "Structural Mechanics"]}, {"name": "Systems Engineering", "specialties": ["Computational Science and Engineering"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Problem Sets"], "description": "16.225 is a graduate level course on Computational Mechanics of Materials. The primary focus of this course is on the teaching of state-of-the-art numerical methods for the analysis of the nonlinear continuum response of materials. The range of material behavior considered in this course includes: linear and finite deformation elasticity, inelasticity and dynamics. Numerical formulation and algorithms include: variational formulation and variational constitutive updates, finite element discretization, error estimation, constrained problems, time integration algorithms and convergence analysis. There is a strong emphasis on the (parallel) computer implementation of algorithms in programming assignments. The application to real engineering applications and problems in engineering science is stressed throughout the course.", "course_url": "https://ocw.mit.edu/courses/16-225-computational-mechanics-of-materials-fall-2003/", "image_url": "https://ocw.mit.edu/courses/16-225-computational-mechanics-of-materials-fall-2003/b1779785992850379a4a5f058b83c3f8_16-225f03.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-16-225-fall-2003-course-home", "course_id": "mitocw-16-225-fall-2003", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/16-225-computational-mechanics-of-materials-fall-2003/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "70c9d63968c5cb50470d1d3d50cec4890fe86e6d53413ed48013ad7cde0c2470", "error": null}, {"resource_id": "mitocw-16-225-fall-2003-syllabus", "course_id": "mitocw-16-225-fall-2003", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/16-225-computational-mechanics-of-materials-fall-2003/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "29b2f622987e1aa67d098ce912e8159fecce89b70561bb0d2c349278f9f5a4f9", "error": null}, {"resource_id": "mitocw-16-225-fall-2003-calendar", "course_id": "mitocw-16-225-fall-2003", "resource_type": "calendar