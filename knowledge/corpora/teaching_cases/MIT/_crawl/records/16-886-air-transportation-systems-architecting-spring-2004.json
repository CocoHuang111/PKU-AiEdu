{"course": {"schema_version": "1.0", "course_id": "mitocw-16-886-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["16.886"], "cross_listed_codes": [], "course_title": "Air Transportation Systems Architecting", "course_slug": "16-886-air-transportation-systems-architecting-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Aeronautics and Astronautics"], "academic_levels": ["Graduate"], "instructors": ["Earll Murman", "Prof. John Hansman", "Prof. John-Paul Clarke"], "subject_primary": "Operations Management", "subject_secondary": ["Engineering", "Aerospace Engineering", "Systems Engineering", "Social Science", "Urban Studies", "Transportation Planning"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Operations Management", "specialties": []}]}, {"name": "Engineering", "subtopics": [{"name": "Aerospace Engineering", "specialties": []}, {"name": "Systems Engineering", "specialties": []}]}, {"name": "Social Science", "subtopics": [{"name": "Urban Studies", "specialties": ["Transportation Planning"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes"], "description": "This course addresses the architecting of air transportation systems. The focus is on the conceptual phase of product definition, including technical, economic, market, environmental, regulatory, legal, manufacturing, and societal factors. It centers on a realistic system case study and includes a number of lectures from industry and government. Past examples include: the Very Large Transport Aircraft, a Supersonic Business Jet, and a Next Generation Cargo System. The course identifies the critical system level issues and analyzes them in depth via student team projects and individual assignments. The overall goal of the semester is to produce a business plan and a system specifications document that can be used to assess candidate systems.", "course_url": "https://ocw.mit.edu/courses/16-886-air-transportation-systems-architecting-spring-2004/", "image_url": "https://ocw.mit.edu/courses/16-886-air-transportation-systems-architecting-spring-2004/189e920b482a297276c4462add95d292_16-888s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": false, "lecture_notes": true, "assignments": false, "projects": true, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-16-886-spring-2004-course-home", "course_id": "mitocw-16-886-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/16-886-air-transportation-systems-architecting-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "b9d99320b500ef05c75096bdb62f8acd91e4baddb4c4e0660eff1047f7f30810", "error": null}, {"resource_id": "mitocw-16-886-spring-2004-syllabus", "course_id": "mitocw-16-886-spring-2004", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/16-886-air-transportation-systems-architecting-spring-2004/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.md", "capture_date": "2026-10-03", "content_sha256": "02005cbe8de2fe95d916e8a55931a9c03c147ece6dc89683eadba4f42b33b03b", "error": null},