{"course": {"schema_version": "1.0", "course_id": "mitocw-6-088-january-iap-2010", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["6.088"], "cross_listed_codes": [], "course_title": "Introduction to C Memory Management and C++ Object-Oriented Programming", "course_slug": "6-088-introduction-to-c-memory-management-and-c-object-oriented-programming-january-iap-2010", "term": "January IAP", "year": 2010, "as_taught_in": "January IAP 2010", "language": "en", "departments": ["Electrical Engineering and Computer Science"], "academic_levels": ["Undergraduate"], "instructors": ["Eunsuk Kang", "Jean Yang"], "subject_primary": "Computer Science", "subject_secondary": ["Programming Languages", "Software Design and Engineering"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Computer Science", "specialties": ["Programming Languages", "Software Design and Engineering"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Notes", "Programming Assignments"], "description": "Ever hang your head in shame after your Python program wasn’t as fast as your friend’s C program? Ever wish you could use objects without having to use Java? Join us for this fun introduction to C and C++! We will take you through a tour that will start with writing simple C programs, go deep into the caves of C memory manipulation, resurface with an introduction to using C++ classes, dive deeper into advanced C++ class use and the C++ Standard Template Libraries. We’ll wrap up by teaching you some tricks of the trade that you may need for tech interviews. We see this as a “C/C++ empowerment” course: we want you to come away understanding why you would want to use C over another language (control over memory, probably for performance reasons), why you would want to use C++ rather than C (objects), and how to be useful in C and C++. This course is offered during the Independent Activities Period (IAP), which is a special 4-week term at MIT that runs from the first week of January until the end of the month.", "course_url": "https://ocw.mit.edu/courses/6-088-introduction-to-c-memory-management-and-c-object-oriented-programming-january-iap-2010/", "image_url": "https://ocw.mit.edu/courses/6-088-introduction-to-c-memory-management-and-c-object-oriented-programming-january-iap-2010/07ffa8337a030ef1d5c9eedfce6fd859_6-088iap10.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": false, "readings": false, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-6-088-january-iap-2010-course-home", "course_id": "mitocw-6-088-january-iap-2010", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/6-088-introduction-to-c-memory-management-and-c-object-oriented-programming-january-iap-2010/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "7497ded946411f00101dfb8ff9e1793c4a5dddc8e5c2c6144683f4fe87e0f4cb", "error": null}, {"resource_id": "mitocw-6-088-january-iap-2010-syllabus", "course_id": "mitocw-6-088-january-iap-2010", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/6-088-introduction-to-c-memory-management-and-c-object-oriented-programming-january-iap-2010/pages/syllabus/", "source_format": "html", "availability":