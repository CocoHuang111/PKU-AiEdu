{"course": {"schema_version": "1.0", "course_id": "mitocw-hst-951j-spring-2003", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["HST.951J"], "cross_listed_codes": ["6.873J"], "course_title": "Medical Decision Support", "course_slug": "hst-951j-medical-decision-support-spring-2003", "term": "Spring", "year": 2003, "as_taught_in": "Spring 2003", "language": "en", "departments": ["Health Sciences and Technology", "Electrical Engineering and Computer Science"], "academic_levels": ["Graduate"], "instructors": ["Prof. Isaac Kohane", "Prof. Lucila Ohno-Machado", "Prof. Peter Szolovits", "Prof. Staal Vinterbo"], "subject_primary": "Information Technology", "subject_secondary": ["Engineering", "Biological Engineering", "Computational Biology", "Computer Science", "Artificial Intelligence", "Health and Medicine", "Biomedicine"], "topic_tree": [{"name": "Business", "subtopics": [{"name": "Information Technology", "specialties": []}]}, {"name": "Engineering", "subtopics": [{"name": "Biological Engineering", "specialties": ["Computational Biology"]}, {"name": "Computer Science", "specialties": ["Artificial Intelligence"]}]}, {"name": "Health and Medicine", "subtopics": [{"name": "Biomedicine", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Lecture Notes", "Problem Set Solutions", "Problem Sets", "Programming Assignments"], "description": "This course presents the main concepts of decision analysis, artificial intelligence and predictive model construction and evaluation in the specific context of medical applications. It emphasizes the advantages and disadvantages of using these methods in real-world systems and provides hands-on experience. Its technical focus is on decision support, knowledge-based systems (qualitative and quantitative), learning systems (including logistic regression, classification trees, neural networks, rough sets), and t