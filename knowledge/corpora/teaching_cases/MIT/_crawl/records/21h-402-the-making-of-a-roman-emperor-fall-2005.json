{"course": {"schema_version": "1.0", "course_id": "mitocw-21h-402-fall-2005", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21H.402"], "cross_listed_codes": [], "course_title": "The Making of a Roman Emperor", "course_slug": "21h-402-the-making-of-a-roman-emperor-fall-2005", "term": "Fall", "year": 2005, "as_taught_in": "Fall 2005", "language": "en", "departments": ["History"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. William Broadhead"], "subject_primary": "Art History", "subject_secondary": ["Media Studies", "Humanities", "History", "European History"], "topic_tree": [{"name": "Fine Arts", "subtopics": [{"name": "Art History", "specialties": []}, {"name": "Media Studies", "specialties": []}]}, {"name": "Humanities", "subtopics": [{"name": "History", "specialties": ["European History"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "Focusing on the emperors Augustus and Nero, this course investigates the ways in which Roman emperors used art, architecture, coinage and other media to create and project an image of themselves, the ways in which the surviving literary sources from the Roman period reinforced or subverted that image, and the ways in which both phenomena have contributed to post-classical perceptions of Roman emperors. Material studied will include the art, architecture, and coinage of Augustan and Neronian Rome, the works of Suetonius and Tacitus, and modern representations of the emperors such as those found in I, Claudius and Quo Vadis .", "course_url": "https://ocw.mit.edu/courses/21h-402-the-making-of-a-roman-emperor-fall-2005/", "image_url": "https://ocw.mit.edu/courses/21h-402-the-making-of-a-roman-emperor-fall-2005/6a4de7f31837953be86e76637cb959c0_21h-402f05.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources":