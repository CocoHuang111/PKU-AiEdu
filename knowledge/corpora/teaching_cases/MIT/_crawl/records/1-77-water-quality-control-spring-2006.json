{"course": {"schema_version": "1.0", "course_id": "mitocw-1-77-spring-2006", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["1.77"], "cross_listed_codes": [], "course_title": "Water Quality Control", "course_slug": "1-77-water-quality-control-spring-2006", "term": "Spring", "year": 2006, "as_taught_in": "Spring 2006", "language": "en", "departments": ["Civil and Environmental Engineering"], "academic_levels": ["Graduate"], "instructors": ["Dr. Eric Adams"], "subject_primary": "Environmental Engineering", "subject_secondary": ["Aquatic Sciences and Water Quality Control", "Hydrodynamics and Coastal Engineering", "Hydrology and Water Resource Systems"], "topic_tree": [{"name": "Engineering", "subtopics": [{"name": "Environmental Engineering", "specialties": ["Aquatic Sciences and Water Quality Control", "Hydrodynamics and Coastal Engineering", "Hydrology and Water Resource Systems"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Exams", "Lecture Notes", "Problem Sets"], "description": "The course material emphasizes mathematical models for predicting distribution and fate of effluents discharged into lakes, reservoirs, rivers, estuaries, and oceans. It also focuses on formulation and structure of models as well as analytical and simple numerical solution techniques. Also discussed are the role of element cycles, such as oxygen, nitrogen, and phosphorus, as water quality indicators; offshore outfalls and diffusion; salinity intrusion in estuaries; and thermal stratification, eutrophication, and sedimentation processes in lakes and reservoirs. This course is a core requirement for the Environmental MEng program.", "course_url": "https://ocw.mit.edu/courses/1-77-water-quality-control-spring-2006/", "image_url": "https://ocw.mit.edu/courses/1-77-water-quality-control-spring-2006/1a36a73e3e002f5f1af523b07fd393d8_1-77s06.jpg", "license_name": "CC BY-NC-SA 4.0", "lic