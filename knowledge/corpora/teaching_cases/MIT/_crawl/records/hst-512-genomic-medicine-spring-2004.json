{"course": {"schema_version": "1.0", "course_id": "mitocw-hst-512-spring-2004", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["HST.512"], "cross_listed_codes": [], "course_title": "Genomic Medicine", "course_slug": "hst-512-genomic-medicine-spring-2004", "term": "Spring", "year": 2004, "as_taught_in": "Spring 2004", "language": "en", "departments": ["Health Sciences and Technology"], "academic_levels": ["Graduate"], "instructors": ["Prof. Isaac Kohane"], "subject_primary": "Biomedicine", "subject_secondary": ["Functional Genomics", "Science", "Biology", "Genetics"], "topic_tree": [{"name": "Health and Medicine", "subtopics": [{"name": "Biomedicine", "specialties": []}, {"name": "Functional Genomics", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Biology", "specialties": ["Genetics"]}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Lecture Audio", "Lecture Notes"], "description": "This course reviews the key genomic technologies and computational approaches that are driving advances in prognostics, diagnostics, and treatment. Throughout the semester, emphasis will return to issues surrounding the context of genomics in medicine including: what does a physician need to know? what sorts of questions will s/he likely encounter from patients? how should s/he respond? Lecturers will guide the student through real world patient-doctor interactions. Outcome considerations and socioeconomic implications of personalized medicine are also discussed. The first part of the course introduces key basic concepts of molecular biology, computational biology, and genomics. Continuing in the informatics applications portion of the course, lecturers begin each lecture block with a scenario, in order to set the stage and engage the student by showing: why is this important to know? how will the information presented be brought to bear on medical practice? The final section presents the ethical, legal, and social issues surrounding genomic medicine. A vision of how genomic medicine relates to preventative care and public health is presented in a discussion forum with the students where the following questions are explored: what is your level of preparedness now? what challenges must be met by the healthcare industry to get to where it needs to be? Lecturers Dr. Atul J. Butte Dr. Steven A. Greenberg Dr. Alvin Thong-Juak Kho Dr. Peter Park Dr. Marco F. Ramoni Dr. Alberto A. Riva Dr. Zoltan Szallasi Dr. Jeffrey Mark Drazen Dr. Todd Golub Dr. Joel Hirschhorn Dr. Greg Tucker-Kellogg Dr. Scott Weiss", "course_url": "https://ocw.mit.edu/courses/hst-512-genomic-medicine-spring-2004/", "image_url": "https://ocw.mit.edu/courses/hst-512-genomic-medicine-spring-2004/bed95ee6e0a6a01eff76d80d185d8af3_hst-512s04.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": true, "exams": false, "videos": true, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-hst-512-spring-2004-course-home", "course_id": "mitocw-hst-512-spring-2004", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/hst-512-genomic-medicine-spring-2004/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "407177bc7eb3f4fdc013a3bf4b7c0efb18f6f165ed50c38927bc9ed5e1a89d09", "error": null}, {"resource_i