{"course": {"schema_version": "1.0", "course_id": "mitocw-9-520-a-spring-2001", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["9.520-A"], "cross_listed_codes": [], "course_title": "Networks for Learning: Regression and Classification", "course_slug": "9-520-a-networks-for-learning-regression-and-classification-spring-2001", "term": "Spring", "year": 2001, "as_taught_in": "Spring 2001", "language": "en", "departments": ["Brain and Cognitive Sciences"], "academic_levels": ["Graduate"], "instructors": ["Prof. Tomaso Poggio", "Dr. Alessandro Verri"], "subject_primary": "Probability and Statistics", "subject_secondary": ["Science", "Cognitive Science"], "topic_tree": [{"name": "Mathematics", "subtopics": [{"name": "Probability and Statistics", "specialties": []}]}, {"name": "Science", "subtopics": [{"name": "Cognitive Science", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Problem Sets", "Written Assignments"], "description": "The course focuses on the problem of supervised learning within the framework of Statistical Learning Theory. It starts with a review of classical statistical techniques, including Regularization Theory in RKHS for multivariate function approximation from sparse data. Next, VC theory is discussed in detail and used to justify classification and regression techniques such as Regularization Networks and Support Vector Machines. Selected topics such as boosting, feature selection and multiclass classification will complete the theory part of the course. During the course we will examine applications of several learning techniques in areas such as computer vision, computer graphics, database search and time-series analysis and prediction. We will briefly discuss implications of learning theories for how the brain may learn from experience, focusing on the neurobiology of object recognition. We plan to emphasize hands-on applications and exercises, paralleling the rapidly increasing practical uses of the techniques described in the subject.", "course_url": "https://ocw.mit.edu/courses/9-520-a-networks-for-learning-regression-and-classification-spring-2001/", "image_url": "https://ocw.mit.edu/courses/9-520-a-networks-for-learning-regression-and-classification-spring-2001/8a0fafcfb80b9458ccbc703a9c3120aa_9-520as01.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": true, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-9-520-a-spring-2001-course-home", "course_id": "mitocw-9-520-a-spring-2001", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/9-520-a-networks-for-learning-regression-and-classification-spring-2001/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "a62954a387e88041069ff5e3ac09858afa7293ac586af4dd2bd0142b025e9e65", "error": null}, {"resource_id": "mitocw-9-520-a-spring-2001-syllabus", "course_id": "mitocw-9-520-a-spring-2001", "resource_type": "syllabus", "source_title": "Syllabus", "source_url": "https://ocw.mit.edu/courses/9-520-a-networks-for-learning-regression-and-classification-spring-2001/pages/syllabus/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "syllabus.m