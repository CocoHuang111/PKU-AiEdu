{"course": {"schema_version": "1.0", "course_id": "mitocw-21l-701-spring-2001", "institution": "Massachusetts Institute of Technology", "platform": "MIT OpenCourseWare", "course_codes": ["21L.701"], "cross_listed_codes": ["WGS.510J"], "course_title": "Literary Interpretation: Virginia Woolf's Shakespeare", "course_slug": "21l-701-literary-interpretation-virginia-woolfs-shakespeare-spring-2001", "term": "Spring", "year": 2001, "as_taught_in": "Spring 2001", "language": "en", "departments": ["Literature", "Women's and Gender Studies"], "academic_levels": ["Undergraduate"], "instructors": ["Prof. Diana Henderson"], "subject_primary": "Literature", "subject_secondary": ["Comparative Literature", "Criticism", "Drama", "Fiction", "Society", "Women's Studies"], "topic_tree": [{"name": "Humanities", "subtopics": [{"name": "Literature", "specialties": ["Comparative Literature", "Criticism", "Drama", "Fiction"]}]}, {"name": "Society", "subtopics": [{"name": "Women's Studies", "specialties": []}]}], "topic_keywords": [], "pedagogy_tags": [], "assessment_types": [], "course_feature_tags": ["Written Assignments"], "description": "How does one writer use another writer’s work? Does it matter if one author has been dead 300 years? What difference does it make if she’s a groundbreaking twentieth-century feminist and the writer she values has come to epitomize the English literary tradition? How can a novelist borrow from plays and poems? By reading Virginia Woolf’s major novels and essays in juxtaposition with some of the Shakespeare plays that (depending on one’s interpretation) haunt, enrich, and/or shape her writing, we will try to answer these questions and raise others. Readings in literary criticism, women’s studies, and other literary texts will complement our focus on the relationship–across time, media, and gender–between Shakespeare and Woolf. As a seminar, we will work to become more astute readers of literature within its historical, artistic, and political contexts, and consider how literature both reflects and contributes to these societal frameworks. Central texts will include Shakespeare’s Othello, Antony and Cleopatra, Cymbeline , and The Winter’s Tale , and Woolf’s A Room of One’s Own , Mrs. Dalloway, Orlando, To the Lighthouse, The Waves, and Between the Acts . This subject is an advanced seminar in both the Literature and the Women’s Studies Program.", "course_url": "https://ocw.mit.edu/courses/21l-701-literary-interpretation-virginia-woolfs-shakespeare-spring-2001/", "image_url": "https://ocw.mit.edu/courses/21l-701-literary-interpretation-virginia-woolfs-shakespeare-spring-2001/4201d353a87c6dde3adc15abf9670704_21l-701s01.jpg", "license_name": "CC BY-NC-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "resources": {"syllabus": true, "calendar": true, "readings": true, "lecture_notes": false, "assignments": true, "projects": false, "exams": false, "videos": false, "instructor_insights": false, "related_resources": false}, "metadata_origin": {"subject_primary": "source", "subject_secondary": "source", "academic_levels": "source", "course_feature_tags": "source"}, "capture_date": "2026-10-03", "last_verified_date": "2026-10-03", "extraction_status": "complete"}, "resources": [{"resource_id": "mitocw-21l-701-spring-2001-course-home", "course_id": "mitocw-21l-701-spring-2001", "resource_type": "course_home", "source_title": "Course Description", "source_url": "https://ocw.mit.edu/courses/21l-701-literary-interpretation-virginia-woolfs-shakespeare-spring-2001/", "source_format": "html", "availability": "available", "extraction_policy": "full_text", "extraction_status": "complete", "local_path": "course-description.md", "capture_date": "2026-10-03", "content_sha256": "eeb685dde9d61509eaf54c8b6dd0496ee40f0a4698cbe9b66bf75dcaba57a63d", "error": null}, {"resource_id": "mitocw-21l-701-spring-2001-syllabus", "course_id": "mitocw-21l-701-spring-2001", "resource_type": "syllabus", "source_title": "Syllabus"