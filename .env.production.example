# 填写已经解析到服务器公网 IP 的域名，Caddy 会自动申请 HTTPS。
# 生产环境使用安全 Cookie，因此正式内测必须使用域名和 HTTPS。
SITE_ADDRESS=askedu.example.edu.cn

# 只使用字母和数字可避免 DATABASE_URL 中的 URL 转义问题。两处密码必须完全一致。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
DATABASE_URL=postgresql+asyncpg://pku2:replace_with_a_long_random_alphanumeric_password@postgres:5432/pku2

DASHSCOPE_API_KEY=replace_with_dashscope_api_key
PKU_MODE=cloud
APP_ENV=production

# 至少 32 字节随机值，可执行：openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_session_secret

AUTH_MODE=local
# 小范围内测建议开放注册但强制邀请码；邀请码只发给内测用户。
LOCAL_REGISTRATION_ENABLED=true
LOCAL_REGISTRATION_INVITE_CODE=replace_with_a_private_invite_code

SESSION_TTL_SEC=1209600
PASSWORD_MIN_LENGTH=8
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SEC=900
EVALUATION_MAX_CONCURRENCY=1

# 如以后切换北大统一身份认证，再填写以下项目。
PKU_SSO_CLIENT_ID=
PKU_SSO_CLIENT_SECRET=
PKU_SSO_AUTHORIZE_URL=
PKU_SSO_TOKEN_URL=
PKU_SSO_USERINFO_URL=
PKU_SSO_REDIRECT_URI=
ADMIN_IDENTITIES=
