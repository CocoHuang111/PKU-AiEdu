# 复制为 .env 后填写
# cp .env.example .env

# 通义千问 / 阿里云百炼 API Key（LLM、VLM、Embedding 都用它）
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 覆盖 config.yaml 的 mode；大模型（LLM/VLM/Embedding）默认云端
PKU_MODE=cloud

# 后端端口
BACKEND_PORT=8010

# HuggingFace 缓存目录，让 faster-whisper 权重下载到项目内而不是家目录
HF_HOME=./models/hf

# --- 业务数据库与认证（不要把真实密码提交到仓库）---
DATABASE_URL=postgresql+asyncpg://pku2:pku2@127.0.0.1:5432/pku2
AUTH_MODE=local
SESSION_SECRET=dev-only-session-secret-change-me
APP_ENV=development
UPLOAD_ROOT=./data/uploads
LOCAL_REGISTRATION_ENABLED=true
LOCAL_REGISTRATION_INVITE_CODE=
PKU_SSO_CLIENT_ID=
PKU_SSO_CLIENT_SECRET=
PKU_SSO_AUTHORIZE_URL=
PKU_SSO_TOKEN_URL=
PKU_SSO_USERINFO_URL=
PKU_SSO_REDIRECT_URI=
ADMIN_IDENTITIES=
